# Prestium: each third-party apt repository may only supply its own packages.
# "origin" is the repository's host name. Allowed packages keep the default priority (500), so the
# version chosen is the same as without these pins; everything else from these hosts is never
# installed (-1).
# 2.1: i2pd is not from an apt repository any more: hook 0005 installs PurpleI2P's .deb from GitHub,
# pinned by SHA-256 in thirdparty/versions.sh. Debian's own (older) i2pd is never installed.
Package: i2pd
Pin: release o=Debian
Pin-Priority: -1

Package: librewolf
Pin: origin repo.librewolf.net
Pin-Priority: 500

Package: tor tor-geoipdb deb.torproject.org-keyring lyrebird snowflake-client webtunnel
Pin: origin deb.torproject.org
Pin-Priority: 500

Package: *
Pin: origin repo.librewolf.net
Pin-Priority: -1

Package: *
Pin: origin deb.torproject.org
Pin-Priority: -1
