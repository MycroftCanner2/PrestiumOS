label live-@FLAVOUR@
	menu label ^Prestium @PRESTIUM_VERSION@
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-@FLAVOUR@-nomodeset
	menu label Prestium @PRESTIUM_VERSION@ (nomodeset)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@

label live-@FLAVOUR@-nocammic
	menu label Prestium @PRESTIUM_VERSION@ (camera and microphone off)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ prestium.nocammic

label live-@FLAVOUR@-nomacspoof
	menu label Prestium @PRESTIUM_VERSION@ (MAC address spoofing off)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ nomacspoof
