#!/opt/nodejs/bin/node
"use strict";
// Prestium: prepare The Lounge's single user "prestium" (run as root by thelounge.service
// ExecStartPre=+ on every start).
// - first start of a boot: user file from /usr/local/share/prestium-thelounge/prestium.json
//   with one preset per i2pd IRC client tunnel (IRC2P 6668, echelon 6665;
//   Ilita 6669, r4sas 6670, acetone 6671). Each preset gets its own random nick.
// - 2.0 r4: no network connects by itself. At boot the I2P tunnels are not up yet, so the old
//   automatic connect of IRC2P/Ilita only produced errors (EPIPE) in the page. Every network is
//   set "disconnected" on every start; the user connects with the network's "Connect" menu
//   entry (or /connect) once I2P is ready.
// - a random password (bcrypt-hashed in the user file; plain copy in
//   /run/prestium-thelounge/password, readable by "user" only, needed only after "Sign out")
// - a new random login token on every start; only its SHA-512 is stored in the user file,
//   the token itself goes to /run/prestium-thelounge-launch/token (readable by "user" only) for
//   the "IRC (I2P)" or "IRC (Tor)" launcher. 2.1 (review): it works once. The session is marked
//   "prestiumLaunch"; The Lounge (patched in hook 0200) deletes it when it is used, gives the
//   browser its own session token, and writes the next launch token to the same file.
// - 2.1: one script for both instances. No argument: IRC (I2P), thelounge.service, user "thelounge".
//   "tor": IRC (Tor), thelounge-tor.service, user "thelounge-tor", its own state, run and launch
//   directories and template (OFTC, Ergo, DarkScience, IRCNow, then the SASL ones: Libera.Chat,
//   hackint, AlphaChat). On every start each of its networks is set to use Tor's SOCKS port 127.0.0.1:9050 with a
//   new random SOCKS username/password of its own (Tor isolates circuits by them; IsolateSOCKSAuth).
const fs = require("fs");
const crypto = require("crypto");
const bcrypt = require("/opt/thelounge/node_modules/bcryptjs");

const INSTANCES = {
	i2p: {name: "thelounge", home: "/var/lib/thelounge", template: "/usr/local/share/prestium-thelounge/prestium.json",
		run: "/run/prestium-thelounge", launch: "/run/prestium-thelounge-launch", tor: false},
	tor: {name: "thelounge-tor", home: "/var/lib/thelounge-tor", template: "/usr/local/share/prestium-thelounge-tor/prestium.json",
		run: "/run/prestium-thelounge-tor", launch: "/run/prestium-thelounge-tor-launch", tor: true},
};
if (process.argv.length > 3 || !Object.prototype.hasOwnProperty.call(INSTANCES, process.argv[2] || "i2p")) {
	throw new Error("usage: prestium-thelounge-setup [i2p|tor]");
}
const INST = INSTANCES[process.argv[2] || "i2p"];
const HOME = INST.home;
const USERS = HOME + "/users";
const FILE = USERS + "/prestium.json";
const TEMPLATE = INST.template;
const RUN = INST.run;
const LAUNCH = INST.launch;   // <user>:user 2750: The Lounge writes the next token

function ids(file, name) {
	for (const l of fs.readFileSync(file, "utf8").split("\n")) {
		const f = l.split(":");
		if (f[0] === name) return [Number(f[2]), Number(f[3])];
	}
	throw new Error(`${name} not found in ${file}`);
}
const [luid, lgid] = ids("/etc/passwd", INST.name);
const [ugid] = ids("/etc/group", "user");

// 2.0 r4 (security audit): HOME and USERS belong to thelounge, so nothing in them is trusted:
// both must be real directories (lstat; a symlink is refused), they are re-owned through a file
// descriptor opened with O_NOFOLLOW, and the user file is read and written with thelounge's own
// uid/gid (seteuid), exclusively ('wx') to a new temp name, then renamed. A symlink planted there
// can only reach what thelounge may touch anyway.
const C = fs.constants;
function writeAtomic(path, data, mode, uid, gid) {
	const tmp = path + ".tmp-" + process.pid + "-" + crypto.randomBytes(6).toString("hex");
	fs.writeFileSync(tmp, data, {mode, flag: "wx"});
	if (uid !== null) {
		fs.chownSync(tmp, uid, gid);
		fs.chmodSync(tmp, mode);
	}
	fs.renameSync(tmp, path);
}
function realDir(d, uid, gid, mode) {
	try {
		fs.mkdirSync(d, {mode: 0o700});
	} catch (e) {
		if (e.code !== "EEXIST") throw e;
	}
	const st = fs.lstatSync(d);
	if (st.isSymbolicLink() || !st.isDirectory()) throw new Error(`refusing ${d}: not a real directory`);
	const fd = fs.openSync(d, C.O_RDONLY | C.O_DIRECTORY | C.O_NOFOLLOW);
	try {
		if (!fs.fstatSync(fd).isDirectory()) throw new Error(`refusing ${d}: not a directory`);
		fs.fchownSync(fd, uid, gid);
		fs.fchmodSync(fd, mode);
	} finally {
		fs.closeSync(fd);
	}
}
function asThelounge(fn) {
	const groups = process.getgroups();
	process.setgroups([lgid]);
	process.setegid(lgid);
	process.seteuid(luid);
	try {
		return fn();
	} finally {
		process.seteuid(0);
		process.setegid(0);
		process.setgroups(groups);
	}
}

realDir(RUN, 0, ugid, 0o750);       // /run is root's
realDir(LAUNCH, luid, ugid, 0o2750); // setgid: files The Lounge writes there get group "user"
realDir(HOME, luid, lgid, 0o700);   // /var/lib is root's; HOME itself belongs to thelounge
asThelounge(() => {                 // USERS lives inside thelounge's HOME
	realDir(USERS, luid, lgid, 0o700);
});

let password = "";
try {
	password = fs.readFileSync(RUN + "/password", "utf8").trim();
} catch (e) {}
if (!/^[A-Za-z0-9_-]{24,}$/.test(password)) password = crypto.randomBytes(24).toString("base64url");

let user = null;
try {
	user = asThelounge(() => {
		const st = fs.lstatSync(FILE);
		if (!st.isFile()) throw new Error("not a regular file");
		return JSON.parse(fs.readFileSync(FILE, {encoding: "utf8", flag: C.O_RDONLY | C.O_NOFOLLOW}));
	});
} catch (e) {}
if (!user || !Array.isArray(user.networks)) {
	user = JSON.parse(fs.readFileSync(TEMPLATE, "utf8"));
	// every network preset gets its own random nick, so the IRC2P and Ilita
	// presets (and the alternate servers) don't share one nick that would link them
	const used = new Set();
	for (const n of user.networks) {
		let nick;
		do nick = "anon" + crypto.randomInt(1000, 10000); while (used.has(nick));
		used.add(nick);
		n.uuid = crypto.randomUUID();
		n.nick = nick;
	}
}
if (typeof user.password !== "string" || !user.password.startsWith("$2") ||
    !bcrypt.compareSync(password, user.password)) {
	user.password = bcrypt.hashSync(password, 10);
}
for (const n of user.networks) n.userDisconnected = true;   // 2.0 r4: connect only on request
if (INST.tor) {
	// 2.1: IRC (Tor). Every network through Tor's SOCKS port, each with new random SOCKS credentials on
	// every start (its own circuits). The Lounge (hook 0200, PRESTIUM_LOUNGE_TOR=1) also forces the proxy
	// at connect time, and the firewall refuses anything else, so a network edited in the UI can't leak.
	for (const n of user.networks) {
		n.proxyEnabled = true;
		n.proxyHost = "127.0.0.1";
		n.proxyPort = 9050;
		n.proxyUsername = "prestium-" + crypto.randomBytes(12).toString("hex");
		n.proxyPassword = crypto.randomBytes(12).toString("hex");
	}
}
const token = crypto.randomBytes(64).toString("hex");
const hash = crypto.createHash("sha512").update(token).digest("hex");
user.sessions = {[hash]: {lastUse: Date.now(), ip: "127.0.0.1", agent: "Prestium launcher", prestiumLaunch: true}};

asThelounge(() => writeAtomic(FILE, JSON.stringify(user, null, "\t") + "\n", 0o600, null, null));
writeAtomic(RUN + "/password", password + "\n", 0o640, 0, ugid);
// written as thelounge, the owner of LAUNCH (group "user" from the setgid directory)
asThelounge(() => {
	const tmp = LAUNCH + "/.token-" + process.pid + "-" + crypto.randomBytes(6).toString("hex");
	fs.writeFileSync(tmp, token + "\n", {mode: 0o640, flag: "wx"});
	fs.chmodSync(tmp, 0o640);
	fs.renameSync(tmp, LAUNCH + "/token");
});
fs.rmSync(RUN + "/token", {force: true});   // the place before 2.1
console.log(`prestium-thelounge-setup: ${INST.name}: user prestium ready, new login token issued`);
