#!/bin/bash
# Prestium: emergency shutdown when the boot medium is removed.
# Pulling the USB stick (or ejecting the DVD) powers the machine off at once.
# "systemctl --force poweroff" kills every process without running the normal
# shutdown units; the freed RAM is zeroed by the kernel (init_on_free=1 on the
# boot line), which is the same memory-erasure mechanism.
# Only bash builtins run in the polling loop, and memlockd keeps bash,
# systemctl locked in RAM, so this still works once the medium is gone.
# Not armed when booted with "toram" (the medium may then be removed safely).
#
# the independent fallback is started when the watchdog is ARMED (while
# the medium is still there), not when the medium disappears, so nothing has
# to be exec'd from the vanished medium at emergency time. It sleeps on a
# builtin until it gets SIGUSR1, then gives systemd 3 s to power off cleanly,
# SIGKILLs every process except itself and PID 1 (their memory is freed and
# so zeroed, init_on_free=1), waits 2 s and powers off through the sysrq trigger
# (root writes to /proc/sysrq-trigger work whatever kernel.sysrq says).
# Its argv[0] starts with '@', so systemd-shutdown's killing spree spares it.
# Worst case from removal to power-off: about 1 s (poll) + 3 s + 2 s.
#
# before the SIGKILL and again before sysrq o, the fallback deletes the
# session's files (overlay read-write branch, /tmp, /var/tmp, /dev/shm) with a
# memlocked find, so their RAM is freed and zeroed (A2). During suspend the
# watchdog is paused (/usr/lib/systemd/system-sleep/prestium-usb-watchdog).
# 2.1 (review: the wipe reported success when deletion failed): it deletes the same trees as
# prestium-wipe-session (also the overlay work directory and the runtime secrets under /run; see
# there for the list and what is left on purpose) and checks each one after the second pass. A
# failure is logged to the kernel log ("emergency session wipe FAILED" and the trees), never hidden;
# the power-off happens either way.

# 2.0 r7: only "toram" is an expected reason not to arm. Anything else is a failure the user must see:
# exit 3 (unit failed, no restart loop: RestartPreventExitStatus=3) and a safety flag for the desktop.
FLAG=/usr/local/lib/prestium/safety-flag
not_armed() {
  echo "NOT ARMED: $1" >&2
  $FLAG set usb-watchdog "The boot-medium watchdog did not arm: $1. Pulling the USB stick will NOT power the computer off. Shut down normally when you are done."
  exit 3
}
grep -qw toram /proc/cmdline && { echo "toram boot: watchdog not armed (expected)"; $FLAG clear usb-watchdog; exit 0; }

src=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null)
[ -n "$src" ] || not_armed "no live boot medium is mounted at /run/live/medium"
dev=${src#/dev/}
disk=$(lsblk -ndo PKNAME "$src" 2>/dev/null)
[ -n "$disk" ] || disk=$dev
[ -e "/sys/block/$disk" ] || not_armed "the boot medium $src could not be resolved to a disk"
case $disk in sr*) optical=1 ;; *) optical= ;; esac

# fallback, started now; only builtins inside
( exec -a @prestium-emergency /bin/bash -c '
    go=; trap "go=1" USR1
    exec 4<> <(:)
    until [ -n "$go" ]; do read -r -t 1 -u 4; done
    read -r -t 3 -u 4
    # delete the session files from RAM first (memlocked find:
    # the medium is gone), then SIGKILL everything so open files are freed too;
    # freed pages are zeroed by the kernel (init_on_free=1)
    # BEGIN emergency wipe (the trees of prestium-wipe-session; only builtins and the memlocked find)
    F=/usr/bin/find
    REQUIRED="/tmp /var/tmp /dev/shm /run/live/overlay/work /run/live/overlay/rw"
    RUNTIME="/run/prestium /run/prestium-thelounge-launch /run/prestium-thelounge-tor-launch
      /run/prestium-thelounge /run/prestium-thelounge-tor /run/prestium-torrents /run/prestium-i2p
      /run/prestium-tbb /run/prestium-wl /run/tor /run/onion-grater /run/i2pd /run/sudo"
    wipe_tree() {
      if [ ! -d "$1" ] || [ -L "$1" ]; then bad="$bad $1(missing)"; return; fi
      if [ "$1" = /run/live/overlay/work ]; then
        $F "$1" -xdev -mindepth 2 -delete 2>/dev/null || bad="$bad $1(find)"
        $F "$1" -xdev -mindepth 1 -maxdepth 1 ! -type d -delete 2>/dev/null || bad="$bad $1(find)"
        left=$($F "$1" -xdev -mindepth 1 \( -path "$1/*/*" -o ! -type d \) -print -quit 2>/dev/null) || bad="$bad $1(list)"
      else
        $F "$1" -xdev -mindepth 1 -delete 2>/dev/null || bad="$bad $1(find)"
        left=$($F "$1" -xdev -mindepth 1 -print -quit 2>/dev/null) || bad="$bad $1(list)"
      fi
      [ -z "$left" ] || bad="$bad $1(left)"
    }
    wipe_all() {
      bad=; fuse=" "
      while read -r _ mp ty _; do case $ty in fuse|fuse.*) fuse="$fuse$mp " ;; esac; done < /proc/self/mounts
      for t in $RUNTIME; do
        { [ -e "$t" ] || [ -L "$t" ]; } && wipe_tree "$t"
      done
      for u in /run/user/*; do
        [ -d "$u" ] && [ ! -L "$u" ] || continue
        for e in "$u"/* "$u"/.[!.]* "$u"/..?*; do
          [ -e "$e" ] || [ -L "$e" ] || continue
          case $fuse in *" $e "*) continue ;; esac
          $F "$e" -xdev -delete 2>/dev/null || bad="$bad $e(find)"
          { [ -e "$e" ] || [ -L "$e" ]; } && bad="$bad $e(left)"
        done
      done
      for t in $REQUIRED; do wipe_tree "$t"; done
    }
    # END emergency wipe
    wipe_all
    kill -KILL -1 2>/dev/null
    read -r -t 1 -u 4
    wipe_all
    if [ -n "$bad" ]; then
      bad=${bad//[^[:alnum:] \/()._:-]/?}   # names from /run/user: no newlines into the log
      echo "<0>prestium: emergency session wipe FAILED, files may be left in RAM:${bad:0:400}" > /dev/kmsg
    else
      echo "<0>prestium: emergency session wipe done" > /dev/kmsg
    fi
    read -r -t 1 -u 4
    echo o > /proc/sysrq-trigger' ) </dev/null >/dev/null 2>&1 &
fallback=$!
sleep 0.3
kill -0 "$fallback" 2>/dev/null || not_armed "the emergency fallback process did not start"
$FLAG clear usb-watchdog
echo "armed on /dev/$disk (live medium $src), fallback pid $fallback"

emergency() {
  [ -n "$fired" ] && return
  fired=1
  kill -USR1 "$fallback" 2>/dev/null
  echo "<0>prestium: boot medium removed, emergency shutdown" > /dev/kmsg 2>/dev/null
  systemctl --force poweroff &
}

exec 3<> <(:)   # a pipe nothing writes to: "read -t" on it is a builtin sleep
while :; do
  if [ ! -e "/sys/block/$disk" ]; then emergency; fi
  # DVD: the kernel only notices an ejected disc when the drive is opened, so
  # open it each second (": <" is a builtin; it opens without reading).
  if [ -n "$optical" ] && ! : < "/dev/$disk" 2>/dev/null; then emergency; fi
  if read -r size < "/sys/block/$disk/size" 2>/dev/null; then
    [ "$size" = 0 ] && emergency
  else
    emergency
  fi
  read -r -t 1 -u 3 || true
done
