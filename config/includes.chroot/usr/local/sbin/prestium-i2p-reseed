#!/bin/bash
# prestium-i2p-reseed: replace i2pd's reseed file and make i2pd reseed from it.
#   prestium-i2p-reseed               download a fresh .su3 over Tor (StormyCloud first, then the other
#                                     reseed servers i2pd knows, one after the other, until one passes)
#   prestium-i2p-reseed --file PATH   use a .su3 the user downloaded (e.g. from https://reseed2.i2p.net/)
# Runs as root (user may run exactly this script through sudo, /etc/sudoers.d/prestium-i2p-reseed).
# Every file is checked by /usr/local/lib/prestium/verify-su3 against i2pd's reseed certificates
# (/usr/share/i2pd/certificates/reseed/): SU3 format, signature, routerInfo entries, age (downloads:
# at most 14 days old; a manual file older than that only gets a warning). Only then is it installed
# atomically as the file i2pd.conf [reseed] file= names (i2pd 2000:2000, 0644), netDb is cleared and
# i2pd restarted. On any failure the current file stays and i2pd is not touched.
# Output lines "STEP: ..." are progress for the GUI (prestium-i2p-reseed-gui).
# Output lines "NOTE: ..." explain a skipped server; "FAIL: host: reason" (one per server) come before
# the final "ERROR: ..." when every server failed.
# Exit: 0 done, 2 every download source failed (try a manual file), 3 Tor not ready, 1 other error.
set -u
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin
CONF=/var/lib/i2pd/i2pd.conf
CERTS=/usr/share/i2pd/certificates/reseed
VERIFY=/usr/local/lib/prestium/verify-su3
NETDB=/var/lib/i2pd/netDb
MAXSIZE=10485760
SAFE=/usr/local/lib/prestium/safefile
# url  allowed signer (the certificate for each is in $CERTS). StormyCloud first, then the other
# reseed servers built into i2pd 2.56 whose signer has a certificate in i2pd's package, each pinned to
# the signer it was seen signing with (2.1: checked over Tor). A server that is down, slow, has a
# certificate curl rejects (expired, self-signed) or serves a file that fails verify-su3 is skipped and
# the next one is tried. Every attempt goes through Tor; there is no clearnet fallback.
SOURCES=(
  "https://reseed.stormycloud.org/i2pseeds.su3 admin@stormycloud.org,idk@stormycloud.org"
  "https://reseed2.i2p.net/i2pseeds.su3 echelon3@mail.i2p"
  "https://reseed.onion.im/i2pseeds.su3 lazygravy@mail.i2p"
  "https://reseed-fr.i2pd.xyz/i2pseeds.su3 r4sas-reseed@mail.i2p"
  "https://reseed-pl.i2pd.xyz/i2pseeds.su3 r4sas-reseed@mail.i2p"
  "https://www2.mk16.de/i2pseeds.su3 i2p-reseed@mk16.de"
  "https://i2p.novg.net/i2pseeds.su3 igor@novg.net"
  "https://coconut.incognet.io/i2pseeds.su3 rambler@mail.i2p"
)
# the Tor client runs as this uid: the firewall (ferm.conf) lets it reach 127.0.0.1:9050 and nothing
# else; root and debian-tor are not used for the download (root is blocked, debian-tor bypasses Tor)
TORUID=prestium-htp
# 2.1: whole download budget; after it no further server is tried
BUDGET=900

step(){ echo "STEP: $*"; }
# 2.1: every network step runs in its own transient system service as $TORUID, started by systemd,
# never as a child of this script. This helper is started through sudo from the I2P Connection
# Assistant, and when the panel's I2P button started the assistant, it inherited the panel's sandbox
# (prestium-wl-broker.service: RestrictAddressFamilies=AF_UNIX AF_NETLINK, a seccomp filter that
# survives sudo and runuser), so socket(AF_INET) failed with EAFNOSUPPORT and Tor's SOCKS port looked
# unreachable although Tor was running. A unit started by systemd gets a clean environment and its
# own sandbox: no capabilities, no home, read-only system, IPv4 to 127.0.0.1 only (the firewall
# further limits $TORUID to Tor's SOCKS port), no proxy variables from the caller.
NETUNIT=0
tor_run(){ # tor_run SECONDS COMMAND... : stdin/stdout/stderr pass through, exit code is the command's
  local max=$1; shift
  NETUNIT=$((NETUNIT + 1))
  systemd-run --quiet --pipe --wait --collect --service-type=exec \
    --unit "prestium-i2p-reseed-net-$$-$NETUNIT" \
    -p "Description=Prestium: I2P reseed download over Tor" \
    -p "User=$TORUID" -p "Group=$TORUID" -p "RuntimeMaxSec=$max" -p UMask=0077 \
    -p WorkingDirectory=/ -p Environment=HOME=/nonexistent \
    -p NoNewPrivileges=yes -p CapabilityBoundingSet= -p PrivateTmp=yes -p PrivateDevices=yes \
    -p ProtectSystem=strict -p ProtectHome=yes -p ProtectKernelTunables=yes -p ProtectKernelModules=yes \
    -p ProtectKernelLogs=yes -p ProtectControlGroups=yes -p ProtectClock=yes -p ProtectHostname=yes \
    -p "RestrictAddressFamilies=AF_INET AF_UNIX" -p IPAddressDeny=any -p IPAddressAllow=127.0.0.1 \
    -p RestrictNamespaces=yes -p RestrictRealtime=yes -p RestrictSUIDSGID=yes -p LockPersonality=yes \
    -p MemoryDenyWriteExecute=yes -p SystemCallArchitectures=native \
    -- "$@"
}
curl_why(){ # a plain-language reason for a curl exit code
  case "$1" in
    5|7|97) echo "Tor could not connect to the server (it may be down)" ;;
    6) echo "the server name could not be resolved through Tor" ;;
    28) echo "timed out (the server or the Tor circuit is too slow)" ;;
    22) echo "the server answered with an HTTP error" ;;
    35|53|54|58|59|60|66|77|80|83|90|91) echo "TLS failed: the server's certificate is expired, self-signed or does not match" ;;
    47) echo "too many redirects" ;;
    1) echo "the server redirected to a non-HTTPS address" ;;
    63) echo "the file is larger than 10 MB" ;;
    18|56|92|16) echo "the connection broke during the download" ;;
    124|143|137) echo "stopped after the time limit" ;;
    *) echo "curl error $1" ;;
  esac
}
die(){ echo "ERROR: $2"; exit "$1"; }

if [ "$(id -u)" -ne 0 ]; then exec sudo -n /usr/local/sbin/prestium-i2p-reseed "$@"; fi
# sudo keeps the caller's working directory: never run (Python) code from it as root
cd / || exit 1
MODE=download
case "$#:${1:-}" in
  0:) ;;
  2:--file) MODE=file; SRC=$2 ;;
  *) die 1 "usage: prestium-i2p-reseed [--file /path/to/file.su3]" ;;
esac

exec 9>/run/prestium-i2p-reseed.lock
flock -n 9 || die 1 "another reseed is already running"

# 2.0 r4: i2pd.conf (i2pd's file) is read only if it is a regular file, never through a symlink
CONFTXT=$(/usr/local/lib/prestium/safefile read /var/lib/i2pd i2pd.conf) || die 1 "$CONF is not a regular file"
DEST=$(printf '%s\n' "$CONFTXT" | sed -n 's/^[[:space:]]*file[[:space:]]*=[[:space:]]*\(\/var\/lib\/i2pd\/[A-Za-z0-9._-]*\.su3\)[[:space:]]*$/\1/p' | head -n1)
[ -n "$DEST" ] || die 1 "no [reseed] file = /var/lib/i2pd/....su3 in $CONF"
T=$(mktemp -d /run/prestium-i2p-reseed.XXXXXX) || die 1 "cannot create a temporary directory"
trap 'rm -rf "$T"' EXIT
NEW=$T/new.su3

tor_ready(){ # Tor bootstrapped 100 %, asked through the onion-grater (tor-bootstrap.py).
  # The raw control socket is not how Prestium reads bootstrap: the panel and the
  # Tor assistant ask the filter, and that is the answer that is up while Tor is
  # connected. Root is an allowed client of that one script. A clean environment so
  # the filter's client check accepts it (PYTHONNOUSERSITE=1, no LD_*). No -I:
  # that would make the script path argv[2], which the filter does not recognise.
  local pct
  pct=$(env -i PATH=/usr/bin:/bin PYTHONNOUSERSITE=1 /usr/bin/python3 /usr/local/lib/prestium/tor-bootstrap.py 2>/dev/null) || pct=
  case "$pct" in
    100) return 0 ;;
    ""|*[!0-9]*) echo "cannot ask Tor through the onion-grater"; return 1 ;;
    *) echo "Tor bootstrap ${pct}%"; return 1 ;;
  esac
}

if [ "$MODE" = download ]; then
  step "Checking that Tor is connected"
  why=$(tor_ready) || die 3 "Tor is not connected yet ($why). Wait until Tor has connected (Network > Tor Connection Assistant), then try again."
  # the firewall must let $TORUID reach Tor's SOCKS port. Tor restarts (a new
  # connection method, new bridges) keep the control port answering while the SOCKS
  # listener is briefly gone, so retry before failing.
  socks_ok=0; socks_err=
  for _ in 1 2 3; do
    if socks_err=$(tor_run 20 /usr/bin/timeout 10 /bin/bash -c 'exec 3<>/dev/tcp/127.0.0.1/9050' 2>&1); then
      socks_ok=1; break
    fi
    sleep 5
  done
  socks_err=$(printf '%s' "$socks_err" | tr '\n' ' ' | sed 's/^bash: line [0-9]*: //; s/  */ /g; s/ $//')
  [ "$socks_ok" = 1 ] || die 3 "uid $TORUID cannot reach Tor's SOCKS port 127.0.0.1:9050 after 3 tries${socks_err:+ ($socks_err)}. Tor may be restarting: wait a minute and try again (Tor's log: Network > Network Logs)."
  ok=0; tried=0; failed=(); start=$SECONDS
  for s in "${SOURCES[@]}"; do
    url=${s%% *}; signers=${s#* }; host=${url#https://}; host=${host%%/*}
    if [ $((SECONDS - start)) -ge "$BUDGET" ]; then
      echo "NOTE: time budget used up; not trying $host"; failed+=("$host: not tried (time budget used up)"); continue
    fi
    tried=$((tried + 1))
    step "Downloading from $host over Tor ($tried of ${#SOURCES[@]})"
    rm -f "$NEW"
    # own Tor circuit per attempt (SOCKS user name); reseed servers only answer I2P's user agent.
    # -q: no ~/.curlrc; --noproxy '': no host bypasses the proxy; HTTPS only, also after redirects.
    tor_run 200 /usr/bin/curl -q -sSfL --noproxy '' --proto =https --proto-redir =https --max-redirs 3 \
         --max-filesize $MAXSIZE --retry 1 --retry-delay 5 --connect-timeout 45 -m 150 -A "Wget/1.11.4" \
         --proxy "socks5h://prestium-reseed-$$-$RANDOM:x@127.0.0.1:9050" "$url" > "$NEW" 2>"$T/curl.err"
    rc=$?
    if [ "$rc" -ne 0 ]; then
      why=$(curl_why "$rc")
      echo "NOTE: download from $host failed: $why ($(grep -m1 "^curl:" "$T/curl.err" | cut -c1-200))"; failed+=("$host: $why"); continue
    fi
    if [ "$(stat -c %s "$NEW")" -gt $MAXSIZE ]; then
      echo "NOTE: the file from $host is larger than 10 MB"; failed+=("$host: file larger than 10 MB"); continue
    fi
    step "Checking the signature of the file from $host"
    if out=$(python3 -I "$VERIFY" --max-age 14 --signers "$signers" "$NEW" "$CERTS"); then
      echo "$out"; ok=1; FROM=$host; break
    fi
    echo "$out" | sed 's/^ERROR: /NOTE: /'; echo "NOTE: the file from $host was rejected"
    failed+=("$host: $(printf '%s\n' "$out" | sed -n 's/^ERROR: su3: //p' | head -n1)")
  done
  if [ "$ok" != 1 ]; then
    for f in "${failed[@]}"; do echo "FAIL: $f"; done
    die 2 "no reseed server gave a valid file over Tor ($tried of ${#SOURCES[@]} tried; the reasons are the FAIL lines). The current reseed file is kept and i2pd was not restarted. Download a reseed file by hand from https://reseed2.i2p.net/ in Tor Browser, then use the menu entry \"Manual reseed file\"."
  fi
else
  # the path comes from the user: never let root open it. Checks first, then the file is read as the
  # invoking user (so a symlink or a race can only reach what that user may read anyway), size-capped.
  RU=${SUDO_USER:-root}
  case "$SRC" in /*) ;; *) die 1 "the file path must be absolute" ;; esac
  case "$SRC" in *$'\n'*) die 1 "bad file name" ;; esac
  [ -L "$SRC" ] && die 1 "$SRC is a symbolic link; choose the file itself"
  runuser -u "$RU" -- test -f "$SRC" || die 1 "$SRC is not a regular file (or cannot be read)"
  step "Copying $(basename -- "$SRC")"
  runuser -u "$RU" -- head -c $((MAXSIZE + 1)) -- "$SRC" > "$NEW" || die 1 "cannot read $SRC"
  [ "$(stat -c %s "$NEW")" -le $MAXSIZE ] || die 1 "the file is larger than 10 MB, so it is not a reseed file"
  step "Checking the signature"
  out=$(python3 -I "$VERIFY" --max-age 14 --warn-only-age --signers any "$NEW" "$CERTS") \
    || die 1 "$(echo "$out" | sed -n 's/^ERROR: //p' | head -n1) - the file was not installed"
  echo "$out"; FROM="file $(basename -- "$SRC")"
fi

step "Installing the reseed file"
# 2.0 r7: the shipped/previous reseed file is the fallback (it may be stale, but it is usable), and the
# existing netDb is the router's knowledge of the network. Neither is destroyed until i2pd has started
# with the freshly verified file. If anything fails, both come back and the message says the fallback
# is in use (never that the network data is fresh).
OLD=$T/old.su3
HAVE_OLD=0
if [ -e "$DEST" ] || [ -L "$DEST" ]; then
  "$SAFE" read "$(dirname "$DEST")" "$(basename "$DEST")" > "$OLD" \
    || die 1 "cannot back up the current reseed file $DEST, so nothing was changed"
  HAVE_OLD=1
fi
NDB_OLD="$NETDB.prestium-old"
if [ -L "$NDB_OLD" ]; then die 1 "$NDB_OLD is a symbolic link; nothing was changed"; fi
rm -rf -- "$NDB_OLD"
# /var/lib/i2pd is owned by i2pd: never install by path. safefile refuses a symlink, directory or
# special file at DEST and writes through an O_EXCL temp file + fchown/fchmod + renameat.
"$SAFE" write "$(dirname "$DEST")" "$(basename "$DEST")" 2000 2000 0644 < "$NEW" \
  || die 1 "cannot install $DEST (the existing entry is not a regular file?)"
step "Restarting I2P (i2pd) so it reseeds"
restore_old() {   # $1 = reason; puts the fallback su3 and the previous netDb back, starts i2pd
  systemctl stop i2pd 2>/dev/null || true
  r=""
  if [ "$HAVE_OLD" = 1 ]; then
    "$SAFE" write "$(dirname "$DEST")" "$(basename "$DEST")" 2000 2000 0644 < "$OLD" || r="$r; the previous reseed file could NOT be restored"
  fi
  if [ -d "$NDB_OLD" ] && [ ! -L "$NDB_OLD" ]; then
    { [ ! -e "$NETDB" ] || [ -L "$NETDB" ] || rm -rf -- "$NETDB"; } && mv -T -- "$NDB_OLD" "$NETDB" || r="$r; the previous netDb could NOT be restored"
  fi
  if systemctl start i2pd; then
    die 1 "$1. The previous (possibly stale) reseed file and network database are back and i2pd is running$r"
  fi
  die 1 "$1. Restoring the previous reseed file and network database also left i2pd stopped$r (Network > Restart I2P)"
}
systemctl stop i2pd || restore_old "i2pd could not be stopped, so the new reseed file was not used"
# an empty netDb makes i2pd reseed from the file at start; the old one is kept aside until it works
if [ -d "$NETDB" ] && [ ! -L "$NETDB" ]; then
  mv -T -- "$NETDB" "$NDB_OLD" || restore_old "the network database could not be set aside"
  install -d -o 2000 -g 2000 -m "$(stat -c %a "$NDB_OLD")" "$NETDB" || restore_old "a fresh network database directory could not be created"
fi
if ! systemctl start i2pd; then
  echo "WARN: i2pd did not start with the new reseed file; trying once more" >&2
  sleep 2
  systemctl start i2pd || restore_old "i2pd would not start with the new reseed file (two attempts)"
fi
rm -rf -- "$NDB_OLD"
echo "DONE: installed $DEST from $FROM; netDb cleared, i2pd restarted"
exit 0
