#!/usr/bin/python3 -I
"""Prestium 2.0 r11: Wayland broker (root). Keeps the compositor's full socket out of reach of every
application, including unconfined ones.

At login the session asks "start" (any order, any caller: it only takes privileges away):
  * the compositor's socket ($XDG_RUNTIME_DIR/wayland-0, created by labwc) is checked to be labwc's
    and then made root-owned, mode 0600: no process of the user can connect to it any more, and
    the user can't chmod or chown it back (unlinking or renaming it gains nothing either);
  * the restricted socket /run/prestium-wl/<uid>/apps is created in a root-owned directory (so it
    can't be renamed or replaced by a fake that would sit between apps and the compositor) as a
    wp-security-context-v1 listener: clients of it don't get screen capture, input injection,
    clipboard managers, the list of other windows, overlays (layer-shell), session lock, output or
    gamma control. Every application uses it (prestium-run, the browser sandboxes).

The trusted session parts that need the full protocol set are started by this broker, as the user,
each with one connection to the full socket passed as an inherited file descriptor
(WAYLAND_SOCKET), and with WAYLAND_DISPLAY pointing at the restricted socket, so anything they
start in turn is restricted again. Requests (one line on /run/prestium-wl/broker):

  start              lock the full socket, create the restricted one (idempotent)
  menu               open the labwc root menu (panel Menu button)
  panel              start the panel, notifications, wallpaper and idle lock (once per session)
  lock               lock the screen (swaylock); answers when the lock is in place
  set-password       the first session password, asked in a dialog on the full socket (2.1, audit L-2)
  i2p-apply JSON     I2P hops, share level and outproxy: the person confirms in a dialog on the full
                     socket, then the broker runs prestium-i2p-mode apply as root (2.1, review N-2)
  osk                toggle the on-screen keyboard (wvkbd)
  display-settings   output settings (wdisplays)
  scale              apply ~/.config/prestium/scale to every output (wlr-randr)
  wallpaper          show the wallpaper named in ~/.config/prestium/wallpaper (one of WALLPAPERS; 2.1 design batch)
  screenshot         screenshot of the screen the user then clicks (slurp -o, grim)
  screenshot-area    screenshot of an area the user then drags (slurp, grim)
  status             "session <uid> <apps socket>" or "none"

None of them gives the caller anything: the caller never gets a connection to the full socket.
Screenshots always need a real click or drag on an overlay that only the user can make
(applications can't inject input), so an application can't take one unnoticed. Trusted tools run
with an empty, root-owned XDG_CONFIG_HOME/XDG_DATA_HOME and fixed config files, so files the user's
apps can write can't change what they do.
"""
import array, grp, json, os, pwd, re, signal, socket, socketserver, stat, struct, subprocess
import shlex, sys, syslog, threading, time, unicodedata

def _test_env(name, default, _installed="/usr/local/sbin/prestium-wl-broker"):
    """2.1 (audit I-1): the PRESTIUM_* overrides are for the test suite, which runs this file from the
    source tree. The installed copy ignores them, so its paths never depend on sudo's env_reset or on
    what a unit sets."""
    if os.path.realpath(__file__) == _installed:
        return default
    return os.environ.get(name, default)

BASE = _test_env("PRESTIUM_WL_BASE", "/run/prestium-wl")
BROKER = os.path.join(BASE, "broker")
RUNTIME = _test_env("PRESTIUM_WL_RUNTIME", "/run/user/%d")   # %d: uid
LABWC = _test_env("PRESTIUM_WL_LABWC", "/usr/bin/labwc")
SWAYLOCK_CONF = "/usr/share/prestium/swaylock.conf"
SESSION_PASSWORD = "/usr/local/sbin/prestium-session-password"
PW_TEXT = ("Set a password to lock the screen.\nYou'll need it to unlock the screen.\n"
           "Use at least 8 characters; a few unrelated words are best.\nIt lasts until you shut down.")
UID_MIN, UID_MAX = 1000, 60000      # login users (login.defs UID_MIN..UID_MAX)
I2P_MODE = _test_env("PRESTIUM_WL_I2P_MODE", "/usr/local/sbin/prestium-i2p-mode")
I2P_SHARE = {"low": "Low", "medium": "Medium", "high": "High"}
I2P_OUTPROXY = {"acetone": "Acetone", "stormycloud": "StormyCloud", "custom": "Custom"}
I2P_CUSTOM_CHARS = re.compile(r"\A[A-Za-z0-9.:/-]{1,300}\Z")
ETC = _test_env("PRESTIUM_WL_ETC", "/etc/xdg")          # override: tests only

def log(msg, crit=False):
    syslog.syslog(syslog.LOG_CRIT if crit else syslog.LOG_INFO, msg)
    print(msg, file=sys.stderr, flush=True)

# ---------------- Wayland wire protocol (just enough for wp-security-context-v1) ----------------

def wstring(s):
    b = s.encode() + b"\0"
    return struct.pack("=I", len(b)) + b + b"\0" * (-len(b) % 4)

class WlConn:
    def __init__(self, sock):
        self.s = sock; self.buf = b""; self.next_id = 2

    def new_id(self):
        i = self.next_id; self.next_id += 1; return i

    def send(self, obj, op, payload=b"", fds=()):
        msg = struct.pack("=II", obj, ((8 + len(payload)) << 16) | op) + payload
        anc = [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", fds))] if fds else []
        self.s.sendmsg([msg], anc)

    def roundtrip(self, on_event=lambda *a: None, timeout=10):
        cb = self.new_id()
        self.send(1, 0, struct.pack("=I", cb))
        self.s.settimeout(timeout)
        while True:
            while len(self.buf) >= 8:
                obj, so = struct.unpack("=II", self.buf[:8]); size, op = so >> 16, so & 0xffff
                if len(self.buf) < size:
                    break
                body, self.buf = self.buf[8:size], self.buf[size:]
                if obj == 1 and op == 0:
                    raise RuntimeError("compositor protocol error")
                if obj == cb:
                    return
                on_event(obj, op, body)
            d = self.s.recv(65536)
            if not d:
                raise ConnectionError("compositor closed the connection")
            self.buf += d

    def globals(self):
        reg = self.new_id(); self.send(1, 1, struct.pack("=I", reg)); found = {}
        def ev(obj, op, body):
            if obj == reg and op == 0:
                name, n = struct.unpack("=II", body[:8])
                iface = body[8:8 + n - 1].decode()
                ver = struct.unpack("=I", body[8 + n + (-n % 4):][:4])[0]
                found[iface] = (name, ver)
        self.roundtrip(ev)
        return reg, found

# 2.1 (review V-1, verification R-1): accessibility off for everything the broker starts on the full
# socket (dialogs, waybar, wdisplays, ...). GTK 4 reads GTK_A11Y, GTK 3's atk-bridge reads NO_AT_BRIDGE.
# With it on, any program of the user could press buttons in these windows through the AT-SPI bus.
DIALOG_ENV = {"GTK_A11Y": "none", "NO_AT_BRIDGE": "1"}
# 2.1 (design batch): the broker's dialogs read the Prestium GTK colours from a root-owned directory
# (gtk-3.0/gtk.css and gtk-4.0/gtk.css, colours only), never from the user's ~/.config. Only the look
# changes: DIALOG_ENV is still applied last in env(), so accessibility stays off.
# 2.1 (confirm-dialog contrast): that directory is not the session dconf, so libadwaita (zenity 4's
# AdwMessageDialog) would stay on the light color-scheme while gtk4.css paints dark surfaces, leaving
# near-black text on #262626. ADW_DEBUG_COLOR_SCHEME=prefer-dark is set here (the env accepts
# default, prefer-dark or prefer-light; libadwaita ignores gtk-application-prefer-dark-theme and
# GTK_THEME); settings.ini in broker-style covers GTK 3; gtk4.css also sets --*-fg-color.
# 2.1 (design batch): the wallpapers the user can pick (System, Wallpaper); anything else means the default
WALLPAPERS = ("horizon", "circuit", "mark")
WALLPAPER_DIR = "/usr/share/backgrounds/prestium"
DIALOG_STYLE = {"XDG_CONFIG_HOME": "/usr/share/prestium/broker-style",
                "ADW_DEBUG_COLOR_SCHEME": "prefer-dark", "GTK_THEME": "Adwaita:dark"}
INTERPRETER_RE = re.compile(r"\A(python[0-9.]*|perl[0-9.]*|ruby[0-9.]*|node|(ba|da|z|k)?sh)\Z")

# characters Python counts as printable that still show as blank (verification of e574474, N-6)
INVISIBLE = {"\u115f", "\u1160", "\u3164", "\uffa0", "\u2800", "\u180e"}

# never shown, even after a letter: CGJ and the variation selectors
ALWAYS_HIDDEN = re.compile("[\u034f\ufe00-\ufe0f\U000e0100-\U000e01ef]")

def printable(text, limit=200):
    """2.1 (verification N-1, N-6, N-8): a path may hold newlines, bidi or zero-width characters, combining
    marks or blank fillers; never let it forge dialog lines or hide part of the text. Text is NFC first,
    so Amélie or Zürich from macOS stays readable, and at most two combining marks may follow a letter or
    digit (Hindi, Thai, Arabic and Hebrew vowel marks). CGJ, variation selectors, enclosing marks and
    format characters (emoji joiners) are always replaced. Cut text ends in "…"."""
    out, marks = [], -1          # marks: combining marks since the last letter/digit, -1 if none allowed
    for c in unicodedata.normalize("NFC", text):
        cat = unicodedata.category(c)
        if cat == "Mn" and 0 <= marks < 2 and not ALWAYS_HIDDEN.match(c):
            out.append(c); marks += 1
            continue
        if not c.isprintable() or c in INVISIBLE or cat in ("Cf", "Mn", "Me") or ALWAYS_HIDDEN.match(c):
            out.append("?"); marks = -1
            continue
        out.append(c)
        if cat[0] in "LN":
            marks = 0
        elif cat != "Mc":        # a spacing vowel sign (Hindi ि) keeps the letter's cluster going
            marks = -1
    s = "".join(out)
    return s if len(s) <= limit else s[:limit - 1] + "…"

def args_of(argv, n=3):
    """2.1 (verification of 0cdf03c, N-5, N-9): an interpreter's first few arguments, cleaned and quoted
    as a shell would show them, instead of guessing which one is the script (combined flags like -Ic or
    -lc defeat any guess)."""
    args = [a for a in argv if a]
    shown = " ".join(shlex.quote(printable(a.decode(errors="replace"), 60)) for a in args[:n])
    return shown + (" …" if len(args) > n else "")

def describe(pid):
    exe = os.readlink("/proc/%d/exe" % pid)
    what = printable(exe)
    if INTERPRETER_RE.match(os.path.basename(exe)):
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            argv = f.read(4096).split(b"\0")[1:]
        args = args_of(argv)
        if args:
            what += " running %s (self-reported)" % args
    return "%s (pid %d)" % (what, pid)

def requester(pid):
    """The program that sent the request and its parent, from /proc (shown in the I2P dialog; a hint for
    the person at the screen, not a security check: a script's path is what it says it is)."""
    names = []
    for _ in range(2):
        if pid <= 1:
            break
        try:
            names.append(describe(pid))
            with open("/proc/%d/stat" % pid) as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return printable(", started by ".join(names), 500) or "unknown"

def peer_pid(sock):
    return struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))

# ---------------- sessions ----------------

def proc_start(pid):
    try:
        return open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None

def same_exe(pid, path):
    try:
        a, b = os.stat("/proc/%d/exe" % pid), os.stat(path)
        return (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)
    except OSError:
        return False

class Session:
    def __init__(self, uid):
        pw = pwd.getpwuid(uid)
        self.uid, self.gid, self.user = uid, pw.pw_gid, pw.pw_name
        self.home = _test_env("PRESTIUM_WL_HOME", None) or pw.pw_dir      # override: tests only
        self.groups = os.getgrouplist(self.user, self.gid)
        self.rt = RUNTIME % uid
        self.full = os.path.join(self.rt, "wayland-0")
        self.dir = os.path.join(BASE, str(uid))
        self.apps = os.path.join(self.dir, "apps")
        self.empty = os.path.join(self.dir, "empty")
        self.labwc = None; self.labwc_start = None
        self.ctx_conn = None; self.close_w = None
        self.kids = {}; self.lock = threading.Lock(); self.pw_busy = threading.Lock()
        self.i2p_busy = threading.Lock()

    def alive(self):
        return self.labwc is not None and proc_start(self.labwc) == self.labwc_start

    def connect_full(self):
        """A new connection to the compositor's full socket (as root), checked to be labwc's."""
        st = os.lstat(self.full)
        if not stat.S_ISSOCK(st.st_mode):
            raise RuntimeError("%s is not a socket" % self.full)
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
        s.connect(self.full)
        pid, uid, _gid = peer_pid(s)
        if uid != self.uid or not same_exe(pid, LABWC):
            s.close()
            raise RuntimeError("the socket %s is not the user's compositor" % self.full)
        if self.labwc is not None and pid != self.labwc:
            s.close()
            raise RuntimeError("the compositor changed")
        return s, pid

    def start(self):
        with self.lock:
            if self.alive() and os.path.exists(self.apps):
                return "ok already started"
            self.stop_locked()
            s, pid = self.connect_full()
            self.labwc, self.labwc_start = pid, proc_start(pid)
            # 1. lock the full socket: root-owned, 0600 (lchown: never follow a link)
            os.lchown(self.full, 0, 0)
            os.chmod(self.full, 0o600)
            st = os.lstat(self.full)
            if st.st_uid != 0 or stat.S_IMODE(st.st_mode) & 0o077:
                raise RuntimeError("could not lock %s" % self.full)
            # 2. the restricted socket, in a root-owned directory
            os.makedirs(BASE, mode=0o755, exist_ok=True)
            os.makedirs(self.dir, mode=0o755, exist_ok=True)
            os.chown(self.dir, 0, 0); os.chmod(self.dir, 0o755)
            os.makedirs(self.empty, mode=0o555, exist_ok=True)
            try:
                os.unlink(self.apps)
            except FileNotFoundError:
                pass
            lis = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            old = os.umask(0o177); lis.bind(self.apps); os.umask(old)
            os.chown(self.apps, 0, self.gid); os.chmod(self.apps, 0o660)
            lis.listen(64)
            c = WlConn(s)
            reg, found = c.globals()
            if "wp_security_context_manager_v1" not in found:
                raise RuntimeError("the compositor has no security-context support")
            mgr = c.new_id()
            c.send(reg, 0, struct.pack("=I", found["wp_security_context_manager_v1"][0])
                   + wstring("wp_security_context_manager_v1") + struct.pack("=II", 1, mgr))
            close_r, close_w = os.pipe()
            ctx = c.new_id()
            c.send(mgr, 1, struct.pack("=I", ctx), fds=(lis.fileno(), close_r))
            c.send(ctx, 1, wstring("org.prestium.apps"))
            c.send(ctx, 2, wstring("prestium-apps"))
            c.send(ctx, 3, wstring(str(self.uid)))
            c.send(ctx, 4)
            c.roundtrip()
            lis.close(); os.close(close_r)
            self.ctx_conn, self.close_w = c, close_w   # the context lives while close_w is open
            log("uid %d: full Wayland socket locked, restricted socket %s ready" % (self.uid, self.apps))
            return "ok started"

    def stop_locked(self):
        for p in list(self.kids.values()):
            try:
                p.terminate()
            except Exception:
                pass
        self.kids.clear()
        if self.close_w is not None:
            os.close(self.close_w); self.close_w = None
        if self.ctx_conn is not None:
            self.ctx_conn.s.close(); self.ctx_conn = None
        try:
            os.unlink(self.apps)
        except OSError:
            pass
        self.labwc = self.labwc_start = None

    def env(self, extra=None):
        e = {"HOME": self.home, "USER": self.user, "LOGNAME": self.user, "SHELL": "/bin/bash",
             "PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8",
             "XDG_RUNTIME_DIR": self.rt, "DBUS_SESSION_BUS_ADDRESS": "unix:path=%s/bus" % self.rt,
             "WAYLAND_DISPLAY": self.apps, "XDG_SESSION_TYPE": "wayland",
             "XDG_CURRENT_DESKTOP": "labwc:wlroots", "GDK_BACKEND": "wayland",
             "XDG_CONFIG_HOME": self.empty, "XDG_DATA_HOME": self.empty, "XDG_CACHE_HOME": self.empty,
             "XDG_CONFIG_DIRS": "/etc/xdg", "XDG_DATA_DIRS": "/usr/local/share:/usr/share"}
        if extra:
            e.update(extra)
        e.update(DIALOG_ENV)   # last: nothing turns accessibility back on
        return e

    def dialog(self, argv, capture=False, timeout=300):
        """2.1 (review V-1): confirmation and password dialogs run with accessibility off. With it on,
        any process of the user could find the dialog on the AT-SPI bus and press Apply or type into the
        password fields (GTK 4 exposes a click action and SetTextContents), which would undo N-2 and L-2."""
        return self.spawn(argv, wait=True, capture=capture, timeout=timeout, extra_env=dict(DIALOG_STYLE, **DIALOG_ENV))

    def spawn(self, argv, wait=False, capture=False, timeout=None, key=None, extra_env=None):
        """Run argv as the user with one full-socket connection as WAYLAND_SOCKET."""
        s, _pid = self.connect_full()
        fd = s.detach()
        os.set_inheritable(fd, True)
        try:
            p = subprocess.Popen(argv, env=self.env(dict(extra_env or {}, WAYLAND_SOCKET=str(fd))),
                                 user=self.uid, group=self.gid, extra_groups=self.groups,
                                 pass_fds=(fd,), cwd=self.home, start_new_session=True,
                                 stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE if capture else subprocess.DEVNULL)
        finally:
            os.close(fd)
        if key:
            self.kids[key] = p
        if wait or capture:
            try:
                out, _ = p.communicate(timeout=timeout)
            except subprocess.TimeoutExpired:
                # 2.1 (review V-2): don't leave a dialog on screen that no longer does anything
                p.kill(); p.communicate()
                raise
            return p.returncode, (out.decode(errors="replace") if capture else "")
        return p

    def as_user(self, argv, input=None, timeout=10):
        r = subprocess.run(argv, env=self.env(), user=self.uid, group=self.gid, extra_groups=self.groups,
                           cwd=self.home, input=input, capture_output=True, timeout=timeout)
        return r.returncode, r.stdout.decode(errors="replace")

    def running(self, key):
        p = self.kids.get(key)
        return p is not None and p.poll() is None

    # ---------- requests ----------
    def panel(self):
        started = []
        for key, argv in (
                # 2.1 (design batch): the chosen Prestium wallpaper; the colour shows if the image is missing
                ("swaybg", self.swaybg_argv()),
                ("waybar", ["waybar", "-c", ETC + "/waybar/config.jsonc", "-s", ETC + "/waybar/style.css"]),
                ("mako", ["mako", "-c", ETC + "/mako/config"]),
                ("swayidle", ["swayidle", "-w", "timeout", "600", "/usr/local/bin/prestium-lock-screen --auto",
                              "before-sleep", "/usr/local/bin/prestium-lock-screen --auto",
                              "lock", "/usr/local/bin/prestium-lock-screen --auto"])):
            if not self.running(key):
                self.spawn(argv, key=key); started.append(key)
        return "ok " + (" ".join(started) or "running")

    def set_password(self):
        """2.1 (audit L-2): the first session password is set here, not through sudo: the dialog runs on
        the compositor's full socket (no application can draw over it, type into it or read it) and the
        broker, as root, hands the password to prestium-session-password. Any process of the user could
        run "sudo prestium-session-password set" before; now it can only ask for this dialog, which the
        person at the screen fills in."""
        if not self.pw_busy.acquire(blocking=False):
            return "error a password dialog is already open"
        try:
            st = subprocess.run([SESSION_PASSWORD, "status"], capture_output=True, timeout=10)
            if st.stdout.decode(errors="replace").strip() == "set":
                return "ok already set"
            # 2.1 (UI pass): the button says what it does ("Set password", not zenity's "OK")
            rc, out = self.dialog(["zenity", "--forms", "--title", "Lock Screen", "--text", PW_TEXT,
                                   "--ok-label", "Set password", "--cancel-label", "Cancel",
                                   "--add-password", "Password", "--add-password", "Confirm password",
                                   "--separator", "\n"], capture=True, timeout=900)
            if rc != 0:
                return "error cancelled"
            lines = out.split("\n")
            p1, p2 = (lines + ["", ""])[:2]
            err = None
            if not p1 or p1 != p2:
                err = "The passwords are empty or don't match. The screen was not locked."
            elif len(p1) < 8:
                err = "The password is too short: use at least 8 characters. The screen was not locked."
            elif ":" in p1 or "\r" in p1:
                err = "The password can't contain ':'. The screen was not locked."
            if err is None:
                r = subprocess.run([SESSION_PASSWORD, "set"], input=(p1 + "\n").encode(),
                                   capture_output=True, timeout=30)
                if r.returncode == 0:
                    log("uid %d: session password set from the lock dialog" % self.uid)
                    return "ok set"
                err = "Could not set the password. The screen was not locked."
            self.dialog(["zenity", "--error", "--no-markup", "--title", "Lock Screen", "--text", err])
            return "error " + err
        finally:
            p1 = p2 = out = None
            self.pw_busy.release()

    def i2p_apply(self, raw, pid=0):
        """2.1 (review N-2): I2P settings change only after the person at the screen confirms them. The
        dialog runs on the compositor's full socket, so no application can draw over it or click it.
        Before, any process of the user could run "sudo prestium-i2p-mode apply" and silently point the
        browser's outproxy somewhere else. The helper validates the request again in full; every change
        is logged and announced."""
        try:
            req = json.loads(raw)
        except ValueError:
            return "error request is not JSON"
        if (not isinstance(req, dict) or set(req) - {"hops", "share", "outproxy", "custom"}
                or type(req.get("hops")) is not int or not 1 <= req["hops"] <= 7
                or req.get("share") not in I2P_SHARE or req.get("outproxy") not in I2P_OUTPROXY):
            return "error invalid request"
        custom = req.get("custom") or ""
        if req["outproxy"] == "custom" and not (isinstance(custom, str) and I2P_CUSTOM_CHARS.match(custom)):
            return "error invalid custom outproxy"
        what = I2P_OUTPROXY[req["outproxy"]] + (": " + custom if req["outproxy"] == "custom" else "")
        summary = "%d hops, share %s, outproxy %s" % (req["hops"], I2P_SHARE[req["share"]], what)
        text = ("Apply these I2P settings?\n\nHops per tunnel: %d\nShare level: %s\nOutproxy: %s\n\n"
                "i2pd restarts, and I2P connections drop for a minute or two."
                % (req["hops"], I2P_SHARE[req["share"]], what))
        if req["outproxy"] == "custom":
            text += "\n\nThis outproxy sees every clearnet site you visit."
        text += "\n\nAsked for by: " + requester(pid)
        text += "\n\nIf you didn't just press Apply in the I2P Connection Assistant, choose Cancel."
        if not self.i2p_busy.acquire(blocking=False):
            return "error an I2P settings dialog is already open"
        try:
            rc, _ = self.dialog(["zenity", "--question", "--no-markup", "--width", "460",
                                 "--title", "I2P Connection Assistant", "--icon", "i2pd",
                                 "--ok-label", "Apply", "--cancel-label", "Cancel", "--text", text])
            if rc != 0:
                log("uid %d: I2P settings change cancelled at the dialog (%s)" % (self.uid, summary))
                return "error cancelled"
            r = subprocess.run([I2P_MODE, "apply"], input=json.dumps(req), capture_output=True,
                               text=True, timeout=420)   # prestium-i2p-mode BROKER_BUDGET (worst case about 345 s)
            st = None
            for line in reversed(r.stdout.splitlines()):
                try:
                    st = json.loads(line); break
                except ValueError:
                    continue
            if not isinstance(st, dict):
                st = {"ok": False, "error": (r.stderr.strip() or "the helper gave no answer")[-300:]}
            if st.get("ok"):
                log("uid %d: I2P settings applied: %s" % (self.uid, summary))
                try:
                    self.as_user(["notify-send", "-a", "Prestium", "-i", "i2pd",
                                  "I2P settings changed", summary])
                except (OSError, subprocess.SubprocessError):
                    pass
                return "ok " + json.dumps(st)
            log("uid %d: I2P settings not applied (%s): %s" % (self.uid, summary, st.get("error")), crit=True)
            return "error " + str(st.get("error") or "not applied").replace("\n", " ")[:300]
        finally:
            self.i2p_busy.release()

    def lock_screen(self):
        rc, _ = self.spawn(["swaylock", "-f", "-C", SWAYLOCK_CONF], wait=True, timeout=30)
        return "ok locked" if rc == 0 else "error swaylock exit %d" % rc

    def osk(self):
        if self.running("osk"):
            self.kids["osk"].terminate(); return "ok hidden"
        self.spawn(["wvkbd-mobintl", "-L", "280"], key="osk"); return "ok shown"

    def menu(self):
        # 2.0 r20: open labwc's root menu (Super+Space) for the panel's Menu button. wtype needs the
        # virtual-keyboard protocol, which labwc does not offer on the restricted socket that waybar's
        # children get, so the broker runs it on a full-socket connection. Fixed keys only.
        if self.running("menu"):
            return "ok running"
        rc, _ = self.spawn(["wtype", "-M", "logo", "-k", "space", "-m", "logo"], wait=True, timeout=10, key="menu")
        return "ok" if rc == 0 else "error wtype exit %d" % rc

    def display_settings(self):
        if not self.running("wdisplays"):
            self.spawn(["wdisplays"], key="wdisplays")
        return "ok"

    def scale(self):
        sys.path.insert(0, "/usr/local/lib/prestium")
        import importlib.machinery
        ps = importlib.machinery.SourceFileLoader(
            "prestium_scale", _test_env("PRESTIUM_SCALE", "/usr/local/bin/prestium-scale")).load_module()
        rc, val = self.as_user(["cat", "--", os.path.join(self.home, ".config/prestium/scale")])
        setting = ps.parse_setting(val if rc == 0 else "auto")
        rc, out = self.spawn(["wlr-randr", "--json"], capture=True, timeout=15)
        if rc != 0:
            return "error wlr-randr"
        outs = [o for o in json.loads(out) if o.get("enabled")]
        for o in outs:
            name = o.get("name", "")
            if not re.match(r"^[A-Za-z0-9_.-]{1,64}$", name):
                continue
            pct = ps.detect_from([o])[0] if setting == "auto" else setting
            self.spawn(["wlr-randr", "--output", name, "--scale", "%.2f" % (pct / 100.0)], wait=True, timeout=15)
        return "ok %s" % setting

    def wallpaper_name(self):
        """The user's choice in ~/.config/prestium/wallpaper, read as the user (like the scale setting);
        only a name from WALLPAPERS is used, never a path."""
        rc, val = self.as_user(["head", "-c", "32", "--", os.path.join(self.home, ".config/prestium/wallpaper")])
        val = val.strip() if rc == 0 else ""
        return val if val in WALLPAPERS else WALLPAPERS[0]

    def swaybg_argv(self):
        return ["swaybg", "-c", "#161616", "-i", os.path.join(WALLPAPER_DIR, self.wallpaper_name() + ".png"), "-m", "fill"]

    def wallpaper(self):
        p = self.kids.get("swaybg")
        if p is not None and p.poll() is None:
            p.terminate()
            try:
                p.wait(timeout=5)
            except subprocess.TimeoutExpired:
                p.kill()
        self.spawn(self.swaybg_argv(), key="swaybg")
        return "ok " + self.wallpaper_name()

    def screenshot(self, area):
        if self.running("slurp"):
            return "error a screenshot is already being taken"
        rc, geom = self.spawn(["slurp"] if area else ["slurp", "-o", "-r"], capture=True, timeout=120, key="slurp")
        geom = geom.strip()
        if rc != 0 or not re.match(r"^-?\d+,-?\d+ \d+x\d+$", geom):
            return "ok cancelled"
        pics = os.path.join(self.home, "Pictures")
        self.as_user(["mkdir", "-p", "--", pics])
        f = os.path.join(pics, time.strftime("Screenshot-%Y-%m-%d-%H%M%S.png", time.gmtime()))
        rc, _ = self.spawn(["grim", "-g", geom, "--", f], wait=True, timeout=30)
        if rc != 0:
            return "error grim exit %d" % rc
        self.as_user(["notify-send", "-a", "Prestium", "-i", "image-x-generic", "Screenshot saved", f])
        return "ok " + f

sessions = {}
sessions_lock = threading.Lock()

def session_for(uid, create=False):
    with sessions_lock:
        s = sessions.get(uid)
        if s is None and create:
            s = sessions[uid] = Session(uid)
        return s

class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        try:
            pid, uid, _gid = peer_pid(self.request)
            line = self.rfile.readline(1024).decode(errors="replace").strip()
            if uid == 0:
                reply = "error refusing root"
            elif not UID_MIN <= uid <= UID_MAX:
                # 2.1 (audit L-4): system accounts (services, nobody) get nothing from the broker
                reply = "error refusing system uid %d" % uid
            else:
                reply = dispatch(uid, line, pid)
        except Exception as e:
            reply = "error " + str(e).replace("\n", " ")[:300]
            log("request failed: %s" % reply, crit=True)
        try:
            self.wfile.write((reply + "\n").encode())
        except OSError:
            pass

def dispatch(uid, cmd, pid=0):
    if cmd == "start":
        return session_for(uid, create=True).start()
    s = session_for(uid)
    if cmd == "status":
        return "session %d %s" % (uid, s.apps) if s and s.alive() else "none"
    if s is None or not s.alive():
        return "error no session (run start first)"
    with s.lock:
        if cmd == "panel":
            return s.panel()
        if cmd == "osk":
            return s.osk()
        if cmd == "display-settings":
            return s.display_settings()
        if cmd == "menu":
            return s.menu()
        if cmd == "wallpaper":
            return s.wallpaper()
    if cmd == "lock":
        return s.lock_screen()
    if cmd == "set-password":
        return s.set_password()
    if cmd.startswith("i2p-apply "):
        return s.i2p_apply(cmd[len("i2p-apply "):], pid)
    if cmd == "scale":
        return s.scale()
    if cmd in ("screenshot", "screenshot-area"):
        return s.screenshot(cmd == "screenshot-area")
    return "error unknown request"

def reaper():
    while True:
        time.sleep(2)
        with sessions_lock:
            items = list(sessions.items())
        for uid, s in items:
            if s.labwc is not None and not s.alive():
                with s.lock:
                    log("uid %d: compositor gone, session closed" % uid)
                    s.stop_locked()
        for s in [x for _, x in items]:
            for k, p in list(s.kids.items()):
                if p.poll() is not None and k not in ("waybar", "mako", "swaybg", "swayidle"):
                    s.kids.pop(k, None)

class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

def main():
    syslog.openlog("prestium-wl-broker")
    if os.geteuid() != 0:
        print("prestium-wl-broker must run as root", file=sys.stderr); return 1
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    os.makedirs(BASE, mode=0o755, exist_ok=True)
    os.chown(BASE, 0, 0); os.chmod(BASE, 0o755)
    try:
        os.unlink(BROKER)
    except FileNotFoundError:
        pass
    # review of 8f5b9ce: no moment with the socket open to everyone (0660 before the chown below)
    old = os.umask(0o117)
    srv = Server(BROKER, Handler)
    os.umask(old)
    # 2.1 (audit of a5fd1fb, L-4): only group "user" (the session and its apps) may connect; system
    # uids were refused anyway. Without that group (tests), keep the old mode.
    try:
        os.chown(BROKER, 0, grp.getgrnam("user").gr_gid); os.chmod(BROKER, 0o660)
    except KeyError:
        os.chmod(BROKER, 0o666)
    threading.Thread(target=reaper, daemon=True).start()
    subprocess.run(["systemd-notify", "--ready"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    log("listening on %s" % BROKER)
    srv.serve_forever()

if __name__ == "__main__":
    sys.exit(main())
