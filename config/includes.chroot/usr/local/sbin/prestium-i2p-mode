#!/usr/bin/python3 -I
# Prestium 2.1: root helper of the I2P Connection Assistant (run through sudo by "user" only).
#   prestium-i2p-mode status   print the current settings as one JSON line
#   prestium-i2p-mode apply    read one JSON request on stdin, check it, write i2pd's config,
#                              restart i2pd and wait until the browser proxy (127.0.0.1:4444)
#                              is listening (checked in /proc/net/tcp, not by connecting).
#                              If i2pd doesn't come back, both files are put back and i2pd is
#                              restarted again (exit 1). Prints the new state as one JSON line.
# Request: {"hops": 1-7, "share": "low"|"medium"|"high",
#           "outproxy": "acetone"|"stormycloud"|"custom", "custom": "http://NAME.i2p:PORT"}
# What changes:
#   tunnels.conf  inbound/outbound.length of every tunnel except socks-outproxy-* (those stay at 1)
#                 [Web Browser HTTP Proxy] outproxy (the 4444 browser proxy)
#                 socks-outproxy-tcp/udp destination (local port 4500 never changes; a custom
#                 outproxy is HTTP only, so the SOCKS outproxy then stays on Acetone)
#   i2pd.conf     share and bandwidth; [exploratory] and [socksproxy] lengths
#   (the generated torrents tunnel follows the same hops: prestium-i2pd-torrents reads the
#   browser proxy's outbound.length back and writes it, default 3, at every i2pd start)
# Never changed here: inbound/outbound.quantity anywhere (2.1 startup tunnel budget: 4444 2+2, other
# tunnels 1+1, exploratory 3+3, shared destination 2+2; put() replaces only the keys it is given).
# Never touched: the firewall (its i2pd rule follows /run/prestium/i2pd.port, which i2pd's
# ExecStartPre writes again on every start), Tor, the console password.
# /var/lib/i2pd belongs to i2pd, so both files are read and replaced only through safefile
# (a symlink or special file is refused; new file created by root, then renamed over the name).
# 2.1 (shared config lock): two locks.
#   /run/prestium-i2p-apply.lock  one Apply at a time; held for the whole Apply, restart included.
#   /run/prestium-hops.lock       i2pd's config lock, shared with prestium-i2pd-port (i2pd's
#                                 ExecStartPre, which rewrites the port and console password). Held only
#                                 while the files are read, edited and written, and released BEFORE
#                                 i2pd is restarted: the restart runs prestium-i2pd-port, which waits
#                                 for this lock, so holding it across the restart would deadlock.
#   Both sides wait a bounded time (here PRESTIUM_I2P_LOCK_WAIT, 30 s; the port script 10 s) and fail
#   loudly (stderr and syslog) with nothing changed. A rollback takes the lock again, puts back the
#   previous settings but keeps the port and console password the port script wrote meanwhile.
# 2.1 (review of 6bf1234): both lock files are made by tmpfiles (prestium-i2p.conf) as root-only regular
# files, 0600, and opened here with O_NOFOLLOW under umask 077 (a lock file that is a symlink, not a
# regular file, not root's or readable by others is refused): flock(2) works on any open file, so a lock
# file another user could open would let that user hold Apply or i2pd's start up.
# Time budget (the broker gives this helper BROKER_BUDGET s, then kills it): config lock LOCK_WAIT 30 s;
# restart RESTART_TIMEOUT 220 s (i2pd's drop-in: stop at most 30 s, start at most 180 s: the port
# script waits 10 s for the lock and reloads ferm twice at most 60 s each); proxy WAIT 60 s; rollback lock
# 30 s; the rollback's restart is queued (--no-block). Worst case about 345 s, well below 420 s.
import fcntl, json, os, re, stat, subprocess, sys, syslog, time

INSTALLED = os.path.abspath(sys.argv[0]).startswith("/usr/local/")
def _test_env(name, default):
    """Test-only overrides; ignored when run from the installed path."""
    return default if INSTALLED else os.environ.get(name, default)

D = _test_env("PRESTIUM_I2P_DIR", "/var/lib/i2pd")
SAFE = _test_env("PRESTIUM_SAFEFILE", "/usr/local/lib/prestium/safefile")
SYSTEMCTL = _test_env("PRESTIUM_SYSTEMCTL", "/usr/bin/systemctl")
PORTFILE = _test_env("PRESTIUM_I2PD_PORTFILE", "/run/prestium/i2pd.port")
LOCK = _test_env("PRESTIUM_I2P_LOCK", "/run/prestium-hops.lock")   # i2pd config lock, shared with prestium-i2pd-port
APPLY_LOCK = _test_env("PRESTIUM_I2P_APPLY_LOCK", "/run/prestium-i2p-apply.lock")   # one Apply at a time
LOCK_WAIT = float(_test_env("PRESTIUM_I2P_LOCK_WAIT", "30"))
PROXY_PORT = int(_test_env("PRESTIUM_I2P_PROXY_PORT", "4444"))
WAIT = int(_test_env("PRESTIUM_I2P_WAIT", "60"))
RESTART_TIMEOUT = 220   # > i2pd's TimeoutStopSec=30 + TimeoutStartSec=180
BROKER_BUDGET = 420     # prestium-wl-broker's timeout for "apply"
I2PD_UID = int(_test_env("PRESTIUM_I2PD_UID", "2000"))   # i2pd's fixed uid (hook 0100)

ACETONE = "proxy4uwdijqxac2bvdx4fuhem6njmiwukuk2gelejv2nzxka2xq.b32.i2p"
STORMY = "5d4s7pcvfdpftfk7npc7hllyujhufsdprtrf4o53i44rgsa2xbwa.b32.i2p"   # exit.stormycloud.i2p
PRESETS = {   # name: (HTTP outproxy URL, SOCKS outproxy destination, its port)
    "acetone": ("http://%s:3128" % ACETONE, ACETONE, "1080"),
    "stormycloud": ("http://%s" % STORMY, STORMY, "1080"),
}
SHARE = {"low": ("30", "L"), "medium": ("50", "64"), "high": ("80", "128")}   # share %, bandwidth (KB/s)
# 2.1: i2pd.conf ships "medium" (bandwidth = 64, share = 50); L is i2pd's 32 KB/s class
CUSTOM = re.compile(r"\Ahttp://(?:[a-z2-7]{52}\.b32|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*)\.i2p"
                    r"(?::([1-9][0-9]{0,4}))?\Z")

SEC = re.compile(r"^\s*\[([^\]]+)\]\s*$")
KEY = re.compile(r"^\s*([^#;=\s][^=]*?)\s*=\s*(.*?)\s*$")
HTTP_TUNNEL = "Web Browser HTTP Proxy"

def die(msg, code=1):
    print(json.dumps({"ok": False, "error": msg}))
    sys.exit(code)

def custom_ok(url):
    m = CUSTOM.match(url or "")
    return bool(m) and (m.group(1) is None or 1 <= int(m.group(1)) <= 65535) and len(url) <= 300

def sections(lines):
    out = [[None, []]]
    for l in lines:
        m = SEC.match(l)
        if m: out.append([m.group(1).strip(), [l]])
        else: out[-1][1].append(l)
    return out

def get(body, key):
    for l in body:
        m = KEY.match(l)
        if m and m.group(1) == key:
            return m.group(2)
    return None

def put(body, key, value):
    """Set key = value in a section body (replace the first, drop the rest, or append)."""
    out, done = [], False
    for l in body:
        m = KEY.match(l)
        if m and m.group(1) == key:
            if not done:
                out.append("%s = %s" % (key, value)); done = True
            continue
        out.append(l)
    if not done:
        i = len(out)
        while i > 1 and out[i-1].strip() == "": i -= 1
        out[i:i] = ["%s = %s" % (key, value)]
    return out

def check(lines, path):
    seen = set()
    for name, body in sections(lines):
        if name is None: continue
        if name in seen: die("%s: duplicate section [%s]" % (path, name))
        seen.add(name)
        k = [KEY.match(l).group(1) for l in body if KEY.match(l)]
        d = sorted({x for x in k if k.count(x) > 1})
        if d: die("%s: duplicate keys %s in [%s]" % (path, d, name))

def safe_read(name):
    r = subprocess.run([SAFE, "read", D, name], capture_output=True, text=True)
    if r.returncode: die("%s/%s is not a regular file; nothing changed" % (D, name))
    return r.stdout

def safe_write(name, text):
    r = subprocess.run([SAFE, "write", D, name, "2000", "2000", "0644"], input=text, text=True,
                       capture_output=True)
    if r.returncode: raise OSError("cannot write %s/%s: %s" % (D, name, r.stderr.strip()))

def state(tun, main):
    """Current settings, read from i2pd's own files."""
    st = {"hops": None, "share": None, "outproxy": "custom", "custom": "", "port": None,
          "running": subprocess.run([SYSTEMCTL, "is-active", "--quiet", "i2pd"]).returncode == 0}
    tsecs = dict((n, b) for n, b in sections(tun.splitlines()) if n)
    msecs = sections(main.splitlines())
    b = tsecs.get(HTTP_TUNNEL, [])
    url = get(b, "outproxy") or ""
    st["custom"] = url
    for name, (u, _d, _p) in PRESETS.items():
        if url == u: st["outproxy"], st["custom"] = name, ""
    try: st["hops"] = int(get(b, "outbound.length") or "3")
    except ValueError: pass
    top = msecs[0][1]
    share, bw = get(top, "share"), get(top, "bandwidth")
    for name, (s, w) in SHARE.items():
        if (share, bw) == (s, w): st["share"] = name
    st["share_raw"], st["bandwidth_raw"] = share, bw
    try:
        with open(PORTFILE) as f:
            p = f.read().strip()
        st["port"] = int(p) if p.isdigit() else None
    except OSError:
        pass
    return st

def edit(tun, main, req):
    n = str(req["hops"])
    http, sdest, sport = PRESETS.get(req["outproxy"], PRESETS["acetone"])
    if req["outproxy"] == "custom":
        http = req["custom"]   # HTTP only; the SOCKS outproxy keeps Acetone
    res = []
    for name, body in sections(tun.splitlines()):
        if name is not None and get(body, "type") is not None:
            if name.startswith("socks-outproxy"):
                body = put(put(body, "destination", sdest), "destinationport", sport)
            else:
                body = put(put(body, "inbound.length", n), "outbound.length", n)
            if name == HTTP_TUNNEL:
                body = put(body, "outproxy", http)
        res += body
    check(res, "tunnels.conf")
    tun2 = "\n".join(res) + "\n"
    share, bw = SHARE[req["share"]]
    res = []
    for name, body in sections(main.splitlines()):
        if name is None:
            body = put(put(body, "bandwidth", bw), "share", share)
        elif name in ("exploratory", "socksproxy"):
            body = put(put(body, "inbound.length", n), "outbound.length", n)
        res += body
    check(res, "i2pd.conf")
    return tun2, "\n".join(res) + "\n"

def open_lock(path):
    """Open a lock file: never through a symlink, only a regular file of ours, never readable by others."""
    old = os.umask(0o077)
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NOCTTY, 0o600)
    except OSError as e:
        die("lock file %s can't be opened (%s); nothing changed" % (path, e.strerror))
    finally:
        os.umask(old)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
        os.close(fd)
        die("lock file %s is not a regular file of ours; nothing changed" % path)
    if stat.S_IMODE(st.st_mode) != 0o600:
        os.fchmod(fd, 0o600)
    return os.fdopen(fd, "r+")

def restart(*extra):
    """systemctl restart i2pd, bounded: False if it failed or took longer than RESTART_TIMEOUT."""
    try:
        r = subprocess.run([SYSTEMCTL, "restart"] + list(extra) + ["i2pd"], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=RESTART_TIMEOUT)
    except subprocess.TimeoutExpired:
        return False
    return r.returncode == 0

def conf_lock():
    """Take i2pd's config lock (shared with prestium-i2pd-port), waiting at most LOCK_WAIT seconds."""
    lk = open_lock(LOCK)
    end = time.monotonic() + LOCK_WAIT
    while True:
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lk
        except OSError:
            if time.monotonic() >= end:
                msg = "i2pd's configuration is locked (i2pd is starting?) for more than %g s" % LOCK_WAIT
                print("prestium-i2p-mode: " + msg, file=sys.stderr)
                try: syslog.openlog("prestium-i2p-mode"); syslog.syslog(syslog.LOG_ERR, msg)
                except OSError: pass
                lk.close()
                return None
            time.sleep(0.1)

def unlock(lk):
    fcntl.flock(lk, fcntl.LOCK_UN); lk.close()

def carry_port(old, cur):
    """old i2pd.conf with the keys prestium-i2pd-port owns (global port; [http] auth, user, pass)
    taken from cur, so a rollback never undoes the port script's work."""
    cs = sections(cur.splitlines())
    own = {None: (cs[0][1], ("port",))}
    for name, body in cs[1:]:
        if name == "http": own["http"] = (body, ("auth", "user", "pass"))
    res = []
    for name, body in sections(old.splitlines()):
        if name in own:
            src, keys = own[name]
            for k in keys:
                v = get(src, k)
                if v is not None: body = put(body, k, v)
        res += body
    return "\n".join(res) + "\n"

def listening():
    """Is something listening on 127.0.0.1:PROXY_PORT? Read from /proc/net/tcp, never by
    connecting: the firewall lets only the desktop user (and the DoH resolver) reach 4444, so a
    connection from root is refused (2.1 fix: that made every Apply time out and roll back)."""
    want = "0100007F:%04X" % PROXY_PORT
    try:
        with open("/proc/net/tcp") as f:
            next(f)
            # review of 8f5b9ce (N-3): the listener must be i2pd's (uid field), so another process
            # binding 4444 while i2pd restarts can't make a bad configuration look good
            return any(l.split()[1] == want and l.split()[3] == "0A" and l.split()[7] == str(I2PD_UID)
                       for l in f)
    except (OSError, StopIteration, IndexError):
        return False

def proxy_up():
    end = time.monotonic() + WAIT
    while time.monotonic() < end:
        if listening():
            return True
        time.sleep(1)
    return False

def parse(raw):
    try:
        req = json.loads(raw)
    except ValueError:
        die("request is not JSON")
    if not isinstance(req, dict) or set(req) - {"hops", "share", "outproxy", "custom"}:
        die("unknown request fields")
    if type(req.get("hops")) is not int or not 1 <= req["hops"] <= 7: die("hops must be 1-7")
    if req.get("share") not in SHARE: die("share must be low, medium or high")
    if req.get("outproxy") not in ("acetone", "stormycloud", "custom"): die("unknown outproxy")
    if req["outproxy"] == "custom":
        if not isinstance(req.get("custom"), str) or not custom_ok(req["custom"]):
            die("a custom outproxy must be an I2P address such as http://name.i2p:3128")
    else:
        req["custom"] = ""
    return req

def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("status", "apply"):
        print("usage: prestium-i2p-mode status|apply", file=sys.stderr); return 2
    os.chdir("/")
    if sys.argv[1] == "status":
        print(json.dumps(dict(state(safe_read("tunnels.conf"), safe_read("i2pd.conf")), ok=True)))
        return 0
    req = parse(sys.stdin.read(4096))
    op = open_lock(APPLY_LOCK)   # kept open (locked) until exit
    try:
        fcntl.flock(op, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("another I2P settings change is already running")
    lk = conf_lock()
    if lk is None:
        die("i2pd's configuration is busy (i2pd is starting); nothing changed, try again")
    tun, main_ = safe_read("tunnels.conf"), safe_read("i2pd.conf")
    tun2, main2 = edit(tun, main_, req)
    try:
        safe_write("tunnels.conf", tun2); safe_write("i2pd.conf", main2)
    except OSError as e:
        for name, text in (("tunnels.conf", tun), ("i2pd.conf", main_)):
            try: safe_write(name, text)
            except OSError: pass
        die("%s; previous settings restored" % e)
    unlock(lk)   # before the restart: i2pd's ExecStartPre (prestium-i2pd-port) takes this lock
    # review of 8f5b9ce (N-4): the restart's result counts, and a failed rollback is reported, not a traceback
    restarted = restart()
    if restarted and proxy_up():
        print(json.dumps(dict(state(tun2, main2), ok=True)))
        return 0
    why = "i2pd did not restart" if not restarted else "i2pd did not come back with the new settings"
    lk = conf_lock()
    if lk is None:
        die("%s, and restoring the previous settings failed (configuration locked); restart Prestium" % why)
    try:
        safe_write("tunnels.conf", tun); safe_write("i2pd.conf", carry_port(main_, safe_read("i2pd.conf")))
    except OSError as e:
        die("%s, and restoring the previous settings failed (%s); restart Prestium" % (why, e))
    unlock(lk)
    # queued, not waited for: the time budget above; i2pd starts again with the previous settings
    restart("--no-block")
    die("%s, so the previous settings were restored (i2pd is restarting with them)" % why)

if __name__ == "__main__":
    sys.exit(main())
