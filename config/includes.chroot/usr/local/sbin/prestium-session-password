#!/bin/sh
# Prestium: let the live user set a session password once (Tails-style),
# needed to lock the screen. "status" prints set/unset; "set" (root only, from the Wayland
# broker's dialog) reads the new
# password from stdin and only works while no password is set (so it can't be
# used to change an existing password without knowing it).
set -u
U=user
cur=$(getent shadow "$U" | cut -d: -f2)
case "${1:-}" in
  status)
    case "$cur" in ""|"!"|"*"|"!*") echo unset ;; *) echo set ;; esac ;;
  set)
    # 2.1 (audit L-2): only the Wayland broker (root, from its own dialog) sets it; never through sudo
    [ -z "${SUDO_USER:-}${SUDO_UID:-}" ] || { echo "set is not allowed through sudo" >&2; exit 1; }
    case "$cur" in ""|"!"|"*"|"!*") ;; *) echo "password already set" >&2; exit 1 ;; esac
    IFS= read -r pw || exit 1
    [ -n "$pw" ] || { echo "empty password" >&2; exit 1; }
    # 2.1 (security audit): at least 8 characters (the screen lock relies on it)
    [ "${#pw}" -ge 8 ] || { echo "too short: use at least 8 characters" >&2; exit 1; }
    case "$pw" in *:*) echo "':' is not allowed" >&2; exit 1 ;; esac
    printf '%s:%s\n' "$U" "$pw" | chpasswd || exit 1
    echo ok ;;
  *) echo "usage: $0 status|set" >&2; exit 2 ;;
esac
