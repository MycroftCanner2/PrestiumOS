#!/usr/bin/python3 -I
"""Prestium 2.1: the Tor, i2pd and onion-grater logs the desktop user may read, without a sudo rule and
without the systemd-journal or adm group for the user.

Started at boot by prestium-logs.service (not root: user prestium-logs, journal group only, no network,
read-only system). Every 10 seconds it reads this boot's last entries of exactly three units from the
journal and writes them, cleaned, to /run/prestium/logs/{tor,i2p,onion-grater}.log (0640, group user
through the setgid directory). Nothing it does depends on input from the user: the unit list is fixed
here, and it takes no arguments. The desktop opens the files with prestium-logs-view (read-only).

Cleaning: an entry is kept only if the journal says it came from the unit itself (_SYSTEMD_UNIT, a
field only journald sets), from systemd (PID 1) about that unit, or — for i2pd only, which logs via
syslog — with SYSLOG_IDENTIFIER=i2pd (journald does not always tag syslog messages with
_SYSTEMD_UNIT). Every control, format (bidi,
zero-width), private-use, unassigned, surrogate and line/paragraph separator character in it is
replaced with "?", tabs become spaces, and each line is cut at 1000 characters, so a log line can't
move the cursor, colour the terminal, reorder text or pretend to be several lines.
2.1 (review of 6bf1234): one journal entry is always one line. A "\n" inside a message is written as
the two characters "\n" (and a backslash as "\\"), so a program can't add a line that looks like
another entry of the log (onion-grater logs a refused client's path, which that client chose). At most
2 combining marks follow a character; the rest of a run is replaced with one "?" (no "zalgo" text
covering the lines around it). When journalctl fails, the file says so, instead of being empty.
"""
import json
import os
import subprocess
import sys
import tempfile
import time
import unicodedata


def _test_env(name, default, _installed="/usr/local/sbin/prestium-logs"):
    """The PRESTIUM_* overrides are for the test suite (run from the source tree); the installed copy
    ignores them."""
    if os.path.realpath(__file__) == _installed:
        return default
    return os.environ.get(name, default)


OUT = _test_env("PRESTIUM_LOGS_OUT", "/run/prestium/logs")
JOURNALCTL = _test_env("PRESTIUM_LOGS_JOURNALCTL", "/usr/bin/journalctl")
EVERY = 10
LINES = 400
MAXLEN = 1000
# file name -> systemd unit. Only these, ever.
UNITS = {
    "tor": "tor@default.service",
    "i2p": "i2pd.service",
    "onion-grater": "prestium-onion-grater.service",
}
BAD_CATEGORIES = {"Cc", "Cf", "Co", "Cn", "Cs", "Zl", "Zp"}
MAX_MARKS = 2


def clean(text):
    out = []
    marks = 0
    for ch in text:
        cat = unicodedata.category(ch)
        if cat[0] == "M":
            marks += 1
            if marks <= MAX_MARKS:
                out.append(ch)
            elif marks == MAX_MARKS + 1:
                out.append("?")
            continue
        marks = 0
        if ch == "\t":
            out.append(" ")
        elif cat in BAD_CATEGORIES:
            out.append("?")
        else:
            out.append(ch)
    s = "".join(out)
    return s if len(s) <= MAXLEN else s[:MAXLEN - 1] + "\u2026"


def field(entry, name):
    v = entry.get(name)
    if isinstance(v, list):   # journalctl -o json: a byte array for binary or non-UTF-8 data
        if v and all(isinstance(x, int) for x in v):
            v = bytes(b & 0xFF for b in v).decode("utf-8", "replace")
        else:
            return ""
    return v if isinstance(v, str) else ""


def belongs(entry, unit):
    if field(entry, "_SYSTEMD_UNIT") == unit:
        return True
    if field(entry, "_PID") == "1" and field(entry, "UNIT") == unit:
        return True
    # i2pd logs via syslog (--log=syslog), and journald does not always tag
    # syslog-origin messages with _SYSTEMD_UNIT, so journalctl -u i2pd.service
    # can return them with only SYSLOG_IDENTIFIER=i2pd set. Accept that ident
    # for this unit only (an arbitrary process could forge an ident, but the
    # journal itself, not the message, is what prestium-logs reads; Tor and
    # onion-grater log to stdout/stderr and keep the strict _SYSTEMD_UNIT rule).
    if unit == "i2pd.service" and field(entry, "SYSLOG_IDENTIFIER") == "i2pd":
        return True
    return False


def render(unit, json_lines):
    rows = []
    for raw in json_lines:
        try:
            e = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(e, dict) or not belongs(e, unit):
            continue
        try:
            t = time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(int(field(e, "__REALTIME_TIMESTAMP")) / 1e6))
        except ValueError:
            t = "????-??-?? ??:??:??"
        who = field(e, "SYSLOG_IDENTIFIER") or ("systemd" if field(e, "_PID") == "1" else "?")
        # one entry, one line: "\n" is shown as \n (a backslash as \\); CR, VT, FF, NEL and U+2028/2029
        # are replaced in clean()
        msg = field(e, "MESSAGE").rstrip("\n").replace("\\", "\\\\").replace("\n", "\\n")
        rows.append(clean("%s UTC %s: %s" % (t, clean(who.replace("\n", " ")), msg)))
    head = "# %s, this boot, last %d entries (UTC), refreshed every %d s by prestium-logs\n" % (unit, LINES, EVERY)
    return head + "".join(r + "\n" for r in rows)


class JournalError(Exception):
    pass


def read(unit):
    try:
        r = subprocess.run([JOURNALCTL, "-b", "-u", unit, "-n", str(LINES), "-o", "json", "--no-pager", "-q"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           timeout=30, env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8", "SYSTEMD_PAGER": ""})
    except subprocess.TimeoutExpired:
        raise JournalError("journalctl did not answer within 30 s")
    except OSError as e:
        raise JournalError("could not run journalctl: %s" % e.strerror)
    err = r.stderr.decode("utf-8", "replace").strip().splitlines()
    # some systemd versions exit 1 when nothing matched; with -q -o json that prints nothing at all
    if r.returncode == 1 and not r.stdout.strip() and not [l for l in err if "No entries" not in l]:
        return []
    if r.returncode != 0:
        raise JournalError("journalctl failed (exit status %d)%s" % (r.returncode, (": " + err[-1][:200]) if err else ""))
    return r.stdout.decode("utf-8", "replace").splitlines()


def failed(unit, why):
    """What the file shows when the journal can't be read: a clear error, not an empty log."""
    now = time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime())
    return ("# %s, this boot (UTC), refreshed every %d s by prestium-logs\n"
            "# ERROR at %s UTC: the journal could not be read: %s\n"
            "# The log is not shown. It is tried again in %d s (see: systemctl status prestium-logs).\n"
            % (unit, EVERY, now, clean(why), EVERY))


def put(name, text):
    path = os.path.join(OUT, name + ".log")
    try:
        with open(path, encoding="utf-8") as f:
            if f.read() == text:
                return
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(dir=OUT, prefix="." + name + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o640)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def once():
    for name, unit in UNITS.items():
        try:
            try:
                text = render(unit, read(unit))
            except JournalError as e:
                print("prestium-logs: %s: %s" % (unit, e), file=sys.stderr)
                text = failed(unit, str(e))
            put(name, text)
        except (OSError, subprocess.SubprocessError) as e:
            print("prestium-logs: %s: %s" % (unit, e), file=sys.stderr)


def main(argv):
    if argv[1:]:
        print("prestium-logs takes no arguments", file=sys.stderr)
        return 2
    os.umask(0o027)
    while True:
        once()
        if _test_env("PRESTIUM_LOGS_ONCE", ""):
            return 0
        time.sleep(EVERY)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
