#!/usr/bin/python3 -I
"""Prestium 2.0 r11: ask the Wayland broker (root) for something that needs the compositor's full
socket: start | panel | menu | lock | set-password | osk | display-settings | scale | screenshot | screenshot-area |
status | i2p-apply JSON. The caller never gets that socket; see /usr/local/sbin/prestium-wl-broker."""
import os, socket, sys
OK = ("start", "panel", "menu", "lock", "set-password", "osk", "display-settings", "scale", "screenshot", "screenshot-area", "status")
# 2.1 (review N-2): i2p-apply takes one argument, the I2P Connection Assistant's JSON request (one line)
if len(sys.argv) == 3 and sys.argv[1] == "i2p-apply" and "\n" not in sys.argv[2] and len(sys.argv[2]) <= 900:
    req = "i2p-apply " + sys.argv[2]
elif len(sys.argv) == 2 and sys.argv[1] in OK:
    req = sys.argv[1]
else:
    print("usage: prestium-wl " + "|".join(OK) + " | i2p-apply JSON", file=sys.stderr); sys.exit(2)
s = socket.socket(socket.AF_UNIX)
try:
    s.connect(os.path.join(os.environ.get("PRESTIUM_WL_BASE", "/run/prestium-wl"), "broker"))
except OSError as e:
    print("prestium-wl: the Wayland broker is not running (%s)" % e, file=sys.stderr); sys.exit(1)
s.sendall(req.encode() + b"\n")
s.settimeout(None if sys.argv[1].startswith("screenshot") or sys.argv[1] in ("set-password", "i2p-apply") else 60)
reply = b""
while not reply.endswith(b"\n"):
    d = s.recv(4096)
    if not d:
        break
    reply += d
reply = reply.decode(errors="replace").strip()
print(reply)
sys.exit(0 if reply.startswith(("ok", "session", "none")) else 1)
