#!/bin/bash
# prestium-tunnel-hops: set the number of hops for Prestium's i2pd tunnels.
# Usage: prestium-tunnel-hops [1-7]   (no argument: ask)
# 2.1: a command-line front end for the I2P Connection Assistant's root helper
# (/usr/local/sbin/prestium-i2p-mode). It keeps the current share level and outproxy and changes
# only the hops; the helper writes i2pd's files, restarts i2pd and rolls back if the browser proxy
# (4444) doesn't come back. The menu entry is now Network > I2P Connection Assistant.
set -e
N="$1"
if [ -z "$N" ]; then read -rp "Hops per tunnel (1-7, default 3): " N; N=${N:-3}; fi
[[ "$N" =~ ^[1-7]$ ]] || { echo "Hops must be 1-7" >&2; exit 1; }
H=(/usr/bin/sudo -n /usr/local/sbin/prestium-i2p-mode)
[ "$(id -u)" -eq 0 ] && H=(/usr/local/sbin/prestium-i2p-mode)
cur=$("${H[@]}" status)
req=$(python3 -I -c '
import json, sys
s = json.loads(sys.argv[1])
if not s.get("ok"): sys.exit("cannot read the current settings: %s" % s.get("error"))
print(json.dumps({"hops": int(sys.argv[2]), "share": s.get("share") or "low",
                  "outproxy": s.get("outproxy") or "acetone", "custom": s.get("custom") or ""}))' "$cur" "$N")
out=$(printf '%s' "$req" | "${H[@]}" apply) && rc=0 || rc=$?
python3 -I -c '
import json, sys
s = json.loads(sys.argv[1].splitlines()[-1])
print("Hop count set to %d; i2pd restarted." % s["hops"] if s.get("ok") else "Not applied: %s" % s.get("error"))' "$out" || true
exit "$rc"
