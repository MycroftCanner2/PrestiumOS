#!/bin/sh
# Prestium: local-only Firefox for Prestium's own web pages:
#   I2P Router Console  http://127.0.0.1:7070/  (optional http://i2pd:pass@...)
#   I2P Torrents        http://127.0.0.1:7685/<per-boot secret>/web/
#   IRC (I2P)           http://127.0.0.1:9000/ (The Lounge; signed in through a one-off page from prestium-irc)
#   IRC (Tor)           http://127.0.0.1:9010/ (The Lounge's Tor instance; prestium-irc tor)
# It runs with the primary group "prestium-localweb". The firewall (ferm) lets that
# group open TCP connections only to 127.0.0.1 ports 7070, 7685, 9000 and 9010: no Internet,
# no Tor or I2P proxies, no IPv6. Prefs/policies (/opt/firefox/distribution/policies.json)
# add a second layer (no proxy, website filter, no updates/telemetry).
# For browsing use "I2P Browser" (LibreWolf) or "Tor Browser".
URL="${1:-http://127.0.0.1:7070/}"
case "$URL" in
  http://127.0.0.1:7070/*|http://127.0.0.1:7685/*|http://127.0.0.1:9000/*|http://127.0.0.1:9010/*) ;;
  http://i2pd:*@127.0.0.1:7070|http://i2pd:*@127.0.0.1:7070/*) ;;
  # 2.1 (review): prestium-irc's one-off sign-in page (keeps the token out of the command line)
  "file://$HOME/.local/share/prestium-localfox/irc-launch/"*.html) ;;
  *) echo "prestium-localfox: only Prestium's local pages (127.0.0.1:7070, 7685, 9000, 9010)" >&2; exit 2 ;;
esac
case "$URL" in *[!A-Za-z0-9:/._#?=%@-]*) echo "prestium-localfox: bad URL" >&2; exit 2 ;; esac
P="$HOME/.local/share/prestium-localfox"
mkdir -p "$P" && chmod 700 "$P" || exit 1
cp -f /usr/local/share/prestium-localfox/user.js "$P/user.js"
# distrust the eMudhra (emSign) roots built into Firefox
[ -e "$P/cert9.db" ] || cp /usr/local/share/prestium-nssdb/cert9.db /usr/local/share/prestium-nssdb/key4.db "$P/"
# 2.1: no value ($HOME in $P, the URL) is ever parsed by a shell. Debian's sg takes only "sg GROUP -c CMD"
# and refuses any further argument, so the profile and URL reach Firefox through the environment, which
# sg keeps: the -c string is a fixed literal that only expands them as quoted words.
if [ "$(id -gn)" = prestium-localweb ]; then
  exec /opt/firefox/firefox --name prestium-localfox --class PrestiumLocalFirefox --profile "$P" "$URL"
fi
PRESTIUM_LF_PROFILE=$P PRESTIUM_LF_URL=$URL
export PRESTIUM_LF_PROFILE PRESTIUM_LF_URL
exec sg prestium-localweb -c 'exec /opt/firefox/firefox --name prestium-localfox --class PrestiumLocalFirefox --profile "$PRESTIUM_LF_PROFILE" "$PRESTIUM_LF_URL"'
