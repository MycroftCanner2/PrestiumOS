#!/usr/bin/env python3
"""Categorized Applications dropdown menu for labwc + Waybar."""

import os
import re
import shlex
import signal
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gdk, Gio, GLib, Gtk

try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell

    HAS_LAYER_SHELL = True
except ValueError:
    HAS_LAYER_SHELL = False

PID_FILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "prestium-apps-menu.pid"
)

FAVORITE_IDS = [
    "torbrowser.desktop",
    "org.prestium.I2PConnectionAssistant.desktop",
    "prestium-tor-assistant.desktop",
    "pcmanfm.desktop",
    "org.gnome.Nautilus.desktop",
    "foot.desktop",
    "org.keepassxc.KeePassXC.desktop",
]

CATEGORY_MAP = [
    ("Accessories", "applications-utilities", {"Utility"}),
    ("Graphics", "applications-graphics", {"Graphics"}),
    ("Internet", "applications-internet", {"Network"}),
    ("Office", "applications-office", {"Office"}),
    ("Sound & Video", "applications-multimedia", {"AudioVideo", "Audio", "Video"}),
    ("System Tools", "applications-system", {"System", "Settings"}),
]

MENU_CSS = b"""
window#prestium-apps-menu {
    background-color: #ffffff;
    color: #2e3436;
    border: 1px solid #cdc7c2;
    border-radius: 0 0 8px 8px;
}
.menu-sidebar {
    background-color: #f6f5f4;
    border-right: 1px solid #cdc7c2;
    padding: 6px;
}
.category-row {
    padding: 7px 12px;
    border-radius: 6px;
    color: #2e3436;
    font-family: Cantarell, sans-serif;
    font-size: 11pt;
}
.category-row:selected, .category-row:hover {
    background-color: #3584e4;
    color: #ffffff;
}
.app-list {
    background-color: #ffffff;
    padding: 6px;
}
.app-row {
    padding: 6px 10px;
    border-radius: 6px;
    color: #2e3436;
    font-family: Cantarell, sans-serif;
    font-size: 11pt;
}
.app-row:hover, .app-row:selected {
    background-color: #ebebeb;
    color: #2e3436;
}
.app-desc {
    font-size: 9pt;
    color: #5e5c64;
}
"""


def toggle_existing_instance() -> bool:
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r", encoding="utf-8") as fh:
                old_pid = int(fh.read().strip())
            os.kill(old_pid, signal.SIGTERM)
            os.unlink(PID_FILE)
            return True
        except (OSError, ValueError):
            try:
                os.unlink(PID_FILE)
            except OSError:
                pass
    with open(PID_FILE, "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))
    return False


def cleanup_pid(*_args) -> None:
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE, "r", encoding="utf-8") as fh:
                if fh.read().strip() == str(os.getpid()):
                    os.unlink(PID_FILE)
    except OSError:
        pass


def clean_exec_command(cmdline: str) -> list:
    stripped = re.sub(r"%[fFuUdDnNickvm]", "", cmdline).strip()
    parts = shlex.split(stripped)
    if not parts:
        return []
    # Route GUI apps through prestium-run so they inherit the restricted
    # Wayland socket (no screen capture, input injection or window snooping).
    # Prestium's own launchers already handle their environment themselves.
    runner = "/usr/local/bin/prestium-run"
    if (
        os.path.exists(runner)
        and parts[0] not in (runner, "prestium-run")
        and not parts[0].startswith("/usr/local/bin/prestium-")
    ):
        return [runner] + parts
    return parts


def collect_apps():
    all_infos = [
        info
        for info in Gio.AppInfo.get_all()
        if isinstance(info, Gio.DesktopAppInfo) and info.should_show()
    ]
    by_id = {info.get_id(): info for info in all_infos if info.get_id()}

    categorized = {name: [] for name, _, _ in CATEGORY_MAP}
    categorized["Favorites"] = []
    categorized["Prestium"] = []

    for fav_id in FAVORITE_IDS:
        if fav_id in by_id:
            categorized["Favorites"].append(by_id[fav_id])

    for info in sorted(all_infos, key=lambda i: (i.get_display_name() or "").lower()):
        app_id = info.get_id() or ""
        if app_id.startswith(("prestium-", "org.prestium.")):
            categorized["Prestium"].append(info)

        raw_cats = set((info.get_categories() or "").split(";"))
        for cat_name, _, triggers in CATEGORY_MAP:
            if raw_cats & triggers:
                categorized[cat_name].append(info)

    return categorized


class PrestiumAppsMenu(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("prestium-apps-menu")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_default_size(540, 420)

        # Adwaita icons (the session icon theme): the sidebar rows look up
        # symbolic icons that only resolve correctly in the light theme.
        Gtk.Settings.get_default().set_property("gtk-icon-theme-name", "Adwaita")

        if HAS_LAYER_SHELL:
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 28)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, 4)
            GtkLayerShell.set_keyboard_mode(
                self, GtkLayerShell.KeyboardMode.ON_DEMAND
            )

        provider = Gtk.CssProvider()
        provider.load_from_data(MENU_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.apps_by_cat = collect_apps()

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(root)

        # Left category sidebar
        self.cat_list = Gtk.ListBox()
        self.cat_list.get_style_context().add_class("menu-sidebar")
        self.cat_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.cat_list.set_size_request(190, -1)
        root.pack_start(self.cat_list, False, False, 0)

        # Right application list
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.app_list = Gtk.ListBox()
        self.app_list.get_style_context().add_class("app-list")
        self.app_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        scroll.add(self.app_list)
        root.pack_start(scroll, True, True, 0)

        sidebar_entries = [("Favorites", "emblem-favorite")]
        sidebar_entries.extend((name, icon) for name, icon, _ in CATEGORY_MAP)
        if self.apps_by_cat["Prestium"]:
            sidebar_entries.append(("Prestium", "security-high"))

        first_row = None
        for cat_name, icon_name in sidebar_entries:
            if not self.apps_by_cat.get(cat_name):
                continue
            row = Gtk.ListBoxRow()
            row.cat_name = cat_name
            row.get_style_context().add_class("category-row")
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
            lbl = Gtk.Label(label=cat_name, xalign=0.0)
            box.pack_start(img, False, False, 0)
            box.pack_start(lbl, True, True, 0)
            row.add(box)
            self.cat_list.add(row)
            if first_row is None:
                first_row = row

        self.cat_list.connect("row-selected", self.on_category_selected)
        self.app_list.connect("row-activated", self.on_app_activated)
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", lambda *_: Gtk.main_quit())
        self.connect("destroy", lambda *_: Gtk.main_quit())

        if first_row is not None:
            self.cat_list.select_row(first_row)

    def on_category_selected(self, _listbox, row):
        if row is None:
            return
        for child in self.app_list.get_children():
            self.app_list.remove(child)

        for info in self.apps_by_cat.get(row.cat_name, []):
            app_row = Gtk.ListBoxRow()
            app_row.app_info = info
            app_row.get_style_context().add_class("app-row")

            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            gicon = info.get_icon()
            if gicon is not None:
                img = Gtk.Image.new_from_gicon(gicon, Gtk.IconSize.DND)
            else:
                img = Gtk.Image.new_from_icon_name(
                    "application-x-executable", Gtk.IconSize.DND
                )
            img.set_pixel_size(24)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            name_lbl = Gtk.Label(label=info.get_display_name() or "", xalign=0.0)
            vbox.pack_start(name_lbl, False, False, 0)

            desc = info.get_description()
            if desc:
                desc_lbl = Gtk.Label(label=desc, xalign=0.0)
                desc_lbl.set_ellipsize(3)  # Pango.EllipsizeMode.END
                desc_lbl.get_style_context().add_class("app-desc")
                vbox.pack_start(desc_lbl, False, False, 0)

            hbox.pack_start(img, False, False, 0)
            hbox.pack_start(vbox, True, True, 0)
            app_row.add(hbox)
            self.app_list.add(app_row)

        self.app_list.show_all()

    def on_app_activated(self, _listbox, row):
        if row is None or not hasattr(row, "app_info"):
            return
        cmdline = row.app_info.get_commandline() or ""
        argv = clean_exec_command(cmdline)
        if argv:
            subprocess.Popen(
                argv,
                start_new_session=True,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        Gtk.main_quit()

    def on_key_press(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        return False


def main():
    if toggle_existing_instance():
        return
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    signal.signal(signal.SIGINT, lambda *_: Gtk.main_quit())
    try:
        win = PrestiumAppsMenu()
        win.show_all()
        Gtk.main()
    finally:
        cleanup_pid()


if __name__ == "__main__":
    main()
