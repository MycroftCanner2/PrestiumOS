#!/bin/sh
# Prestium: lock the screen. 2.0 r10: swaylock (Wayland session lock: the compositor
# itself blanks every output, nothing else can draw or read input while locked). Started by
# swayidle (10 minutes idle, logind lock request, before suspend), the "Lock Screen" menu item
# and Super+L. The live user has no password at boot (autologin), so the first
# time we ask for one, as Tails does; without a password the screen isn't
# locked (an empty password would unlock it).
pgrep -x swaylock >/dev/null && exit 0
st=$(sudo -n /usr/local/sbin/prestium-session-password status 2>/dev/null)
if [ "$st" != set ]; then
  # 2.1 (audit L-2): the broker asks for the password on the compositor's full socket and sets it as
  # root; "sudo prestium-session-password set" is no longer allowed to the user (or any of its programs)
  /usr/local/bin/prestium-wl set-password >/dev/null 2>&1 || exit 0
fi
exec /usr/local/bin/prestium-wl lock
