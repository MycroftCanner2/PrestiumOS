#!/bin/bash
# Prestium: say when Prestium runs in a virtual machine (quick_qubes: for information, the VM is the expected
# environment), and show the network
# diagnosis prestium-vm-netcheck (root, boot) writes to /run/prestium/vm when Tor or I2P can't connect.
# Started from the session autostart. On real hardware the service never runs and this exits.
D=${PRESTIUM_VM_OUT:-/run/prestium/vm}
WAIT=${PRESTIUM_VM_NOTIFY_WAIT:-120}   # seconds to wait for $D/virt at session start
POLL=${PRESTIUM_VM_NOTIFY_POLL:-30}
LIFE=${PRESTIUM_VM_NOTIFY_LIFE:-3600}  # stop watching after an hour (the service gives up after ~40 min)
# mako renders Pango markup: escape it, so "<clock offset='utc'>" is shown, not swallowed as a tag
esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
n=0
while [ ! -s "$D/virt" ]; do
  [ "$n" -ge "$WAIT" ] && exit 0
  sleep 5; n=$((n + 5))
done
virt=$(head -c 40 "$D/virt" | tr -cd 'a-z0-9_-')
# quick_qubes: this build is made for virtual machines, so this is information (normal urgency, the usual
# timeout, no warning icon), not a warning. It still says what the host can see: that is true in any VM.
notify-send -a Prestium -i dialog-information -u normal "Prestium quick_qubes: virtual machine${virt:+ ($virt)}" \
  "This build is made to run in a virtual machine or Qubes OS. As in any VM, the host and its virtualization software (in Qubes OS: dom0) can see what you type and what is on screen; the host's network side (in Qubes OS: sys-firewall, sys-net) sees only Tor and I2P connections. Run it on a computer you trust." 2>/dev/null
last=
t=0
while [ "$t" -lt "$LIFE" ]; do
  if [ -s "$D/network" ]; then
    cur=$(head -c 1500 "$D/network" | esc)
    if [ "$cur" != "$last" ]; then
      last=$cur
      notify-send -a Prestium -i network-error -u critical -t 0 "Network problem in the virtual machine" "$cur" 2>/dev/null
    fi
  elif [ -n "$last" ]; then
    last=
    notify-send -a Prestium -i network-transmit-receive -u normal "Network OK" "Tor and I2P are connected." 2>/dev/null
  fi
  sleep "$POLL"; t=$((t + POLL))
done
exit 0
