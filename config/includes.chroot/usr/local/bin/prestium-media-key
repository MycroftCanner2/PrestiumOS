#!/bin/sh
# Prestium 2.0: laptop/multimedia keys (bound in /etc/xdg/labwc/rc.xml) with an on-screen
# notification. Volume through PipeWire (wpctl; pactl as fallback), brightness with brightnessctl
# (user is in group "video"; the udev rule makes the backlight writable for that group).
#   prestium-media-key volume-up|volume-down|mute|mic-mute|brightness-up|brightness-down
# 2.1 (design batch): category prestium.osd, so mako draws these as a compact on-screen display
# 2.1 (UI pass): the level is mako's progress bar only (the int:value hint); the text bar of ▮/▯ glyphs
# drawn under it said the same thing twice. Icons: Papirus's 48 px notification-* set.
ID_FILE="${XDG_RUNTIME_DIR:-/tmp}/prestium-osd.id"
SINK=@DEFAULT_AUDIO_SINK@; SOURCE=@DEFAULT_AUDIO_SOURCE@

osd() { # icon text percent
	command -v notify-send >/dev/null || return 0
	id=$(cat "$ID_FILE" 2>/dev/null); case "$id" in ''|*[!0-9]*) id=0;; esac
	new=$(notify-send -a Prestium -c prestium.osd -i "$1" -t 1500 -h string:x-canonical-private-synchronous:prestium-osd \
		-h "int:value:${3:-0}" -r "$id" -p "$2" 2>/dev/null) && echo "$new" > "$ID_FILE"
}

vol_pct() {
	if command -v wpctl >/dev/null; then
		wpctl get-volume "$1" 2>/dev/null | awk '{printf "%d", $2*100 + 0.5} / MUTED/{print " muted"}'
	else
		pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -1 | tr -d %
	fi
}

vol_icon() { # pct muted
	if [ -n "$2" ] || [ "$1" -eq 0 ]; then echo notification-audio-volume-muted
	elif [ "$1" -lt 34 ]; then echo notification-audio-volume-low
	elif [ "$1" -lt 67 ]; then echo notification-audio-volume-medium
	else echo notification-audio-volume-high; fi
}

show_volume() {
	set -- $(vol_pct $SINK)
	osd "$(vol_icon "${1:-0}" "$2")" "Volume ${1:-0} %${2:+ (muted)}" "${1:-0}"
}

case "$1" in
volume-up)
	if command -v wpctl >/dev/null; then wpctl set-mute $SINK 0; wpctl set-volume -l 1.5 $SINK 5%+
	else pactl set-sink-mute @DEFAULT_SINK@ 0; pactl set-sink-volume @DEFAULT_SINK@ +5%; fi
	show_volume ;;
volume-down)
	if command -v wpctl >/dev/null; then wpctl set-volume $SINK 5%-
	else pactl set-sink-volume @DEFAULT_SINK@ -5%; fi
	show_volume ;;
mute)
	if command -v wpctl >/dev/null; then wpctl set-mute $SINK toggle
	else pactl set-sink-mute @DEFAULT_SINK@ toggle; fi
	show_volume ;;
mic-mute)
	if command -v wpctl >/dev/null; then wpctl set-mute $SOURCE toggle
		m=$(wpctl get-volume $SOURCE 2>/dev/null | grep -c MUTED)
	else pactl set-source-mute @DEFAULT_SOURCE@ toggle
		m=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | grep -c yes); fi
	if [ "$m" = 1 ]; then osd notification-microphone-sensitivity-muted "Microphone muted" 0
	else osd notification-microphone-sensitivity-high "Microphone on" 100; fi ;;
brightness-up|brightness-down)
	command -v brightnessctl >/dev/null || exit 0
	if [ "$1" = brightness-up ]; then brightnessctl -q set 5%+; else brightnessctl -q --min-value=1 set 5%-; fi
	p=$(brightnessctl -m 2>/dev/null | head -1 | cut -d, -f4 | tr -d %)
	[ -n "$p" ] && osd notification-display-brightness "Brightness $p %" "$p" ;;
*)
	echo "usage: $0 volume-up|volume-down|mute|mic-mute|brightness-up|brightness-down" >&2; exit 2 ;;
esac
exit 0
