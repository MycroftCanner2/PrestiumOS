class Fail(Exception):
    pass


def _err(what):
    e = ctypes.get_errno()
    raise Fail("%s: %s" % (what, os.strerror(e)))


def mount(src, tgt, fstype, flags, data=None):
    b = lambda s: None if s is None else s.encode()  # noqa: E731
    if _libc.mount(b(src), b(tgt), b(fstype), flags, b(data)) != 0:
        _err("mount %s on %s" % (src or fstype, tgt))


def fdpath(fd):
    return "/proc/self/fd/%d" % fd


def safe_dir(path, uid, create=True):
    """A directory owned by uid, mode 0700, not a symlink (created if missing)."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        if not create:
            raise Fail("%s is missing" % path)
        os.mkdir(path, 0o700)
        st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid:
        raise Fail("%s is not a directory of user %d" % (path, uid))
    if stat.S_IMODE(st.st_mode) != 0o700:
        os.chmod(path, 0o700)
    return path


def mountpoint(path, is_dir):
    """Make sure path is an empty directory or a regular file, never a symlink (the app can write
    its runtime directory and /tmp and may have replaced one), and return an O_PATH fd on it."""
    try:
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode) or stat.S_ISDIR(st.st_mode) != is_dir \
                or (not is_dir and not stat.S_ISREG(st.st_mode)):
            if stat.S_ISDIR(st.st_mode) and not stat.S_ISLNK(st.st_mode):
                os.rmdir(path)
            else:
                os.unlink(path)
            raise FileNotFoundError
    except FileNotFoundError:
        if is_dir:
            os.mkdir(path, 0o700)
        else:
            os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
    return os.open(path, O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC)


MS_REMOUNT, MS_NOATIME, MS_NODIRATIME, MS_RELATIME = 32, 1024, 2048, 1 << 21


def remount_ro(path):
    """Read-only, keeping the mount's other flags: in a user namespace the kernel refuses a remount
    that would drop a flag the mount was given outside (nosuid, nodev, noexec, atime)."""
    f = os.statvfs(path).f_flag
    keep = f & (MS_NOSUID | MS_NODEV | MS_NOEXEC | MS_NOATIME | MS_NODIRATIME)
    if f & 4096:  # ST_RELATIME
        keep |= MS_RELATIME
    mount(None, path, None, MS_BIND | MS_REMOUNT | MS_RDONLY | keep)


def bind(src_fd, tgt_fd, ro=False, path=None):
    """Bind src onto the target fd (no symlink can redirect it). The read-only remount must name the
    new mount, so it goes by path, which now ends on that mount."""
    mount(fdpath(src_fd), fdpath(tgt_fd), None, MS_BIND)
    os.close(tgt_fd)
    if ro:
        remount_ro(path)


def open_src(path):
    try:
        return os.open(path, O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return None


def _forbidden(name):
    return any(name == f or (f.endswith(".") and name.startswith(f)) or name.startswith(f + ".")
               for f in FORBIDDEN)


def _read_fixed(path, limit=65536):
    """A root-owned file of the image that no one else can write (the policies are not the user's)."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise Fail("%s is not a root-owned file" % path)
        return os.read(fd, limit + 1).decode()
    finally:
        os.close(fd)


def parse_policy(policy, _depth=0):
    """POLICY_DIR/<policy>.policy (or .inc): a dict with "bus" (False: no session bus), the proxy's
    arguments, "documents", "env" and "own_if". Raises Fail on anything not allowed."""
    if not re.match(r"^[a-z0-9-]+$", policy or "") or _depth > 3:
        raise Fail("bad policy name %r" % policy)
    path = os.path.join(POLICY_DIR, policy + (".inc" if _depth else ".policy"))
    try:
        text = _read_fixed(path)
    except OSError as e:
        raise Fail("policy %s: %s" % (path, e.strerror))
    pol = {"bus": True, "args": [], "documents": False, "env": {}, "own_if": [], "none": False, "tray_items": False}
    for ln, line in enumerate(text.splitlines(), 1):
        w = line.split("#", 1)[0].split()
        if not w:
            continue
        where = "%s:%d" % (path, ln)
        d, rest = w[0], w[1:]
        if d == "bus" and rest == ["none"] and not _depth:
            pol["none"] = True
        elif d == "include" and len(rest) == 1:
            sub = parse_policy(rest[0], _depth + 1)
            for k in ("args", "own_if"):
                pol[k] += [x for x in sub[k] if x not in pol[k]]
            pol["documents"] |= sub["documents"]
            pol["tray_items"] |= sub["tray_items"]
            pol["env"].update(sub["env"])
        elif d in ("talk", "own") and len(rest) == 1:
            n = rest[0]
            if not NAME_RX.match(n) or (_forbidden(n) and not (d == "talk" and n in TALK_EXEMPT)):
                raise Fail("%s: %s %s is not allowed" % (where, d, n))
            if d == "talk" and n not in TALK_OK:
                raise Fail("%s: talk %s is not allowed (only %s)" % (where, n, ", ".join(TALK_OK)))
            # (and never the panel's tray names: the watcher, or another process's tray item; Qt 5's
            # own items come from "tray-items" only, for the application's process id)
            if d == "own" and (n.startswith("org.freedesktop.") or n.endswith(".*") and n.count(".") < 2
                               or n in TALK_OK or n.startswith("org.kde.StatusNotifier")):
                raise Fail("%s: own %s is not allowed" % (where, n))
            a = "--%s=%s" % (d, n)
            if a not in pol["args"]:
                pol["args"].append(a)
        elif d in ("call", "broadcast") and len(rest) == 2:
            if (d, rest[0], rest[1]) not in PORTAL_RULES:
                raise Fail("%s: %s %s %s is not allowed" % (where, d, rest[0], rest[1]))
            a = "--%s=%s=%s" % (d, rest[0], rest[1])
            if a not in pol["args"]:
                pol["args"].append(a)
        elif d == "documents" and not rest:
            pol["documents"] = True
        elif d == "tray-items" and not rest:
            pol["tray_items"] = True
        elif d == "env" and len(rest) == 1 and rest[0] in ENV_SETS:
            pol["env"].update(ENV_SETS[rest[0]])
        elif d == "own-if" and len(rest) == 2 and rest[0] in OWN_IF and rest[1] in OWN_IF[rest[0]]:
            if (rest[0], rest[1]) not in pol["own_if"]:
                pol["own_if"].append((rest[0], rest[1]))
        else:
            raise Fail("%s: unknown or malformed directive %r" % (where, line.strip()))
    if pol["none"]:
        if pol["args"] or pol["documents"] or pol["env"] or pol["own_if"] or pol["tray_items"]:
            raise Fail("%s: \"bus none\" and other directives" % path)
        pol["bus"] = False
    if pol["documents"] and not any(a.startswith("--call=%s=org.freedesktop.portal.FileChooser." % DESKTOP) for a in pol["args"]):
        raise Fail("%s: \"documents\" without the file chooser" % path)
    return pol


def own_if_holds(cond, uid):
    """Read from the user's home by the user's own fixed path (not $HOME); any doubt: no."""
    if cond != "keepassxc-secret-service":
        return False
    try:
        home = pwd.getpwuid(uid).pw_dir
        fd = os.open(os.path.join(home, ".config/keepassxc/keepassxc.ini"), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            text = os.read(fd, 1 << 20).decode(errors="replace")
        finally:
            os.close(fd)
    except (OSError, KeyError):
        return False
    sect = None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            sect = line[1:-1]
        elif sect == "FdoSecrets" and line.replace(" ", "").lower() == "enabled=true":
            return True
    return False


def app_id(policy):
    return APP_ID_PREFIX + policy.replace("-", "_")


MNT_DETACH = 2
_SYS_PIVOT_ROOT = {"x86_64": 155, "aarch64": 41, "i686": 217, "i386": 217, "armv7l": 218}


def _pivot_root(new, old):
    nr = _SYS_PIVOT_ROOT.get(platform.machine())
    if nr is None:
        raise Fail("pivot_root: unknown architecture %s" % platform.machine())
    if _libc.syscall(ctypes.c_long(nr), ctypes.c_char_p(new.encode()), ctypes.c_char_p(old.encode())) != 0:
        _err("pivot_root")


def proxy_root(uid, rt_base, info):
    """In the proxy's child, before exec: a new user and mount namespace whose root is a small tmpfs
    with /usr, /etc (read-only), the session bus socket, app-confine's socket directory and a
    /.flatpak-info naming the application. The desktop portal reads that file through
    /proc/<proxy pid>/root (the bus tells it the proxy's pid, not the application's), so it treats
    the caller as a sandboxed application with that id: the file chooser hands it the picked file
    through the document portal instead of a path, and its permissions are per application. The
    application's own namespace has no /.flatpak-info (GLib, GTK and Qt would change behaviour)."""
    run = "%s/%d" % (RUN_USER, uid)
    gid = os.getgid()
    if _libc.unshare(CLONE_NEWUSER | CLONE_NEWNS) != 0:
        _err("unshare")
    with open("/proc/self/setgroups", "w") as f:
        f.write("deny")
    with open("/proc/self/uid_map", "w") as f:
        f.write("%d %d 1" % (uid, uid))
    with open("/proc/self/gid_map", "w") as f:
        f.write("%d %d 1" % (gid, gid))
    mount(None, "/", None, MS_REC | MS_PRIVATE)
    srcs = {"bus": open_src(os.path.join(run, "bus")), "base": open_src(rt_base)}
    if srcs["bus"] is None or srcs["base"] is None:
        raise Fail("the session bus or %s is missing" % rt_base)
    R = TMP  # any directory: in this namespace only, it becomes the new root
    mount("tmpfs", R, "tmpfs", MS_NOSUID | MS_NODEV, "mode=0755,size=1m")
    for d in ("usr", "etc"):
        os.mkdir(os.path.join(R, d), 0o755)
        mount("/" + d, os.path.join(R, d), None, MS_BIND | MS_REC)
        remount_ro(os.path.join(R, d))
    for d in ("bin", "sbin", "lib", "lib64", "lib32", "libx32"):
        if os.path.islink("/" + d):
            os.symlink(os.readlink("/" + d), os.path.join(R, d))
        elif os.path.isdir("/" + d):
            os.mkdir(os.path.join(R, d), 0o755)
            mount("/" + d, os.path.join(R, d), None, MS_BIND | MS_REC)
            remount_ro(os.path.join(R, d))
    os.makedirs(R + run, 0o755)
    os.makedirs(R + rt_base, 0o700)
    bind(srcs["base"], os.open(R + rt_base, O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC))
    os.close(os.open(R + run + "/bus", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
    bind(srcs["bus"], os.open(R + run + "/bus", O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC))
    fd = os.open(os.path.join(R, ".flatpak-info"), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o444)
    os.write(fd, info.encode())
    os.close(fd)
    os.chdir(R)
    _pivot_root(".", ".")
    if _libc.umount2(b".", MNT_DETACH) != 0:
        _err("umount the old root")
    os.chdir("/")
    remount_ro("/")


def proxy_sock(rt_base, group):
    return os.path.join(rt_base, ".bus-%s-%d" % (group, os.getpid()))


def start_proxy(uid, rt_base, group, pol, aid, instance, app_pid):
    """xdg-dbus-proxy on a socket outside the app's view, in its own namespace (proxy_root); returns
    (socket path, read end of its sync pipe). The proxy exits when that read end is closed (this
    supervisor exits). app_pid: the application's process id (its tray icons' names)."""
    sock = proxy_sock(rt_base, group)
    try:
        os.unlink(sock)
    except FileNotFoundError:
        pass
    args = list(pol["args"])
    for cond, n in pol["own_if"]:
        if own_if_holds(cond, uid):
            args.append("--own=%s" % n)
    if pol["tray_items"]:
        args += ["--own=" + TRAY_ITEM % (app_pid, i) for i in range(1, TRAY_ITEMS + 1)]
    info = "[Application]\nname=%s\n\n[Instance]\ninstance-id=%s\n" % (aid, instance)
    r, w = os.pipe()
    er, ew = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.close(r)
            os.close(er)
            proxy_root(uid, rt_base, info)
            os.set_inheritable(w, True)
            os.execve(PROXY, [PROXY, "--fd=%d" % w, "unix:path=%s/%d/bus" % (RUN_USER, uid), sock, "--filter"] + args,
                      {"PATH": "/usr/bin:/bin"})
        except (Fail, OSError) as e:
            try:
                os.write(ew, str(e).encode()[:900] or b"failed")
            except OSError:
                pass
        os._exit(127)
    os.close(w)
    os.close(ew)
    ready, _, _ = select.select([r], [], [], 10)
    ok = bool(ready) and os.read(r, 1) == b"x"
    if not ok:
        err = b""
        try:
            if select.select([er], [], [], 0)[0]:
                err = os.read(er, 1024)
        except OSError:
            pass
        os.close(er)
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
        os.waitpid(pid, 0)
        raise Fail("the D-Bus filter (xdg-dbus-proxy) did not start%s" % (": " + err.decode(errors="replace") if err else ""))
    os.close(er)
    return sock, r, pid


def start_documents(uid):
    """Start the document portal (D-Bus activation) so its FUSE view exists before the mounts."""
    if not os.path.exists(DBUS_SEND):
        return
    try:
        subprocess.run([DBUS_SEND, "--session", "--print-reply", "--reply-timeout=5000",
                        "--dest=" + DOCUMENTS, "/org/freedesktop/portal/documents",
                        DOCUMENTS + ".GetMountPoint"], timeout=10, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       env={"PATH": "/usr/bin:/bin", "DBUS_SESSION_BUS_ADDRESS": "unix:path=%s/%d/bus" % (RUN_USER, uid)})
    except (OSError, subprocess.SubprocessError):
        pass


def link_host_bus(run):
    """Compatibility audit: in an application's view $XDG_RUNTIME_DIR/prestium-bus is its D-Bus filter,
    and DBUS_SESSION_BUS_ADDRESS names it. gpg hands that address to the session's gpg-agent (socket
    started by systemd, outside every namespace) for the pinentry it starts there, which then reached no
    bus and failed: no passphrase prompt for Claws Mail or Kleopatra. Outside the namespaces the same
    name is a link to the session bus, so that pinentry gets the session's bus, as before app-confine.
    The applications never see it (their /run/user/<uid> is their group's own directory)."""
    p = os.path.join(run, "prestium-bus")
    try:
        if os.readlink(p) == "bus":
            return
    except OSError:
        pass
    try:
        if os.path.isdir(p) and not os.path.islink(p):
            os.rmdir(p)
        elif os.path.lexists(p):
            os.unlink(p)
        os.symlink("bus", p)
    except OSError as e:
        sys.stderr.write("app-confine: %s: %s (GnuPG's passphrase prompt may fail)\n" % (p, e))


def write_instance(uid, instance, child_pid):
    """$XDG_RUNTIME_DIR/.flatpak/<instance>/bwrapinfo.json: the portal finds the application's own
    process (its namespaces) through it. Returns the directory (removed when the app exits)."""
    run = "%s/%d" % (RUN_USER, uid)
    d = safe_dir(os.path.join(run, ".flatpak"), uid)
    d = safe_dir(os.path.join(d, instance), uid)
    fd = os.open(os.path.join(d, "bwrapinfo.json"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    os.write(fd, json.dumps({"child-pid": child_pid}).encode())
    os.close(fd)
    return d


def remove_instance(d):
    try:
        os.unlink(os.path.join(d, "bwrapinfo.json"))
        os.rmdir(d)
    except OSError:
        pass


def setup(name, uid, gid, rt, ptmp, proxy_sock, gnupg, doc_app=None):
    """In the child: new user and mount namespace, then the mounts. Raises Fail."""
    if _libc.unshare(CLONE_NEWUSER | CLONE_NEWNS) != 0:
        _err("unshare")
    with open("/proc/self/setgroups", "w") as f:
        f.write("deny")
    with open("/proc/self/uid_map", "w") as f:
        f.write("%d %d 1" % (uid, uid))
    with open("/proc/self/gid_map", "w") as f:
        f.write("%d %d 1" % (gid, gid))
    # slave, not private (compatibility audit): what the host mounts later (a USB stick, an unlocked
    # VeraCrypt or LUKS volume under /media) still appears in a running application, as it did before
    # app-confine; nothing mounted in here goes back out. A host mount under a path covered below
    # (/run/user/<uid>, /tmp, /run/dbus, /run/prestium-wl) lands under the cover, out of sight.
    mount(None, "/", None, MS_REC | MS_SLAVE)
    run = "%s/%d" % (RUN_USER, uid)
    # sources, opened in this namespace before anything covers them
    src = {n: open_src(os.path.join(run, n)) for n in RT_BINDS}
    if gnupg == "shared":
        src["gnupg"] = open_src(os.path.join(run, "gnupg"))
    wl = open_src("%s/%d" % (WL_BASE, uid))
    x11 = open_src(os.path.join(TMP, ".X11-unix"))
    rt_fd = os.open(rt, O_PATH | os.O_NOFOLLOW | os.O_DIRECTORY | os.O_CLOEXEC)
    tmp_fd = os.open(ptmp, O_PATH | os.O_NOFOLLOW | os.O_DIRECTORY | os.O_CLOEXEC)
    bus_fd = open_src(proxy_sock) if proxy_sock else None
    # the document portal's view for this application only (its FUSE file system checks the
    # caller's user id, which the identity map keeps)
    doc_fd = open_src(os.path.join(run, "doc", "by-app", doc_app)) if doc_app else None
    if doc_app and doc_fd is None:
        sys.stderr.write("app-confine: no document portal; the file chooser can't hand files over\n")
    if proxy_sock and bus_fd is None:
        raise Fail("the D-Bus filter's socket is missing")

    # /run/user/<uid>: the group's runtime directory
    mount(fdpath(rt_fd), run, None, MS_BIND)
    for n, fd in src.items():
        if fd is None:
            continue
        is_dir = stat.S_ISDIR(os.fstat(fd).st_mode)
        bind(fd, mountpoint(os.path.join(run, n), is_dir))
    if gnupg == "shared" and src.get("gnupg") is None:
        raise Fail("%s/gnupg is missing" % run)
    for n in ("bus", "prestium-bus"):  # never a stale or planted socket of the app's own
        p = os.path.join(run, n)
        if os.path.lexists(p) and not (n == "prestium-bus" and bus_fd is not None):
            if os.path.isdir(p) and not os.path.islink(p):
                os.rmdir(p)
            else:
                os.unlink(p)
    if bus_fd is not None:
        bind(bus_fd, mountpoint(os.path.join(run, "prestium-bus"), False))
    p = os.path.join(run, "doc")
    if doc_fd is not None:
        bind(doc_fd, mountpoint(p, True))
    elif os.path.lexists(p):  # never a planted directory or link where the portal's files would be
        if os.path.isdir(p) and not os.path.islink(p):
            os.rmdir(p)
        else:
            os.unlink(p)
    with open(os.path.join(run, ".prestium-confined"), "w") as f:
        f.write(name + "\n")

    # no system bus, no broker
    if os.path.isdir(SYSBUS_DIR):
        mount("tmpfs", SYSBUS_DIR, "tmpfs", MS_NOSUID | MS_NODEV | MS_NOEXEC, "mode=0755,size=16k")
    if os.path.isdir(WL_BASE):
        mount("tmpfs", WL_BASE, "tmpfs", MS_NOSUID | MS_NODEV | MS_NOEXEC, "mode=0755,size=16k")
        if wl is not None:
            os.mkdir("%s/%d" % (WL_BASE, uid), 0o755)
            t = os.open("%s/%d" % (WL_BASE, uid), O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC)
            bind(wl, t, ro=True, path="%s/%d" % (WL_BASE, uid))
        remount_ro(WL_BASE)

    # /tmp and /dev/shm
    mount(fdpath(tmp_fd), TMP, None, MS_BIND)
    if x11 is not None:
        bind(x11, mountpoint(os.path.join(TMP, ".X11-unix"), True), ro=True, path=os.path.join(TMP, ".X11-unix"))
    if os.path.isdir(SHM):
        mount("tmpfs", SHM, "tmpfs", MS_NOSUID | MS_NODEV, "mode=1777")
    for fd in list(src.values()) + [wl, x11, rt_fd, tmp_fd, bus_fd, doc_fd]:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def environment(uid, has_bus, extra=None):
    env = dict(os.environ)
    run = "%s/%d" % (RUN_USER, uid)
    for k in ("DBUS_SYSTEM_BUS_ADDRESS", "AT_SPI_BUS_ADDRESS", "SESSION_MANAGER", "TMPDIR",
              "GNOME_KEYRING_CONTROL", "SSH_AUTH_SOCK", "GPG_AGENT_INFO", "LD_PRELOAD",
              "LD_LIBRARY_PATH", "PYTHONPATH", "PYTHONHOME", "PYTHONSTARTUP"):
        env.pop(k, None)
    env["XDG_RUNTIME_DIR"] = run
    # no session bus: an address that does not exist, so nothing autolaunches one
    env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=%s/%s" % (run, "prestium-bus" if has_bus else "no-bus")
    s = "%s/%d/apps" % (WL_BASE, uid)
    if os.path.exists(s):
        env["WAYLAND_DISPLAY"] = s
    else:  # as prestium-run: no Wayland at all, Xwayland only
        env.update(WAYLAND_DISPLAY="prestium-no-wayland", GDK_BACKEND="x11", QT_QPA_PLATFORM="xcb",
                   MOZ_ENABLE_WAYLAND="0")
    env["PYTHONNOUSERSITE"] = "1"
    env["PRESTIUM_CONFINED"] = "1"
    if has_bus:
        env.update(extra or {})
    return env


def notify_fail(msg):
    sys.stderr.write("app-confine: %s\n" % msg)
    try:
        subprocess.run(["/usr/bin/notify-send", "-a", "Prestium", "-u", "critical", "-i", "dialog-error",
                        "Application not started", msg], timeout=5, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def check_all():
    """Every application's policy parses (hook 0625 runs this at build time)."""
    bad = 0
    for n in sorted(APPS):
        try:
            pol = parse_policy(APPS[n][2])
            print("%s %s %s" % (n, APPS[n][2], " ".join(pol["args"]) if pol["bus"] else "no-bus"))
        except Fail as e:
            print("E: %s: %s" % (n, e))
            bad = 1
    return bad


def main(argv):
    if len(argv) == 2 and argv[1] == "--list":
        for n in sorted(APPS):
            print(n, APPS[n][0])
        return 0
    if len(argv) == 2 and argv[1] == "--check":
        return check_all()
    if len(argv) < 2 or argv[1] not in APPS:
        sys.stderr.write("usage: app-confine NAME [ARGS...] | --list | --check\n")
        return 2
    name, args = argv[1], argv[2:]
    prog, group, policy, gnupg = APPS[name]
    uid, gid = os.getuid(), os.getgid()
    run = "%s/%d" % (RUN_USER, uid)
    inst_dir = None
    sock = None
    try:
        pol = parse_policy(policy)
        # already confined (an app of a confined group starting another): its mounts already apply
        if os.path.exists(os.path.join(run, ".prestium-confined")) and not os.path.exists("%s/broker" % WL_BASE):
            has = os.path.exists(os.path.join(run, "prestium-bus"))
            os.execve(prog, [prog] + args, environment(uid, has, pol["env"]))
        if uid == 0:
            raise Fail("not as root")
        safe_dir(run, uid, create=False)
        link_host_bus(run)
        base = safe_dir(os.path.join(run, "prestium-confine"), uid)
        rt = safe_dir(os.path.join(base, group), uid)
        tbase = safe_dir(os.path.join(TMP, ".prestium-confine-%d" % uid), uid)
        ptmp = safe_dir(os.path.join(tbase, group), uid)
        if name in JOIN:
            rel, ns_helper, real = JOIN[name]
            js = os.path.join(rt, rel)
            try:
                is_sock = stat.S_ISSOCK(os.lstat(js).st_mode)
            except OSError:
                is_sock = False
            if is_sock and subprocess.run([ns_helper, "check", js], stdin=subprocess.DEVNULL,
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                          env={"PATH": "/usr/bin:/bin"}).returncode == 0:
                os.execve(ns_helper, [ns_helper, "join", js, "--", real] + args, environment(uid, False))
        aid = app_id(policy)
        instance = "prestium-%s-%d" % (group, os.getpid())
        if pol["bus"]:
            if not os.path.exists(os.path.join(run, "bus")):
                raise Fail("no session bus")
            if pol["documents"]:
                start_documents(uid)
            sock = proxy_sock(base, group)
        env = environment(uid, sock is not None, pol["env"])
        r, w = os.pipe()
        gr, gw = os.pipe()
        pr, pw = os.pipe()
        pid = os.fork()
        if pid == 0:
            os.close(r)
            os.close(gw)
            os.close(pw)
            # wait for the D-Bus filter (started for this process id, see TRAY_ITEM)
            if os.read(pr, 1) != b"p":
                os._exit(127)
            os.close(pr)
            try:
                try:
                    cwd = os.getcwd()
                except OSError:
                    cwd = "/"
                setup(name, uid, gid, rt, ptmp, sock, gnupg, aid if pol["documents"] else None)
                # look the working directory up again: the old one could be in the host's /tmp
                try:
                    os.chdir(cwd)
                except OSError:
                    os.chdir(os.environ.get("HOME") or "/")
            except (Fail, OSError) as e:
                os.write(w, str(e).encode()[:900] or b"setup failed")
                os._exit(127)
            os.close(w)  # close-on-exec would do; an empty read means "set up"
            # wait until the portal can find this process (bwrapinfo.json), then run the application
            if os.read(gr, 1) != b"g":
                os._exit(127)
            os.close(gr)
            try:
                os.execve(prog, [prog] + args, env)
            except OSError:
                os._exit(127)
        os.close(w)
        os.close(gr)
        os.close(pr)
        try:
            if sock:
                sock, _sync, _ppid = start_proxy(uid, base, group, pol, aid, instance, pid)
            os.write(pw, b"p")
        except (Fail, OSError):
            os.close(pw)
            os.close(r)
            os.close(gw)
            os.waitpid(pid, 0)
            raise
        os.close(pw)
        err = b""
        while True:
            c = os.read(r, 1024)
            if not c:
                break
            err += c
        os.close(r)
        if err:
            os.close(gw)
            os.waitpid(pid, 0)
            raise Fail(err.decode(errors="replace"))
        if sock:
            inst_dir = write_instance(uid, instance, pid)
        os.write(gw, b"g")
        os.close(gw)
        for s_ in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(s_, lambda n, _f: os.kill(pid, n))
        while True:
            try:
                _, status = os.waitpid(pid, 0)
                break
            except InterruptedError:
                continue
        return os.waitstatus_to_exitcode(status) if status else 0
    except (Fail, OSError) as e:
        notify_fail("%s was not started: %s" % (name, e))
        return 1
    finally:
        if inst_dir:
            remove_instance(inst_dir)
        if sock:
            try:
                os.unlink(sock)
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(main(sys.argv))
