# Prestium 2.1: the kernel command line this image boots with, and nothing else. Read by
# /usr/share/prestium/boot/cmdline-guard.sh in the initramfs (before anything else reads the command
# line), by prestium-cmdline-check.service (before AppArmor loads), by prestium-safety-notify, and at
# build time by hook 9030, which checks every boot entry against it.
#   require TOKEN   must be there exactly once
#   allow TOKEN     may be there, at most once
# <hex64>: 64 lowercase hex digits (the dm-verity root hash, written by hook 9010 at build time).
# <live-kernel>, <live-initrd>: what GRUB and isolinux add themselves (BOOT_IMAGE=/live/vmlinuz-...,
# isolinux also initrd=/live/initrd.img-...).
# The require lines up to security=apparmor are auto/config's APPEND without "quiet splash", in order;
# tests/test_boot_cmdline_guard.sh and hook 9030 stop the build when the two differ.
require boot=live
require loop.max_loop=64
require modprobe.blacklist=ahci
require modprobe.blacklist=libahci
require modprobe.blacklist=libata
require modprobe.blacklist=nvme
require systemd.gpt_auto=0
require noprompt
require block.events_dfl_poll_msecs=1000
require slab_nomerge
require slub_debug=FZP
require mce=0
require vsyscall=none
require page_poison=1
require init_on_alloc=1
require init_on_free=1
require page_alloc.shuffle=1
require randomize_kstack_offset=on
require pti=on
require mds=full,nosmt
require spec_store_bypass_disable=on
require debugfs=off
require intel_iommu=on
require amd_iommu=force_isolation
require iommu=force
require iommu.strict=1
require efi=disable_early_pci_dma
require module.sig_enforce=1
require apparmor=1
require security=apparmor
# hook 9010 (dm-verity, no initramfs shell)
require dm-verity-root-hash=filesystem.squashfs:<hex64>
require dm-verity-oncorruption=panic
require panic=10
# auto/config: quiet splash (the "Verify integrity" entry drops both)
allow quiet
allow splash
# the other boot entries: nomodeset, camera and microphone off, MAC spoofing off, Verify integrity
allow nomodeset
allow prestium.nocammic
allow nomacspoof
allow verify-checksums
# plain toram (copy the verified image to memory); only by editing an entry with the GRUB superuser
allow toram
# added by the boot loader
allow BOOT_IMAGE=<live-kernel>
allow initrd=<live-initrd>
