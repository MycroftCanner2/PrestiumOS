# Prestium 2.1: labwc window theme in GNOME's dark Adwaita colours, to match GTK (Adwaita-dark),
# Qt (adwaita-qt, Adwaita-Dark), waybar and mako. No button images: labwc draws its own.
border.width: 1
padding.width: 8
padding.height: 6
titlebar.height: 32
window.button.width: 28
window.button.spacing: 4
window.label.text.justify: center
window.active.title.bg.color: #303030
window.inactive.title.bg.color: #242424
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #9a9a9a
window.active.border.color: #3584e4
window.inactive.border.color: #1e1e1e
window.active.title.separator.color: #303030
window.inactive.title.separator.color: #242424
window.active.button.unpressed.image.color: #ffffff
window.inactive.button.unpressed.image.color: #9a9a9a
window.active.button.close.hover.image.color: #ff7b63
window.active.shadow.size: 14
window.inactive.shadow.size: 8
window.active.shadow.color: #00000080
window.inactive.shadow.color: #00000050
menu.overlap.x: 0
menu.width.min: 200
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.items.bg.color: #383838
menu.items.text.color: #ffffff
menu.items.active.bg.color: #3584e4
menu.items.active.text.color: #ffffff
menu.separator.color: #4a4a4a
menu.separator.padding.height: 4
menu.border.width: 1
menu.border.color: #1e1e1e
osd.bg.color: #303030
osd.border.color: #3584e4
osd.border.width: 1
osd.label.text.color: #ffffff
osd.window-switcher.item.active.border.color: #3584e4
osd.window-switcher.preview.border.color: #3584e4
