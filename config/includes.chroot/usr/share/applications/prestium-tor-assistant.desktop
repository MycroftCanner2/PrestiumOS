[Desktop Entry]
Type=Application
Name=Tor Connection Assistant
Comment=Show Tor's connection status and choose Direct, Snowflake, WebTunnel, obfs4 or meek
Exec=/usr/local/bin/prestium-tor-assistant
Icon=network-wired
Terminal=false
StartupNotify=true
# 2.1: the window's app_id, so the panel finds this file's name and icon
StartupWMClass=org.prestium.TorConnectionAssistant
Categories=Network;
