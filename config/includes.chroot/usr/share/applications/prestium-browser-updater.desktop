[Desktop Entry]
Type=Application
Name=Browser Updater
Comment=Install the latest publisher-signed Tor Browser or I2P Browser (LibreWolf) for this session
Exec=/usr/local/bin/prestium-browser-updater
Icon=system-software-update
Terminal=false
StartupNotify=true
# 2.1: the window's app_id, so the panel finds this file's name and icon
StartupWMClass=org.prestium.BrowserUpdater
Categories=Network;
