# Prestium 2.1 (design batch): KDE colour scheme in the Tech Innovation colours (dark grey,
# Electric Blue #0066ff selection, Neon Cyan #00ffff links), the same palette as GTK, Kvantum and labwc.
# 2.1 (contrast review): selection #0050c8 (white text 7.0:1), focus #3d8bff, accent text #8ab8ff and
# error text #ff9494 (both 7:1 or more), coloured text on the selection 4.5:1 or more (test_contrast.py).
# Kleopatra picks it by default (/etc/xdg/kleopatrarc); its Settings, Color Scheme menu lists it as "Prestium".
[General]
ColorScheme=Prestium
Name=Prestium

[ColorEffects:Disabled]
Color=30,30,30
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Enable=false

