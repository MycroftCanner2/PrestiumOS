# Prestium 2.1 (design batch): KDE colour scheme in Adwaita light colours (light grey windows,
# white views, dark text, Electric Blue #3584e4 selection), matching GTK, Qt and labwc.
# 2.1 (contrast review): normal text 11:1 or more, links #1a5fb4 (4.5:1 or more), selection white
# text 3.7:1 (bold selected-row pairing, as GTK and Qt), errors #c01c28 (test_contrast.py).
# Kleopatra picks it by default (/etc/xdg/kleopatrarc); its Settings, Color Scheme menu lists it as "Prestium".
# 2.1 (UI pass): tooltips stay dark, as Adwaita's are. /etc/xdg/kdeglobals carries
# the same [Colors:*] sections (tests/test_ui_consistency.py keeps the two identical).
# 2.1: links (ForegroundLink) are #1a5fb4, Adwaita's blue, matching GTK and Qt.
[General]
ColorScheme=Prestium
Name=Prestium

[ColorEffects:Disabled]
Color=246,245,244
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Enable=false

