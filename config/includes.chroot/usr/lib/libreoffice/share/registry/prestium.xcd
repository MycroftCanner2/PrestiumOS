<?xml version="1.0" encoding="UTF-8"?>
<!-- Prestium 2.1 (review of 6bf1234): LibreOffice defaults that match its AppArmor profile
     (/etc/apparmor.d/usr.lib.libreoffice.program), which lets it write only ~/Documents/LibreOffice.
     Work: the default folder of Open and Save As. UseLocking=false: no ".~lock.<name>#" file next to
     a document (it could be written only in its own folder; Prestium is single-user).
     2.1 (UI pass): SymbolStyle colibre_dark: the dark variant of the shipped Colibre icons
     (libreoffice-style-colibre has both), so the toolbars match the dark GTK theme LibreOffice draws with. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <prop oor:name="UseLocking" oor:op="fuse">
        <value>false</value>
      </prop>
      <prop oor:name="SymbolStyle" oor:op="fuse">
        <value>colibre_dark</value>
      </prop>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Paths" oor:package="org.openoffice.Office">
    <node oor:name="Paths">
      <node oor:name="Work" oor:op="fuse">
        <prop oor:name="WritePath" oor:op="fuse">
          <value>file:///home/user/Documents/LibreOffice</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
