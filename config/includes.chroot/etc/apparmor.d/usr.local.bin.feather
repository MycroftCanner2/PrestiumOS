# Prestium 2.0 r9: Feather (Monero wallet, I2P-only settings), ENFORCED.
# 2.1: network is I2P: settings.json "proxy": 2 (Feather's i2p mode) through i2pd's SOCKS proxy
# 127.0.0.1:4447, the port in i2pd.conf [socksproxy]; the menu says I2P too. Feather starts no Tor of its
# own in that mode and may execute no program (no x rules). It may map (m) its unpacked Qt runtime
# in /tmp, which is why the /tmp rule below carries m; m is not exec. AppArmor can't limit ports; ferm limits "user".
# Feather may use its own settings and wallet directories. No other files in $HOME, no sudo, no
# Prestium helpers, no Tor control socket, no system bus. Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile feather /usr/local/bin/feather {
  include <abstractions/prestium-app-base>
  include <abstractions/nameservice>

  network inet stream,
  network inet6 stream,
  network unix stream,
  network netlink raw,

  /usr/local/bin/feather mr,
  # some Feather builds unpack their Qt runtime to a temporary directory
  owner /tmp/** mrwk,

  owner @{HOME}/.config/feather/ rw,
  # 2.1 (wallet fix): Qt saves settings.json with QSaveFile: an O_TMPFILE in this folder, linked in
  # with linkat (AppArmor names the unlinked file "#<inode>"), then renamed over settings.json. Without
  # l every save failed (operation="link" target=".../.config/feather/#<inode>"), so nothing Feather
  # remembers (recent wallets, node, settings) was ever written.
  owner @{HOME}/.config/feather/** rwkl,
  owner @{HOME}/.local/share/feather/ rw,
  owner @{HOME}/.local/share/feather/** rwk,
  owner @{HOME}/.cache/feather/** rwk,
  owner @{HOME}/Monero/ rw,
  owner @{HOME}/Monero/** rwk,
  # 2.1 (wallet fix): Monero's shared ring database (lmdb), which remembers the ring members of each
  # spend so that a re-spend of the same output reuses the same ring. Without it, opening a wallet failed
  # to create ~/.shared-ringdb and lmdb then tried ~/lock.mdb (both denied).
  owner @{HOME}/.shared-ringdb/ rw,
  owner @{HOME}/.shared-ringdb/** rwk,
  owner @{HOME}/Documents/ r,
  owner @{HOME}/Documents/** rwk,

  include if exists <local/usr.local.bin.feather>
}
