# Prestium 2.0 r9: Feather (Monero wallet, I2P-only settings), ENFORCED.
# 2.1: network is I2P: settings.json "proxy": 2 (Feather's i2p mode) through i2pd's SOCKS proxy
# 127.0.0.1:4447, the port in i2pd.conf [socksproxy]; the menu says I2P too. Feather starts no Tor of its
# own in that mode and may execute nothing (no x rules). AppArmor can't limit ports; ferm limits "user".
# Feather may use its own settings and wallet directories. No other files in $HOME, no sudo, no
# Prestium helpers, no Tor control socket, no system bus. Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile feather /usr/local/bin/feather {
  include <abstractions/prestium-app-base>
  include <abstractions/nameservice>

  network inet stream,
  network inet6 stream,
  network unix stream,
  network netlink raw,

  /usr/local/bin/feather mr,
  # some Feather builds unpack their Qt runtime to a temporary directory
  owner /tmp/** mrwk,

  owner @{HOME}/.config/feather/ rw,
  owner @{HOME}/.config/feather/** rwk,
  owner @{HOME}/.local/share/feather/ rw,
  owner @{HOME}/.local/share/feather/** rwk,
  owner @{HOME}/.cache/feather/** rwk,
  owner @{HOME}/Monero/ rw,
  owner @{HOME}/Monero/** rwk,
  owner @{HOME}/Documents/ r,
  owner @{HOME}/Documents/** rwk,

  include if exists <local/usr.local.bin.feather>
}
