# Prestium 2.1 (audit of 96468c5, M-1): mat2, the metadata cleaner (command line), ENFORCED. No network, no other app's data, no keys;
# reads the file folders and writes only "<name>.cleaned.<ext>" in the "Remove metadata" work folder,
# ~/Documents/.remove-metadata.XXXXXX (a hidden folder in the shared ~/Documents)
# (2.1, review of 6bf1234: not in other apps' folders; the file manager's "Remove metadata" copies the file there,
# runs mat2 and moves the cleaned copy back itself, see /usr/local/bin/prestium-remove-metadata).
# Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile mat2 /usr/bin/mat2 {
  include <abstractions/prestium-viewer>
  include <abstractions/prestium-viewer-write>
  /usr/bin/mat2 r,
  include <abstractions/python>
  /usr/bin/python3* ix,
  /usr/lib/python3/** mr,
  /usr/lib/python3.*/** mr,
  # mat2's helpers (videos, other formats), each run by mat2 in bubblewrap when it is installed
  /usr/bin/{ffmpeg,exiftool,perl} mrix,
  /usr/share/perl5/** r,
  /usr/share/perl/** r,
  /usr/lib/@{multiarch}/perl*/** mr,
  /usr/bin/bwrap mrCx -> bwrap,
  # the cleaned copy "<name>.cleaned.<ext>", only in its own folder (shared with Metadata Cleaner, the
  # same engine); it never changes an original or any other file
  owner "@{HOME}/Documents/.remove-metadata*/**.cleaned.*" rw,

  profile bwrap flags=(attach_disconnected,mediate_deleted) {
    include <abstractions/prestium-viewer-bwrap>
    /usr/bin/{ffmpeg,exiftool,perl} mrix,
    /usr/share/perl5/** r,
    /usr/lib/@{multiarch}/perl*/** mr,
    # 2.1 (review of 7242e00): mat2 mounts an empty temporary directory over the file's folder and
    # ffmpeg or exiftool writes "<name>.cleaned.<ext>" there; mat2 then copies it next to the file.
    # Inside the sandbox that write has the file folder's path. Only that name, only in its own folder.
    owner "@{HOME}/Documents/.remove-metadata*/**.cleaned.*" w,
  }
  include if exists <local/usr.bin.mat2>
}
