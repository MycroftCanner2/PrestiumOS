# Prestium 2.1 (audit of 96468c5, M-1): Loupe, the default image viewer, ENFORCED. A crafted image gets no network, no other
# app's data and no keys; it may read the file folders. Its decoders (glycin) run in their own
# bubblewrap sandbox, here in the child profile "bwrap". Replaces Debian's unconfined "loupe" profile.
# Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile loupe /usr/bin/loupe {
  include <abstractions/prestium-viewer>
  /usr/bin/loupe mr,
  # 2.1 (review of 7242e00): glycin lists / to find /lib64 and the other lib symlinks it recreates in
  # the decoders' sandbox; without them no decoder can start and no image opens. (Names only.)
  / r,
  owner @{HOME}/.config/loupe/ rw,
  owner @{HOME}/.config/loupe/** rwk,
  owner @{HOME}/.cache/loupe/ rw,
  owner @{HOME}/.cache/loupe/** rwk,
  # rotate and save, "set as background" are not offered here: no writes in the folders
  /usr/bin/bwrap mrCx -> bwrap,

  profile bwrap flags=(attach_disconnected,mediate_deleted) {
    include <abstractions/prestium-viewer-bwrap>
    /usr/libexec/glycin-loaders/** mrix,
    deny @{HOME}/** w,
    # the SVG decoder's fontconfig: the font caches glycin binds in, read-only
    /var/cache/fontconfig/ r,
    /var/cache/fontconfig/** mr,
    owner @{HOME}/.cache/fontconfig/ r,
    owner @{HOME}/.cache/fontconfig/** mr,
  }
  include if exists <local/usr.bin.loupe>
}
