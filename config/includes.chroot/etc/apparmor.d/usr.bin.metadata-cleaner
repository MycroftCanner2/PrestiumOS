# Prestium 2.1 (audit of 96468c5, M-1): Metadata Cleaner (the GUI for mat2), ENFORCED. The same rules as mat2,
# except where it writes (its own folder, L-5).
# Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile metadata-cleaner /usr/bin/metadata-cleaner {
  include <abstractions/prestium-viewer>
  include <abstractions/prestium-viewer-write>
  /usr/bin/metadata-cleaner r,
  /usr/share/metadata-cleaner/** r,
  owner @{HOME}/.config/metadata-cleaner/ rw,
  owner @{HOME}/.config/metadata-cleaner/** rwk,
  include <abstractions/python>
  /usr/bin/python3* ix,
  /usr/lib/python3/** mr,
  /usr/lib/python3.*/** mr,
  # mat2's helpers (videos, other formats), each run by mat2 in bubblewrap when it is installed
  /usr/bin/{ffmpeg,exiftool,perl} mrix,
  /usr/share/perl5/** r,
  /usr/share/perl/** r,
  /usr/lib/@{multiarch}/perl*/** mr,
  /usr/bin/bwrap mrCx -> bwrap,
  # 2.1 (L-5): Metadata Cleaner replaces the files it cleans, so it may write only its own folder,
  # ~/Documents/Metadata Cleaner: copy a file there to clean it in place. (For a file anywhere else,
  # "Remove metadata" in the file manager runs mat2, which writes a cleaned copy next to it.) It still
  # reads every file folder, but can't change a file another app wrote or will open.
  owner "@{HOME}/Documents/Metadata Cleaner/" rw,
  owner "@{HOME}/Documents/Metadata Cleaner/**" rwk,

  profile bwrap flags=(attach_disconnected,mediate_deleted) {
    include <abstractions/prestium-viewer-bwrap>
    # (Metadata Cleaner has mat2 write the cleaned copy to /tmp, then moves it itself)
    deny @{HOME}/** w,
    /usr/bin/{ffmpeg,exiftool,perl} mrix,
    /usr/share/perl5/** r,
    /usr/lib/@{multiarch}/perl*/** mr,
  }
  include if exists <local/usr.bin.metadata-cleaner>
}
