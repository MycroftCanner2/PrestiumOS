# Prestium 2.1 (review of the security audit): the GnuPG passphrase prompt when Claws Mail's own
# gpg-agent starts it (normally the session's agent does). It was "Ux" (unconfined). It talks to
# gpg-agent on stdin/stdout, asks the GNOME prompter over the session bus or draws its own window,
# and needs none of the user's files. It may not write under the home directory, run any program or
# open any network socket but a local (unix) one. (The expanded profile still has the scratch and
# socket writes the GTK and GNOME abstractions grant: /tmp, /var/tmp, the display and bus sockets.)
abi <abi/4.0>,
include <tunables/global>

profile prestium_pinentry {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/fonts>
  include <abstractions/freedesktop.org>
  include <abstractions/gnome>
  include <abstractions/wayland>
  include <abstractions/X>
  include <abstractions/dbus-session-strict>
  include <abstractions/prestium-no-admin>

  /usr/bin/pinentry{,-gnome3,-gtk2,-gtk-2,-curses,-x11} mr,
  /etc/alternatives/pinentry{,-x11} r,
  /usr/share/** r,
  /usr/lib/@{multiarch}/** mr,
  /etc/gtk-2.0/** r,
  /etc/gtk-3.0/** r,
  owner @{HOME}/.gtkrc-2.0 r,
  owner @{HOME}/.config/gtk-{2,3}.0/** r,
  owner @{PROC}/@{pid}/{fd/,status,cmdline} r,
  /dev/tty rw,
  /dev/pts/* rw,
  network unix stream,
  # (nameservice-strict, not nameservice: no inet or netlink rules come in through an abstraction)
  deny network inet,
  deny network inet6,
  deny network netlink,

  # the GNOME prompter (gcr) asks, then calls back on this connection
  dbus (send) bus=session peer=(name=org.gnome.keyring.SystemPrompter),
  dbus (send) bus=session peer=(name=org.gnome.keyring.PrivatePrompter),
  dbus (send, receive) bus=session interface=org.gnome.keyring.internal.Prompter{,.Callback},
  dbus (receive) bus=session interface=org.freedesktop.DBus.Properties,

  # nothing else: no files of the user, no other programs
  deny @{HOME}/** w,
  # base and gnome grant ix on a few home and /tmp paths (ecryptfs, @{HOME}/tmp); pinentry runs nothing
  deny @{HOME}/** x,
  deny /tmp/** x,
  deny /var/tmp/** x,
  deny @{HOME}/.gnupg/** rw,
  include if exists <local/prestium.pinentry>
}
