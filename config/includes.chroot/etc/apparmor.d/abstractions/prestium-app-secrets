# Prestium 2.1 (audit of 96468c5): what no confined app may touch, whatever else it may (part of
# prestium-app-base, prestium-viewer, the KeePassXC and Kleopatra profiles): keys, other apps'
# browser and keyring data, and the files that would run something at the next login.
  deny @{HOME}/.ssh/** rw,
  deny @{HOME}/.tor-browser/** rw,
  deny @{HOME}/.librewolf/** rw,
  deny @{HOME}/.mozilla/** rw,
  deny @{HOME}/.local/share/keyrings/** rw,
  deny @{HOME}/.config/autostart/** w,
  deny @{HOME}/.bashrc w,
  deny @{HOME}/.profile w,
  deny @{HOME}/.config/openbox/** w,
