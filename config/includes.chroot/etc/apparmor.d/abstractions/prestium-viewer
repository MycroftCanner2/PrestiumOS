# Prestium 2.1 (audit of 96468c5, M-1): what the programs that open downloaded files share (image
# viewers, VLC, the archive managers, the text editor, the metadata cleaners, GIMP, Audacity). A
# crafted image, video, sound file, archive or document that exploits one of them gets no network, no
# admin tools, no other app's data (mail, chat, browser profiles), no OpenPGP keys and no KeePassXC
# databases: only the user's file folders, which it may read. Each profile adds where it may write.
  include <abstractions/prestium-viewer-core>
  # no IPv4 at all, TCP included (prestium-viewer-core already denies IPv6, UDP and raw sockets)
  deny network inet,
