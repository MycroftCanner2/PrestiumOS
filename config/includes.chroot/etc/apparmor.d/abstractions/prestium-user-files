# Prestium 2.1 (audit of 96468c5, M-1): read the user's file folders: Desktop, Documents, Downloads,
# Pictures, Music, Videos, Public, Templates, OnionShare, the browsers' and torrents' own top-level
# folders (I2P Browser, Torrents, Tor Browser), and unlocked volumes under /media. No dot directory,
# nothing else in the home.
  owner @{HOME}/{Desktop,Documents,Downloads,Pictures,Music,Videos,Public,Templates,OnionShare}/ r,
  owner @{HOME}/{Desktop,Documents,Downloads,Pictures,Music,Videos,Public,Templates,OnionShare}/** r,
  owner "@{HOME}/I2P Browser/" r,
  owner "@{HOME}/I2P Browser/**" r,
  owner @{HOME}/Torrents/ r,
  owner @{HOME}/Torrents/** r,
  owner "@{HOME}/Tor Browser/" r,
  owner "@{HOME}/Tor Browser/**" r,
  /media/ r,
  /media/** r,
