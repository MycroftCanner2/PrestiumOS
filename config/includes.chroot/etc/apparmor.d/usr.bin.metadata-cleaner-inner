# Prestium 2.1 (bwrap split): Metadata Cleaner's helpers (mat2's ffmpeg, exiftool),
# ENFORCED in their own profile. Same shape as mat2-inner, except the cleaned
# copy is written next to the original in the shared ~/Documents folder (the GUI
# cleans files in place there): only that "<name>.cleaned.<ext>" name, only in
# ~/Documents. exiftool is a perl script: perl inherits this profile (ix).
# No attachment: entered only by explicit Px from Metadata Cleaner.
abi <abi/4.0>,
include <tunables/global>

profile metadata-cleaner-inner {
  include <abstractions/base>,
  include <abstractions/prestium-no-admin>,
  include <abstractions/prestium-user-files>,
  /usr/bin/{ffmpeg,exiftool,perl} mr,
  /usr/bin/perl ix,
  /usr/share/perl5/** r,
  /usr/share/perl/** r,
  /usr/lib/@{multiarch}/perl*/** mr,
  / r,
  /usr/ r,
  /usr/** mr,
  /etc/ r,
  /etc/** r,
  /sys/** r,
  /var/ r,
  /var/lib/ r,
  @{HOME}/ r,
  @{PROC}/ r,
  @{PROC}/sys/** r,
  owner @{PROC}/@{pid}/** r,
  /dev/ r,
  /dev/{null,zero,full,random,urandom} rw,
  owner /dev/shm/** rwk,
  owner /tmp/** rwlk,
  owner "@{HOME}/Documents/**.cleaned.*" w,
  deny network inet,
  deny network inet6,
  deny userns,
  deny capability sys_admin,
  deny capability sys_chroot,
  deny capability setpcap,
  deny capability net_admin,
  deny capability setuid,
  deny capability setgid,
  deny capability dac_override,
  deny capability dac_read_search,
  deny capability chown,
  deny capability fowner,
  deny capability fsetid,
  deny capability kill,
  deny capability sys_ptrace,
  deny ptrace,
  deny @{HOME}/.gnupg/** rw,
  deny @{HOME}/**.kdbx rw,
  deny @{HOME}/.claws-mail/** rw,
  deny @{HOME}/.purple/** rw,
  deny @{HOME}/.local/share/gajim/** rw,
  deny @{HOME}/.config/gajim/** rw,
  include if exists <local/usr.bin.metadata-cleaner-inner>
}
