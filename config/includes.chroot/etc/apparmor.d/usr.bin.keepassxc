# Prestium 2.1 (audit of 96468c5, M-1): KeePassXC, ENFORCED. A crafted database or key file gets no network, no OpenPGP keys and no
# other app's data. It may read and write *.kdbx databases (and their save and backup files) anywhere
# in the home, read key files in the file folders, and use a security key (hidraw, pcscd).
# 2.1 (audit): directory write anywhere in the home (and on /media) is deliberate, for saving a
# database and its sidecars in place; file writes stay *.kdbx-only, and the secret denies
# (~/.ssh, ~/.gnupg, autostart) still win over it.
# Off here: icon downloads and breach checks (no network), browser integration (it may not write the
# browsers' directories) and opening URLs (no other programs).
# Saving tested under this profile on a Debian 13 VM with AppArmor enabled; not yet on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile keepassxc /usr/bin/keepassxc {
  include <abstractions/prestium-app-common>
  include <abstractions/prestium-app-secrets>
  include <abstractions/prestium-user-files>
  deny @{HOME}/.Private/** wx,
  deny @{HOME}/tmp/** wx,
  deny @{HOME}/.gnupg/** rw,
  network unix stream,
  network unix dgram,
  network netlink dgram,
  network netlink raw,
  deny network inet,
  deny network inet6,

  /usr/bin/keepassxc mr,
  /usr/lib/@{multiarch}/keepassxc/** mr,
  # Qt (Qt 5 in Debian 13's KeePassXC 2.7.10) commits the default safe save with linkat: QSaveFile
  # opens an unnamed O_TMPFILE in the destination directory and linkat()s it onto the .kdbx name.
  # "l" is that link. The named fallback (Qt appends ".XXXXXX", so "<name>.kdbx.<random>") and the
  # ".kdbx.lock" sidecar are the "**.kdbx*" rule.
  # 2.1 (boot fix, root cause of "Writing the database failed: Permission denied"): AppArmor names
  # an unnamed O_TMPFILE "<directory>/#<inode number>", not "<name>.kdbx...", so no .kdbx rule
  # matched it. Kernel log on a Debian 13 VM with this profile, saving ~/Documents/x.kdbx:
  #   operation="open" name="/home/user/Documents/#135221" requested_mask="w" denied_mask="w"
  # and with only "rw" on it, the commit failed on the link (a link may not carry more than its
  # source has, and the .kdbx name has "k"):
  #   operation="link" name="/home/user/Documents/x.kdbx" denied_mask="k" target=".../#135221"
  # So the temp name gets "rwk", only in the places a database may be saved (the home and /media);
  # it is the same "#[0-9]*[0-9]" form Debian's qt5-settings-write abstraction uses.
  owner @{HOME}/#[0-9]*[0-9] rwk,
  owner @{HOME}/**/#[0-9]*[0-9] rwk,
  owner @{HOME}/**.kdbx rwkl,
  owner @{HOME}/**.kdbx* rwkl,
  # Saving a new database, its .lock sidecar on open, and an atomic-save
  # temporary file all create files, which needs write on the containing
  # directory: without it databases could neither be saved nor opened (the
  # .lock sidecar could not be created) outside the pre-seeded config dir.
  # Only directories are opened up here; file writes stay limited to *.kdbx
  # and their sidecars by the two rules above.
  owner @{HOME}/ rw,
  owner @{HOME}/**/ rw,
  /media/**/#[0-9]*[0-9] rwk,
  /media/**.kdbx rwkl,
  /media/**.kdbx* rwkl,
  # Same for a database kept on an unlocked volume (see prestium-user-files:
  # only *.kdbx files there stay writable).
  /media/ rw,
  /media/**/ rw,
  # First start creates its cache and data folders: creating a folder needs write on its parent,
  # and ~/.local/share is two levels deep on a fresh home (nothing of KeePassXC in /etc/skel),
  # so the ~/.cache/, ~/.local/ and ~/.local/share/ parents are granted too (same as LibreOffice).
  owner @{HOME}/.config/keepassxc/ rw,
  owner @{HOME}/.config/keepassxc/** rwkl,
  # 2.1: the Qt file dialog's settings (last folder, sidebar) in ~/.config/QtProject.conf, and
  # nothing else in ~/.config. Qt saves it like a database: its .lock file, an O_TMPFILE
  # ("#<inode>", the rule above) linked to "QtProject.conf.XXXXXX" and renamed onto the name.
  # Without these: mknod ".config/QtProject.conf.lock" and link ".config/QtProject.conf.DEteDY"
  # (target ".config/#108") were denied on the overlay home and the dialog forgot its folder.
  # The same rules as Debian's qt5-settings-write abstraction, the links bound to the temp name.
  owner @{HOME}/.config/QtProject.conf rwl -> @{HOME}/.config/#[0-9]*[0-9],
  owner @{HOME}/.config/QtProject.conf.?????? rwl -> @{HOME}/.config/#[0-9]*[0-9],
  owner @{HOME}/.config/QtProject.conf.lock rwk,
  owner @{HOME}/.cache/ rw,
  owner @{HOME}/.cache/keepassxc/ rw,
  # 2.1 (boot fix): KeePassXC keeps its window state in ~/.cache/keepassxc/keepassxc.ini and saves it
  # the same way (O_TMPFILE "#<inode>", then a link onto the name); without "l" that link was denied
  # on every start and exit (operation="link" name=".../.cache/keepassxc/keepassxc.ini" denied_mask="l")
  owner @{HOME}/.cache/keepassxc/** rwkl,
  owner @{HOME}/.local/ rw,
  owner @{HOME}/.local/share/ rw,
  owner @{HOME}/.local/share/keepassxc/ rw,
  owner @{HOME}/.local/share/keepassxc/** rwkl,
  owner @{run}/user/[0-9]*/ r,
  owner @{run}/user/[0-9]*/org.keepassxc.* rw,
  owner @{run}/user/[0-9]*/app/ r,
  owner @{run}/user/[0-9]*/app/org.keepassxc.KeePassXC/ rw,
  owner @{run}/user/[0-9]*/app/org.keepassxc.KeePassXC/** rw,
  # SSH agent integration (adds keys to the running agent; never reads ~/.ssh)
  owner @{run}/user/[0-9]*/{gcr,keyring,openssh_agent}/ssh rw,
  owner /tmp/ssh-*/agent.* rw,
  # hardware keys (YubiKey challenge-response)
  /dev/hidraw[0-9]* rw,
  /run/pcscd/pcscd.comm rw,
  /run/udev/data/** r,
  /sys/bus/ r,
  /sys/class/ r,
  /sys/class/hidraw/ r,
  /sys/devices/** r,
  include if exists <local/usr.bin.keepassxc>
}
