# Prestium 2.1 (audit of 96468c5, M-1): File Roller, the default archive manager, ENFORCED. Archives are a common exploit
# vector: no network, no other app's data, no keys. It and the tools it runs (tar, 7z, unzip, unrar, ...)
# read the file folders and extract only into them. Files opened from an archive go to their own profiles.
# Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile file-roller /usr/bin/file-roller {
  include <abstractions/prestium-viewer>
  include <abstractions/prestium-viewer-write>
  # 2.1 (L-5): the shared ~/Documents folder is the only folder in the home it may write
  owner @{HOME}/Documents/ rw,
  owner @{HOME}/Documents/** rwkl,
  /usr/bin/file-roller mr,
  /usr/libexec/file-roller/* mrix,
  /usr/bin/{tar,gzip,gunzip,zcat,bzip2,bunzip2,xz,unxz,lzma,unlzma,zstd,unzstd,lz4,lzip,lzop,brotli,cpio,ar,bsdtar,7z,7za,7zr,7zz,unzip,zip,zipinfo,unrar,rar,unar,lsar,cabextract,isoinfo,dpkg-deb,rpm2cpio,unsquashfs,arj,unarj,lha,unace,unalz,uudecode,file} mrix,
  /usr/lib/p7zip/** mrix,
  /usr/lib/7zip/** mrix,
  /{,usr/}bin/{sh,dash,bash,cat,cp,mv,rm,mkdir,rmdir,ln,ls,chmod,touch,readlink,env,dirname,basename,sed,grep,awk,mawk,head,tail,tr,wc,find,xargs,sort,stat,realpath,mktemp,id,uname,which} mrix,
  owner @{HOME}/.config/file-roller/ rw,
  owner @{HOME}/.config/file-roller/** rwk,
  owner @{HOME}/.cache/.fr-*/ rw,
  owner @{HOME}/.cache/.fr-*/** rwkl,
  owner @{HOME}/.cache/file-roller/ rw,
  owner @{HOME}/.cache/file-roller/** rwkl,
  include if exists <local/usr.bin.file-roller>
}
