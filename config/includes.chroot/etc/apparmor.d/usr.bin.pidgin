# Prestium: Pidgin (Tor + OTR).
# 2.0 r9: ENFORCED (was complain mode, i.e. not confined), with the shared app rules and no sudo,
# Prestium helpers or system bus. Not yet tested on a booted ISO.
abi <abi/3.0>,
include <tunables/global>

profile pidgin /usr/bin/pidgin {
  include <abstractions/prestium-app-base>
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/gnome>
  include <abstractions/fonts>
  include <abstractions/freedesktop.org>
  include <abstractions/dbus-session-strict>
  include <abstractions/audio>

  network inet stream,
  network inet6 stream,
  network unix stream,

  /usr/bin/pidgin mr,
  /usr/lib/purple-2/** mr,
  /usr/lib/pidgin/** mr,
  /usr/lib/x86_64-linux-gnu/purple-2/** mr,
  /usr/lib/x86_64-linux-gnu/pidgin/** mr,
  /usr/share/pidgin/** r,
  /usr/share/purple/** r,
  /usr/share/sounds/** r,
  /etc/ssl/** r,
  /usr/share/ca-certificates/** r,

  owner @{HOME}/.purple/ rw,
  owner @{HOME}/.purple/** rwk,
  owner @{HOME}/.cache/** rw,
  owner /tmp/** rw,

  deny @{HOME}/.ssh/** rw,
  deny @{HOME}/.gnupg/** rw,
  deny @{HOME}/Tor\ Browser/** rw,
  # plugins on any architecture, file transfers to ~/Downloads/Pidgin, links in Tor Browser (own sandbox)
  /usr/lib/@{multiarch}/purple-2/** mr,
  /usr/lib/@{multiarch}/pidgin/** mr,
  # 2.1 (L-5): its own download folder, ~/Downloads/Pidgin, is the only place it writes files. Received files go there;
  # to send a file, put it there or directly in ~/Downloads.
  # It may read the files you put directly in ~/Downloads (not another app's folder in it).
  owner @{HOME}/Downloads/ r,
  owner @{HOME}/Downloads/* r,
  owner "@{HOME}/Downloads/Pidgin/" rw,
  owner "@{HOME}/Downloads/Pidgin/**" rwk,
  /usr/bin/xdg-open ix,
  /{,usr/}bin/{sh,dash,bash,which,sed,grep,cat,readlink,dirname,basename,head,tr,cut} ix,
  # 2.1 (review): Px into the launcher profile, not Ux (see prestium.browser-launcher)
  /usr/local/bin/tor-browser Px -> prestium_tor_browser_launcher,

  include if exists <local/usr.bin.pidgin>
}
