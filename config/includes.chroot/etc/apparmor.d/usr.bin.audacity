# Prestium 2.1 (audit of 96468c5, M-1): Audacity, ENFORCED. No network (a TCP listener in its own,
# empty network namespace only; below), no camera, no other app's data, no keys; it opens and saves
# sound files and projects in the file folders only.
# 2.1 (review of 778baf7): the profile attaches to the real program, /usr/libexec/prestium-audacity
# (hook 0620 diverts /usr/bin/audacity there; /usr/bin/audacity is a shim that runs
# /usr/local/bin/prestium-audacity, which starts it with bubblewrap --unshare-net). The file keeps its
# old name.
# Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile audacity /usr/libexec/prestium-audacity {
  # 2.1 (review of 7242e00): prestium-viewer-core, not prestium-viewer. Audacity's single-instance
  # check (AudacityApp::CreateSingleInstanceChecker) listens on a TCP socket on 127.0.0.1; if it
  # can't create one, Audacity shows "Audacity Startup Failure" and quits. So IPv4 TCP is allowed;
  # UDP, raw and IPv6 sockets stay denied.
  # 2.1 (review of 778baf7): this TCP rule reaches only the loopback of Audacity's own network
  # namespace (prestium-audacity): nothing else is in it, so not the host's 127.0.0.1 (Tor's SOCKS
  # port, I2P's proxies) and no other address. No exec of bwrap, nsenter, the wrapper or the shim.
  include <abstractions/audio>
  include <abstractions/prestium-viewer-core>
  network inet stream,
  include <abstractions/prestium-viewer-write>
  # 2.1 (ISO test): Audacity 3.x checks new plug-ins in a second copy of itself, its plug-in host
  # (PluginHost::Start: wxExecute("<own executable> --host <port>"), which reports back over TCP on
  # 127.0.0.1). rms.ny ("Measure RMS") is the one Nyquist plug-in Debian ships that is not in
  # Audacity's built-in list (kShippedEffects), so it is checked that way at the first start. With
  # "mr" only, that exec was denied and Audacity reported "Incompatible plugin(s) found ... rms.ny".
  # ix: the host stays in this profile and in the same empty network namespace (inherited; the
  # wrapper and the shim are not run again).
  /usr/libexec/prestium-audacity mrix,
  /usr/lib/@{multiarch}/audacity/** mr,
  /usr/lib/{lv2,ladspa,vst,vst3}/** mr,
  /usr/lib/@{multiarch}/{lv2,ladspa}/** mr,
  /{,usr/}bin/{sh,dash,bash} ix,
  owner @{HOME}/.config/audacity/ rw,
  owner @{HOME}/.config/audacity/** rwk,
  owner @{HOME}/.local/share/audacity/ rw,
  owner @{HOME}/.local/share/audacity/** rwkl,
  owner @{HOME}/.local/state/audacity/ rw,
  owner @{HOME}/.local/state/audacity/** rwk,
  owner @{HOME}/.cache/audacity/ rw,
  owner @{HOME}/.cache/audacity/** rwk,
  owner @{HOME}/.audacity-data/ rw,
  owner @{HOME}/.audacity-data/** rwk,
  deny /dev/video* rw,
  # PortAudio plays and records through ALSA, which pipewire-alsa routes to PipeWire's socket
  owner @{run}/user/[0-9]*/pipewire-[0-9]* rw,
  include if exists <local/usr.bin.audacity>
}
