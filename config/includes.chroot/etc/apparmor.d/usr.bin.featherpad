# Prestium 2.1 (audit of 96468c5, M-1): FeatherPad, the text editor, ENFORCED. No network, no other app's data, no keys,
# no shell or start-up files: it opens and saves files in the file folders only (not in dot
# directories or the home directory itself).
# Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile featherpad /usr/bin/{featherpad,fpad} {
  include <abstractions/prestium-viewer>
  include <abstractions/prestium-viewer-write>
  # 2.1 (L-5): the shared ~/Documents folder is the only folder in the home it may write
  owner @{HOME}/Documents/ rw,
  owner @{HOME}/Documents/** rwkl,
  /usr/bin/{featherpad,fpad} mr,
  owner @{HOME}/.config/featherpad/ rw,
  owner @{HOME}/.config/featherpad/** rwk,
  owner @{HOME}/.local/share/featherpad/ rw,
  owner @{HOME}/.local/share/featherpad/** rwk,
  # 2.1 (review of 6bf1234): Qt's file dialog reads its sidebar from here (the shared ~/Documents is listed);
  # read-only, so it can't change what other Qt apps' dialogs show
  owner @{HOME}/.config/QtProject.conf r,
  # a running instance is found over D-Bus; never another program
  include if exists <local/usr.bin.featherpad>
}
