# Prestium 2.0 r9: LibreOffice, ENFORCED, with no network at all (documents are a common exploit
# vector, and an office suite doesn't need to go online here). It may open and save documents in
# the usual user folders, saves only in the shared ~/Documents (2.1, L-5), and uses its own profile. No sudo, no Prestium helpers, no system bus.
# Not yet tested on a booted ISO.
abi <abi/4.0>,
include <tunables/global>

profile libreoffice /usr/lib/libreoffice/program/{oosplash,soffice.bin} {
  include <abstractions/prestium-app-base>
  include if exists <abstractions/enchant>
  include if exists <abstractions/aspell>
  include <abstractions/cups-client>

  network unix stream,
  network unix dgram,
  deny network inet,
  deny network inet6,

  /usr/lib/libreoffice/** mr,
  /usr/lib/libreoffice/program/{oosplash,soffice.bin,soffice,xpdfimport,gengal.bin,ui-previewer,senddoc} ix,
  /{,usr/}bin/{sh,dash,bash,uname,sed,grep,dirname,basename,readlink,ls,cat} ix,
  /etc/libreoffice/** r,
  /var/lib/libreoffice/** r,
  /etc/papersize r,

  owner @{HOME}/.config/libreoffice/ rw,
  owner @{HOME}/.config/libreoffice/** rwkl,
  owner @{HOME}/.cache/libreoffice/ rw,
  owner @{HOME}/.cache/libreoffice/** rwkl,
  # 2.1: LibreOffice 25.x also keeps user data under the XDG data dir; without
  # it the first run could not finish creating its user profile and showed
  # "the installation is not complete" instead of opening. The "l" (link)
  # permission is for its lock/link files in the profile and cache.
  owner @{HOME}/.local/share/libreoffice/ rw,
  owner @{HOME}/.local/share/libreoffice/** rwkl,
  # First start creates these three profile folders, and creating a folder
  # needs write on its parent: on a fresh home (nothing of LibreOffice in
  # /etc/skel) the mkdir failed, so the first run died with "Fatal Error"
  # instead of opening. File writes stay limited to the profile folders
  # themselves (like Kleopatra's parent ~/.local/state/ rule).
  owner @{HOME}/.config/ rw,
  owner @{HOME}/.cache/ rw,
  owner @{HOME}/.local/share/ rw,
  owner @{HOME}/{Desktop,Documents,Downloads,Pictures,Music,Videos,Public,Templates}/ r,
  owner @{HOME}/{Desktop,Documents,Downloads,Pictures,Music,Videos,Public,Templates}/** r,
  owner "@{HOME}/I2P Browser/" r,
  owner "@{HOME}/I2P Browser/**" r,
  owner @{HOME}/Torrents/ r,
  owner @{HOME}/Torrents/** r,
  # 2.1 (L-5): it saves only in the shared ~/Documents folder, so a crafted document can't change a
  # file in ~/Downloads or the Tor Browser's folder. A document opened from elsewhere opens, but saving it in place fails (AppArmor
  # denies the write): save it with "Save As" into ~/Documents, the default folder
  # (2.1, review of 6bf1234: /usr/lib/libreoffice/share/registry/prestium.xcd sets that Work path and
  # turns off lock files, UseLocking=false, so no ".~lock.<name>#" file is written next to a document;
  # nothing else in the home is writable for one, and Prestium is single-user)
  owner @{HOME}/Documents/ rw,
  owner @{HOME}/Documents/** rwk,
  # 2.1 (review of 6bf1234): unlocked VeraCrypt/LUKS volumes are read-only (no shared "/media/** rwk");
  # move a saved document onto a volume with the file manager
  /media/ r,
  /media/** r,

  # no Java, no macros helpers outside the suite, no other programs
  deny /usr/lib/jvm/** x,

  include if exists <local/usr.lib.libreoffice.program>
}
