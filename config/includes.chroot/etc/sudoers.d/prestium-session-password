# Prestium: the screen lock asks whether a session password exists. 2.1 (audit L-2): setting the
# first one is done by the Wayland broker (root) from its own dialog, not through sudo, so a program
# of the user can no longer choose the password before the person at the screen does.
user ALL=(root) NOPASSWD: /usr/local/sbin/prestium-session-password status
