# Prestium 2.0 r10: desktop look under Wayland (GTK reads these; under Openbox xfsettingsd set them)
[org/gnome/desktop/interface]
gtk-theme='Adwaita'
icon-theme='Prestium'
font-name='Cantarell 10'
font-antialiasing='grayscale'
font-hinting='slight'
cursor-theme='Adwaita'
cursor-size=24
color-scheme='prefer-dark'
clock-format='24h'

# 2.1: no window buttons in app header bars; labwc's title bar has minimise, maximise and close
[org/gnome/desktop/wm/preferences]
button-layout=':'
