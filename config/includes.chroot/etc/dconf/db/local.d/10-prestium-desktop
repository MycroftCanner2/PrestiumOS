# Prestium 2.0 r10: desktop look under Wayland (GTK reads these; under Openbox xfsettingsd set them)
[org/gnome/desktop/interface]
gtk-theme='Adwaita'
icon-theme='Adwaita'
font-name='Cantarell 11'
monospace-font-name='Monospace 10'
font-antialiasing='grayscale'
font-hinting='slight'
cursor-theme='Adwaita'
cursor-size=24
color-scheme='default'
# 2.1 (design batch): libadwaita's nearest named accent; the exact blue is in gtk.css (2.1, contrast review:
# #0050c8 behind white text, 7.0:1)
accent-color='blue'
clock-format='24h'

# 2.1: window buttons in app header bars (client-side decorations draw them);
# stock GNOME layout (close only), matching labwc's server-side titlebars
[org/gnome/desktop/wm/preferences]
button-layout='appmenu:close'
