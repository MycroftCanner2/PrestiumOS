# Prestium: Tor control-port filter (Tails onion-grater style)
[Unit]
Description=Prestium Tor control port filter (onion-grater)
After=tor@default.service
Wants=tor@default.service
# review of 8f5b9ce (I-7): systemd ignores AppArmorProfile= when AppArmor is off (apparmor=0); refuse to start then
AssertSecurity=apparmor

[Service]
Type=simple
ExecStart=/usr/local/sbin/prestium-onion-grater
User=onion-grater
Group=onion-grater
SupplementaryGroups=debian-tor prestium-tbb
RuntimeDirectory=onion-grater
RuntimeDirectoryMode=0755
# 2.1: keep the directory across restarts; Tor Browser's sandbox binds it (not the socket file)
RuntimeDirectoryPreserve=yes
# read /proc/<pid>/exe of the connecting app (another uid)
# 2.1 (ISO test after ba6ff54): CAP_DAC_READ_SEARCH too. /proc/<pid>/environ is mode 0400, owned by
# the client's uid: CAP_SYS_PTRACE passes the ptrace check, but the open is a plain file permission
# check, so without it every Python client (Nyx, the Tor Connection Assistant, OnionShare) was refused
# with "cannot inspect environment: Permission denied" while Tor Browser (no environ check) worked.
# Read-only; the AppArmor profile still limits which files the filter can open, open_by_handle_at is
# outside @system-service, and the secrets of the system are hidden from the filter below.
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
# 2.1 (audit of a5fd1fb, I-7): no "-" prefix, so the filter never runs without its profile (fail closed)
AppArmorProfile=prestium_onion_grater
InaccessiblePaths=-/etc/shadow -/etc/shadow- -/etc/gshadow -/etc/gshadow- -/etc/sudoers -/etc/sudoers.d -/etc/ssh -/var/lib
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# 2.1 (security audit): CAP_SYS_PTRACE is for reading /proc of the connecting app only; no tracing
# or cross-process memory syscalls at all (AppArmor profile prestium_onion_grater does the rest)
SystemCallFilter=@system-service
SystemCallFilter=~@debug
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
