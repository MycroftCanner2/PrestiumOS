[Unit]
Description=Prestium: keep the real MAC address off the network (NetworkManager guard)
# 2.0 r10: see /usr/local/sbin/prestium-mac-guard
After=dbus.service NetworkManager.service
BindsTo=NetworkManager.service
ConditionKernelCommandLine=!nomacspoof

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/local/sbin/prestium-mac-guard
Restart=always
RestartSec=1
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/prestium/safety
PrivateTmp=yes
# 2.1 (security audit): it changes NetworkManager settings over D-Bus (no capability needed as root)
# and loads an nft table (CAP_NET_ADMIN); nothing else
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=NetworkManager.service
