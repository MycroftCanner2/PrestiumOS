# Prestium: fix a badly wrong clock from the Tor consensus when Tor
# can't bootstrap because of it (Tails approach, no clearnet)
[Unit]
Description=Prestium pre-bootstrap clock fix (Tor consensus time)
After=tor@default.service
Wants=tor@default.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/prestium-clockfix
# 2.1 (audit L-3): read Tor's cached consensus and journal (dac_read_search), set the clock
# (sys_time), restart Tor and i2pd through systemd's own socket. Nothing else: no network at all.
CapabilityBoundingSet=CAP_SYS_TIME CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
NoNewPrivileges=yes
SystemCallFilter=@system-service @clock
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
ReadOnlyPaths=/var/lib/tor
# 2.1 (review): the safety flag when it refuses a consensus time
ExecStartPre=+/usr/bin/install -d -o root -g root -m 0755 /run/prestium /run/prestium/safety
ReadWritePaths=/run/prestium
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0022

[Install]
WantedBy=multi-user.target
