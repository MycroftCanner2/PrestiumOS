# Prestium 2.1: the Tor, i2pd and onion-grater logs for the desktop user (prestium-logs-view), without a
# sudo rule and without putting the user in the journal group. Not root; reads only those three units'
# entries (fixed in /usr/local/sbin/prestium-logs) and writes only /run/prestium/logs.
[Unit]
Description=Prestium readable logs (Tor, I2P, control-port filter)
After=systemd-journald.service systemd-tmpfiles-setup.service
# 2.1 (review of 6bf1234): /run/prestium/logs is made by tmpfiles (prestium-safety.conf). If it is missing
# anyway, ReadWritePaths= fails the start: give up after 5 tries in 5 minutes instead of a restart loop
# every 10 seconds for ever (the viewer then says the log is not available).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Restart=on-failure
RestartSec=10
ExecStart=/usr/local/sbin/prestium-logs
User=prestium-logs
Group=prestium-logs
SupplementaryGroups=systemd-journal
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/prestium/logs
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid
IPAddressDeny=any
DevicePolicy=closed
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0027
# 2.1 (review of 6bf1234): one Python process and one journalctl at a time
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
