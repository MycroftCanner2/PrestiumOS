# Prestium 2.0 r10: notifications (mako, replaces notification-daemon)
# 2.1: dark Adwaita colours, rounded, like the windows and the bar
anchor=top-right
default-timeout=8000
font=Cantarell 10
background-color=#303030
text-color=#ffffff
border-color=#1e1e1e
border-size=1
border-radius=12
padding=12
margin=10
width=360
max-visible=5
icons=1
max-icon-size=40
icon-location=left
# 2.1: only identical repeats collapse (same app and summary); critical alerts are never hidden
group-by=app-name,summary
format=<b>%s</b>\n%b
[urgency=critical]
default-timeout=0
border-color=#ff7b63
border-size=2
[grouped]
format=(%g) <b>%s</b>\n%b
# after [grouped]: a critical alert stays visible even inside a group
[urgency=critical]
invisible=0
