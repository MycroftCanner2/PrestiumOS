# Prestium 2.1: dark notifications under the black top bar (Adwaita dark values).
# One look per urgency: low (grey text, 5 s), normal (grey edge, 5 s),
# critical (red edge, stays until dismissed). The volume and brightness OSD (category prestium.osd) is compact.
# mako has no fade or slide animation. Sounds are off unless turned on (System, Notification Sounds).
anchor=top-center
margin=8
default-timeout=5000
font=Cantarell 11
background-color=#282828
text-color=#ffffff
border-color=#454545
border-size=1
border-radius=12
padding=12,16
outer-margin=4
width=380
max-visible=5
icons=1
# mako looks up named icons only here and in hicolor, without theme
# inheritance, so list the themes Prestium inherits from in the same order
icon-path=/usr/share/icons/Adwaita:/usr/share/icons/Papirus:/usr/share/icons/Prestium:/usr/share/icons/Papirus-Dark:/usr/share/icons/AdwaitaLegacy:/usr/share/icons/gnome
max-icon-size=48
icon-location=left
progress-color=over #0050c8
# only identical repeats collapse (same app and summary); critical alerts are never hidden
group-by=app-name,summary
format=<b>%s</b>\n%b
on-notify=exec /usr/local/bin/prestium-notify-sound normal

[urgency=low]
default-timeout=5000
border-color=#454545
text-color=#c8c8c8

[urgency=critical]
default-timeout=0
border-color=#c01c28

[category=prestium.osd]
anchor=top-center
width=260
max-icon-size=48
border-color=#3584e4
default-timeout=1500
group-by=none
format=<b>%s</b>
on-notify=none

[grouped]
format=(%g) <b>%s</b>\n%b

# after [grouped]: a critical alert stays visible even inside a group
[urgency=critical]
invisible=0
