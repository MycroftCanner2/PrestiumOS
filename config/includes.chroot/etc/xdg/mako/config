# Prestium 2.1 (Tails-style): GNOME-style top-center light notifications (Adwaita).
# One look per urgency: low (grey edge, 5 s), normal (grey edge, 6 s),
# critical (red edge, stays until dismissed). The volume and brightness OSD (category prestium.osd) is compact.
# mako has no fade or slide animation. Sounds are off unless turned on (System, Notification Sounds).
anchor=top-center
margin=34,0,0,0
default-timeout=6000
font=Cantarell 11
background-color=#ffffff
text-color=#2e3436
border-color=#cdc7c2
border-size=1
border-radius=12
padding=12
outer-margin=4
width=380
max-visible=5
icons=1
# mako looks up named icons only here and in hicolor, without theme
# inheritance, so list the themes Prestium inherits from in the same order
icon-path=/usr/share/icons/Prestium:/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus:/usr/share/icons/AdwaitaLegacy:/usr/share/icons/gnome:/usr/share/icons/Adwaita
max-icon-size=48
icon-location=left
progress-color=over #0050c8
# only identical repeats collapse (same app and summary); critical alerts are never hidden
group-by=app-name,summary
format=<b>%s</b>\n%b
on-notify=exec /usr/local/bin/prestium-notify-sound normal

[urgency=low]
default-timeout=5000
border-color=#cdc7c2
text-color=#5e5c64

[urgency=critical]
default-timeout=0
border-color=#c01c28

[category=prestium.osd]
anchor=top-center
width=260
max-icon-size=48
border-color=#3584e4
default-timeout=1500
group-by=none
format=<b>%s</b>
on-notify=none

[grouped]
format=(%g) <b>%s</b>\n%b

# after [grouped]: a critical alert stays visible even inside a group
[urgency=critical]
invisible=0
