// Prestium 2.1 (Tails-style dual bar): a dark top system bar (Applications menu,
// clock, Tor/I2P pills, tray) and a light bottom window-list taskbar.
// The Applications button opens prestium-apps-menu (a categorized dropdown);
// Super+Space and right-click still open labwc's root menu (system actions).
[
  {
    // 2.1 (design batch): Tor and I2P pills. Root-free and read-only: prestium-netstatus.service
    // writes the state every 5 seconds; a click opens the matching Connection Assistant (Network menu).
    "name": "tails-top",
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "modules-left": ["custom/applications"],
    "modules-center": ["clock"],
    "modules-right": ["custom/tor", "custom/i2p", "custom/timesync", "tray", "network", "pulseaudio", "battery"],
    "custom/applications": {
      "format": "Applications",
      "on-click": "/usr/local/bin/prestium-apps-menu",
      "tooltip": false
    },
    "clock": {
      "format": "{:%a %b %d  %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "timezone": "Etc/UTC"
    },
    "custom/tor": {
      "exec": "cat /run/prestium/netstatus/tor.json",
      "return-type": "json",
      "interval": 5,
      "format": "\uf111  {}",
      "on-click": "prestium-run /usr/local/bin/prestium-tor-assistant"
    },
    "custom/i2p": {
      "exec": "cat /run/prestium/netstatus/i2p.json",
      "return-type": "json",
      "interval": 5,
      "format": "\uf111  {}",
      "on-click": "prestium-run /usr/local/bin/prestium-i2p-assistant"
    },
    // clock sync over Tor (prestium-timesync). Hidden once the time is set; a clock symbol in amber
    // while it waits or syncs, red when it refused a time it could not trust.
    "custom/timesync": {
      "exec": "cat /run/prestium/timesync/waybar.json",
      "return-type": "json",
      "interval": 10,
      "format": "{}"
    },
    "tray": { "icon-size": 18, "spacing": 8 },
    "network": {
      "format-wifi": "\uf1eb",
      "format-ethernet": "\uf0e8",
      "format-linked": "\uf0e8",
      "format-disconnected": "\uf127",
      "tooltip-format-wifi": "Wi-Fi {essid} ({signalStrength} %)",
      "tooltip-format-ethernet": "Wired: {ifname}",
      "tooltip-format-disconnected": "No network",
      "interval": 10
    },
    "pulseaudio": {
      // icon only, like a system tray; the level shows on hover
      "format": "{icon}",
      "format-muted": "\uf026",
      "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
      "tooltip-format": "Volume {volume} % (click: mixer, right-click: mute)",
      "scroll-step": 5,
      "max-volume": 100,
      "on-click": "prestium-run pavucontrol --tab=1",
      "on-click-right": "/usr/local/bin/prestium-media-key mute"
    },
    "battery": {
      "states": { "warning": 20, "critical": 10 },
      "format": "{icon}",
      "format-charging": "\uf0e7 {icon}",
      "format-plugged": "\uf1e6",
      "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
      "tooltip-format": "Battery {capacity} %. {timeTo}"
    }
  },
  {
    // Tails bottom window-list taskbar: titled buttons (raise/minimise/close)
    "name": "tails-bottom",
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 4,
    "modules-left": ["wlr/taskbar"],
    "modules-center": [],
    "modules-right": [],
    "wlr/taskbar": {
      "format": "{icon}  {title:.28}",
      "icon-size": 16,
      "icon-theme": "Adwaita",
      "tooltip-format": "{title} ({app_id})",
      "sort-by-app-id": true,
      "all-outputs": true,
      "on-click": "minimize-raise",
      "on-click-middle": "close",
      "ignore-list": ["waybar"]
    }
  }
]
