// Prestium 2.1: solid black top system bar (Applications, clock, Tor/I2P
// status, clock-sync symbol, tray) and a black bottom icon-only window-list taskbar.
// The Applications button opens labwc's root menu through the broker;
// Super+Space opens the same menu. Nothing else in the bars, or on the desktop, opens it.
[
  {
    // 2.1: Tor and I2P status. Root-free and read-only: prestium-netstatus.service
    // writes the state every 5 seconds; a click opens the matching Connection Assistant (Network menu).
    // Clicks that open an app go through prestium-launch: waybar lives in prestium-wl-broker.service,
    // whose seccomp filters (no IP sockets, no namespaces) every child would inherit; prestium-launch
    // starts the app as its own unit under the user's systemd manager, like the menu's apps.
    "name": "prestium-top",
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin": "0 0 0 0",
    "spacing": 0,
    "modules-left": ["custom/applications"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/tor-status", "custom/i2p-status", "custom/timesync", "pulseaudio", "network", "battery", "custom/power"],
    "custom/applications": {
      "format": "Applications",
      // 2.1: on the button's release, not its press. labwc opens the menu at once and takes the
      // pointer from the bar, so a press-started menu kept the release from ever reaching waybar:
      // GTK then held the click on Applications, and the next click anywhere in either bar (a
      // Tor/I2P pill, a taskbar icon) went to Applications and opened the menu again.
      "on-click-release": "/usr/local/bin/prestium-wl menu",
      "tooltip": false
    },
    "clock": {
      "format": "{:%a %b %d, %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "timezone": "Etc/UTC"
    },
    "custom/tor-status": {
      "exec": "cat /run/prestium/netstatus/tor.json",
      "return-type": "json",
      "interval": 5,
      "format": "\uf111  {}",
      "on-click": "/usr/local/bin/prestium-launch /usr/local/bin/prestium-tor-assistant"
    },
    "custom/i2p-status": {
      "exec": "cat /run/prestium/netstatus/i2p.json",
      "return-type": "json",
      "interval": 5,
      "format": "\uf111  {}",
      "on-click": "/usr/local/bin/prestium-launch /usr/local/bin/prestium-i2p-assistant"
    },
    // clock sync over Tor (prestium-timesync). Hidden once the time is set; a clock
    // symbol in amber while it waits or syncs, red when it refused a time it could not trust.
    "custom/timesync": {
      "exec": "cat /run/prestium/timesync/waybar.json",
      "return-type": "json",
      "interval": 10,
      "format": "{}"
    },
    "tray": { "icon-size": 18, "spacing": 8 },
    "network": {
      "format-wifi": "\uf1eb",
      "format-ethernet": "\uf0e8",
      "format-linked": "\uf0e8",
      "format-disconnected": "\uf127",
      "tooltip-format-wifi": "Wi-Fi {essid} ({signalStrength} %)",
      "tooltip-format-ethernet": "Wired: {ifname}",
      "tooltip-format-disconnected": "No network",
      "interval": 10
    },
    "pulseaudio": {
      // icon only, like a system tray; the level shows on hover
      "format": "{icon}",
      "format-muted": "\uf026",
      "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
      "tooltip-format": "Volume {volume} % (click: mixer, right-click: mute)",
      "scroll-step": 5,
      "max-volume": 100,
      "on-click": "/usr/local/bin/prestium-launch pavucontrol --tab=1",
      "on-click-right": "/usr/local/bin/prestium-media-key mute"
    },
    "battery": {
      "states": { "warning": 20, "critical": 10 },
      "format": "{icon}",
      "format-charging": "\uf0e7 {icon}",
      "format-plugged": "\uf1e6",
      "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
      "tooltip-format": "Battery {capacity} %. {timeTo}"
    },
    "custom/power": {
      "format": "\uf011",
      "on-click": "/usr/local/bin/prestium-launch /usr/local/bin/prestium-power-menu",
      "tooltip-format": "Power"
    }
  },
  {
    // Bottom window-list taskbar: the app's own colour icon (Papirus). Adwaita
    // symbolic icons were recoloured white by the button colour, so the logos vanished.
    // A click focuses that window. It must not open the root menu (labwc's default
    // left-click on the desktop does; that bind is cleared in rc.xml).
    "name": "prestium-bottom",
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "exclusive": true,
    "passthrough": false,
    "spacing": 4,
    "modules-left": ["wlr/taskbar"],
    "modules-center": [],
    "modules-right": [],
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 24,
      "icon-theme": "Papirus",
      "tooltip-format": "{title} ({app_id})",
      "sort-by-app-id": true,
      "all-outputs": true,
      "on-click": "activate",
      "on-click-middle": "close",
      "ignore-list": ["waybar"]
    }
  }
]
