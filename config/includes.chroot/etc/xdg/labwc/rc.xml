<?xml version="1.0"?>
<!--
  Prestium 2.0 r10: labwc (Wayland compositor) configuration, replacing Openbox.
  Same key bindings as the Openbox desktop. Applications started from here go through
  prestium-run, which connects them to the restricted Wayland socket (no screen capture, no input
  injection, no clipboard snooping, no reading other windows). Trusted session parts (panel,
  screen lock, on-screen keyboard, screenshots, display settings) use the full socket.
  Touchpad settings: ~/.config/prestium/touchpad.json (prestium-touchpad), copied as checked values
  into the root-owned copy of this file that labwc reads (prestium-wl-config); ~/.config/labwc is not read.
-->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <xwaylandPersistence>no</xwaylandPersistence>
  </core>
  <placement><policy>center</policy></placement>
  <theme>
    <name>Prestium-Adwaita</name>
    <cornerRadius>8</cornerRadius>
    <dropShadows>yes</dropShadows>
    <!-- 2.1: icon theme for menu and titlebar icons (unset, labwc would look for a "Prestium-Adwaita" icon theme) -->
    <icon>Prestium</icon>
    <titleLayout>icon,label:minimize,maximize,close</titleLayout>
    <font place="ActiveWindow"><name>Cantarell</name><size>11</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Cantarell</name><size>11</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Cantarell</name><size>11</size></font>
    <font place="OnScreenDisplay"><name>Cantarell</name><size>11</size><weight>bold</weight></font>
  </theme>
  <!-- 2.1: icons beside menu items (the item icon= attributes in menu.xml) -->
  <menu><showIcons>yes</showIcons></menu>
  <focus><followMouse>no</followMouse><raiseOnFocus>no</raiseOnFocus></focus>
  <!-- 2.1: one desktop (with four and no indicator in the bar, windows got "lost") -->
  <desktops number="1" />
  <windowSwitcher show="yes" preview="yes" outlines="yes" />

  <keyboard>
    <default />
    <!-- 2.1: give Alt+arrows back to the browsers (Back/Forward), drop default binds to programs Prestium lacks -->
    <keybind key="A-Left"><action name="None" /></keybind>
    <keybind key="A-Right"><action name="None" /></keybind>
    <keybind key="A-Up"><action name="None" /></keybind>
    <keybind key="A-Down"><action name="None" /></keybind>
    <keybind key="A-F3"><action name="None" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="prestium-run foot" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="A-Escape"><action name="Lower" /></keybind>
    <keybind key="A-space"><action name="ShowMenu" menu="client-menu" /></keybind>
    <!-- 2.1: the root menu always opens at the top-left, just under the Applications
         button, wherever the pointer is (the panel button presses Super+Space after a short wait,
         so "at the pointer" moved with the mouse). No mouse click on the desktop opens it (mouse below).
         Positions count inside the usable area, which already starts under the top bar, so y=0 is
         that bar's bottom edge. -->
    <keybind key="W-space">
      <action name="ShowMenu" menu="root-menu">
        <atCursor>no</atCursor>
        <position><x>0</x><y>0</y></position>
      </action>
    </keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-l"><action name="Execute" command="/usr/local/bin/prestium-lock-screen" /></keybind>
    <keybind key="W-e"><action name="Execute" command="prestium-run pcmanfm" /></keybind>
    <keybind key="W-t"><action name="Execute" command="prestium-run foot" /></keybind>
    <keybind key="Print"><action name="Execute" command="/usr/local/bin/prestium-screenshot" /></keybind>
    <keybind key="A-Print"><action name="Execute" command="/usr/local/bin/prestium-screenshot --area" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="/usr/local/bin/prestium-media-key volume-up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="/usr/local/bin/prestium-media-key volume-down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="/usr/local/bin/prestium-media-key mute" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="/usr/local/bin/prestium-media-key mic-mute" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="/usr/local/bin/prestium-media-key brightness-up" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="/usr/local/bin/prestium-media-key brightness-down" /></keybind>
    <keybind key="XF86Display"><action name="Execute" command="/usr/local/bin/prestium-wl display-settings" /></keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- 2.1: the root menu opens only from the Applications button (and Super+Space): no
         mouse button on the desktop opens it. labwc's defaults open it on a Left, Right or
         Middle press on the desktop; a later bind for the same context, button and event
         replaces the default, so each is cleared here. Scrolling on the desktop keeps its default. -->
    <context name="Root">
      <mousebind button="Left" action="Press">
        <action name="None" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="None" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="None" />
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
      <naturalScroll>yes</naturalScroll>
      <disableWhileTyping>yes</disableWhileTyping>
      <pointerSpeed>0</pointerSpeed>
    </device>
  </libinput>

  <windowRules>
    <!-- zenity 4 draws title-less dialogs; give them a frame and open them centred. 2.1 (dialog look):
         /usr/local/bin/zenity loads dialog-style/gtk-4.0/gtk.css, which makes the content flat under this
         title bar (no inner rounded card or outline, the title shown once) -->
    <windowRule identifier="*zenity*" serverDecoration="yes">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <!-- 2.1: the file picker behind zenity file selections draws one header bar with the window
         buttons itself (/usr/local/lib/prestium/file-picker), so no title bar of labwc's; centred -->
    <windowRule identifier="org.prestium.FilePicker">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <!-- One compositor title bar for every other window (core decoration=server:
         minimise, maximise, close), outside the client surface. Forcing
         serverDecoration=yes on an app that also draws its own bar painted that
         bar over the top of the window (Galculator, LibreWolf). GTK_CSD=0 and
         MOZ_GTK_TITLEBAR_DECORATION=system make those apps leave the bar to labwc. -->
  </windowRules>
</labwc_config>
