<?xml version="1.0" encoding="UTF-8"?>
<!-- Prestium 2.0 r10: desktop menu (labwc). Apps start through prestium-run (restricted Wayland
     socket); the display settings, screen lock and on-screen keyboard need the full socket. -->
<openbox_menu>
<menu id="root-menu" label="Prestium">
  <!-- 2.1 (UI audit C4-C7): grouped by task; each networked app names its network in the label;
       entries that open a dialog first end in an ellipsis -->
  <item label="I2P Browser" icon="librewolf">
    <action name="Execute" command="prestium-run librewolf-i2p" />
  </item>
  <item label="Tor Browser" icon="/opt/tor-browser/Browser/browser/chrome/icons/default/default128.png">
    <action name="Execute" command="prestium-run tor-browser" />
  </item>
  <item label="I2P Router Console" icon="applications-internet">
    <action name="Execute" command="prestium-run /usr/local/bin/prestium-i2p-console" />
  </item>
  <item label="Text Editor" icon="featherpad">
    <action name="Execute" command="prestium-run featherpad" />
  </item>
  <item label="File Manager" icon="system-file-manager">
    <action name="Execute" command="prestium-run pcmanfm" />
  </item>
  <separator />
  <menu id="/Office" label="Office" icon="applications-office">
    <item label="LibreOffice Writer" icon="libreoffice-writer">
      <action name="Execute" command="prestium-run libreoffice --writer" />
    </item>
    <item label="LibreOffice Calc" icon="libreoffice-calc">
      <action name="Execute" command="prestium-run libreoffice --calc" />
    </item>
    <item label="LibreOffice Math" icon="libreoffice-math">
      <action name="Execute" command="prestium-run libreoffice --math" />
    </item>
    <item label="LibreOffice Impress" icon="libreoffice-impress">
      <action name="Execute" command="prestium-run libreoffice --impress" />
    </item>
    <item label="LibreOffice Draw" icon="libreoffice-draw">
      <action name="Execute" command="prestium-run libreoffice --draw" />
    </item>
  </menu>
  <menu id="/Multimedia" label="Multimedia" icon="applications-multimedia">
    <item label="Volume Control" icon="multimedia-volume-control">
      <action name="Execute" command="prestium-run pavucontrol" />
    </item>
    <item label="Audacity" icon="audacity">
      <action name="Execute" command="prestium-run audacity" />
    </item>
    <item label="GIMP" icon="gimp">
      <action name="Execute" command="prestium-run gimp" />
    </item>
    <item label="VLC Media Player" icon="vlc">
      <action name="Execute" command="prestium-run vlc" />
    </item>
  </menu>
  <menu id="/Accessories" label="Accessories" icon="applications-accessories">
    <item label="Calculator" icon="accessories-calculator">
      <action name="Execute" command="prestium-run galculator" />
    </item>
    <item label="Archive Manager" icon="org.gnome.FileRoller">
      <action name="Execute" command="prestium-run file-roller" />
    </item>
    <item label="Image Viewer" icon="org.gnome.Loupe">
      <action name="Execute" command="prestium-run loupe" />
    </item>
    <item label="QR Generator" icon="qtqr">
      <action name="Execute" command="prestium-run qtqr" />
    </item>
  </menu>
  <menu id="/Security" label="Security" icon="dialog-password">
    <item label="KeePassXC (Passwords)" icon="keepassxc">
      <action name="Execute" command="prestium-run keepassxc" />
    </item>
    <item label="Kleopatra (GnuPG Keys)" icon="kleopatra">
      <action name="Execute" command="prestium-run kleopatra" />
    </item>
    <item label="Metadata Cleaner" icon="fr.romainvigier.MetadataCleaner">
      <action name="Execute" command="prestium-run metadata-cleaner" />
    </item>
    <item label="Unlock Encrypted Volume…" icon="drive-harddisk">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-unlock-volume" />
    </item>
    <item label="Feather (Monero Wallet, I2P)" icon="security-high">
      <action name="Execute" command="prestium-run feather" />
    </item>
  </menu>
  <menu id="/Communication" label="Communication" icon="mail-unread">
    <item label="Claws Mail (Email, I2P)" icon="claws-mail">
      <action name="Execute" command="prestium-run claws-mail-i2p" />
    </item>
    <item label="Gajim (XMPP, Tor)" icon="org.gajim.Gajim">
      <action name="Execute" command="prestium-run gajim" />
    </item>
    <item label="Pidgin (Chat, Tor)" icon="pidgin">
      <action name="Execute" command="prestium-run /usr/local/bin/pidgin-tor" />
    </item>
    <item label="The Lounge (IRC, I2P)" icon="user-available">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-irc" />
    </item>
  </menu>
  <menu id="/Sharing" label="Sharing" icon="folder-publicshare">
    <item label="OnionShare (Tor)" icon="org.onionshare.OnionShare">
      <action name="Execute" command="prestium-run onionshare" />
    </item>
    <item label="Torrents (I2P)" icon="folder-download">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-torrents" />
    </item>
  </menu>
  <menu id="/Network" label="Network" icon="preferences-system-network">
    <item label="I2P Connection Assistant" icon="network-workgroup">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-i2p-assistant" />
    </item>
    <item label="Tor Connection Assistant" icon="/opt/tor-browser/Browser/browser/chrome/icons/default/default128.png">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-tor-assistant" />
    </item>
    <item label="Browser Updater" icon="system-software-update">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-browser-updater" />
    </item>
    <item label="Tor Monitor (Nyx)" icon="utilities-system-monitor">
      <action name="Execute" command="prestium-run foot --title='Tor Monitor (Nyx)' --app-id=prestium-nyx prestium-nyx -s /run/onion-grater/control" />
    </item>
  </menu>
  <menu id="/System" label="System" icon="preferences-system">
    <item label="Terminal" icon="utilities-terminal">
      <action name="Execute" command="prestium-run foot" />
    </item>
    <item label="Lock Screen…" icon="system-lock-screen">
      <action name="Execute" command="/usr/local/bin/prestium-lock-screen" />
    </item>
    <item label="Display Settings" icon="video-display">
      <action name="Execute" command="/usr/local/bin/prestium-wl display-settings" />
    </item>
    <item label="Display Scale" icon="preferences-desktop-display">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-display-scale" />
    </item>
    <item label="Brightness" icon="weather-clear">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-brightness" />
    </item>
    <item label="Touchpad" icon="input-touchpad">
      <action name="Execute" command="prestium-run /usr/local/bin/prestium-touchpad" />
    </item>
    <menu id="/System/Accessibility" label="Accessibility" icon="preferences-desktop-accessibility">
      <item label="Screen Keyboard" icon="input-keyboard">
        <action name="Execute" command="/usr/local/bin/prestium-osk" />
      </item>
    </menu>
    <menu id="/System/Wallpaper" label="Wallpaper" icon="preferences-desktop-wallpaper">
      <item label="Horizon"><action name="Execute" command="/usr/local/bin/prestium-wallpaper horizon" /></item>
      <item label="Circuit"><action name="Execute" command="/usr/local/bin/prestium-wallpaper circuit" /></item>
      <item label="Mark"><action name="Execute" command="/usr/local/bin/prestium-wallpaper mark" /></item>
    </menu>
    <item label="Notification Sounds (On/Off)" icon="audio-volume-low"><action name="Execute" command="/usr/local/bin/prestium-notify-sound toggle" /></item>
    <item label="Reload Desktop Settings" icon="view-refresh"><action name="Reconfigure" /></item>
  </menu>
  <separator />
  <item label="Log Out…" icon="system-log-out">
    <action name="Execute" command="/usr/local/bin/prestium-power logout" />
  </item>
  <item label="Restart…" icon="media-playlist-repeat">
    <action name="Execute" command="/usr/local/bin/prestium-power reboot" />
  </item>
  <item label="Shut Down…" icon="system-shutdown">
    <action name="Execute" command="/usr/local/bin/prestium-power poweroff" />
  </item>
</menu>


<menu id="client-menu">
  <item label="Minimize" icon="go-down"><action name="Iconify" /></item>
  <item label="Maximize" icon="view-fullscreen"><action name="ToggleMaximize" /></item>
  <item label="Always on Top" icon="go-top"><action name="ToggleAlwaysOnTop" /></item>
  <item label="Close" icon="window-close"><action name="Close" /></item>
</menu>
</openbox_menu>
