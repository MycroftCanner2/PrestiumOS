# Prestium: "Mail (I2P)" - Claws Mail wizard defaults, used only as a fallback.
# Normally claws-mail-i2p asks for the name and @mail.i2p address on first start and writes the
# account itself (with no X-Mailer and mail.i2p as the domain, which the wizard can't set), so Claws'
# wizard never runs. If it does (the form could not be shown), these fill in I2P mail (postman,
# hq.postman.i2p) through the i2pd tunnels on 127.0.0.1: SMTP 7659 -> smtp.postman.i2p, POP3 7660 ->
# pop.postman.i2p, no SSL/TLS (the tunnel encrypts); claws-mail-i2p applies the privacy settings from
# the next start. Claws has no port keys here: a port is given as server:port. mailbox=Mail matches the
# shipped folder list (~/Mail) and the AppArmor profile.
[AccountTemplate]
domain=mail.i2p
name=
email=@mail.i2p
organization=
smtpserver=127.0.0.1:7659
smtpauth=1
smtpuser=
smtppass=
smtpssl=0
recvtype=0
recvserver=127.0.0.1:7660
recvuser=
recvpass=
recvssl=0
mailbox=Mail
