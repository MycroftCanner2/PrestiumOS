#!/bin/sh
# Prestium 2.1: what live-boot's dm-verity mount needs in the initramfs. live-boot's own hook adds the
# dm-verity module and util-linux mount; util-linux opens libcryptsetup with dlopen(), so its library is
# not found by copy_exec's ldd scan and is added here (with its own dependencies).
set -e
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
lib=$(ls /usr/lib/x86_64-linux-gnu/libcryptsetup.so.12* 2>/dev/null | head -n 1)
[ -n "$lib" ] || { echo "E: prestium-verity: libcryptsetup.so.12 not found (cryptsetup-bin)" >&2; exit 1; }
copy_exec "$lib"
manual_add_modules dm-verity
copy_exec /usr/bin/mount /bin
