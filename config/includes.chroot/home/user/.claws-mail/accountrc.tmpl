# Prestium: "Mail (I2P)" - Claws Mail first-run wizard defaults.
# There is no preset account: on first start Claws opens its wizard with I2P mail (postman,
# hq.postman.i2p) filled in, reached through the i2pd client tunnels on 127.0.0.1:
# SMTP 7659 -> smtp.postman.i2p, POP3 7660 -> pop.postman.i2p. The tunnels already encrypt
# end to end, so no SSL/TLS. The user enters their name, their @mail.i2p address and the
# postman password; the user name follows the address and SMTP uses the same login.
# Claws has no port keys here: a port is given as server:port.
[AccountTemplate]
domain=mail.i2p
name=
email=@mail.i2p
organization=
smtpserver=127.0.0.1:7659
smtpauth=1
smtpuser=
smtppass=
smtpssl=0
recvtype=0
recvserver=127.0.0.1:7660
recvuser=
recvpass=
recvssl=0
mailbox=Mailbox
