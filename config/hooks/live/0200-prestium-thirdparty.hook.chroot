#!/bin/sh
# Prestium 2.0: install the third-party software staged by scripts/fetch-thirdparty.sh in
# /usr/src/prestium-thirdparty (each file was checked against its publisher's OpenPGP signature
# and the SHA-256 pinned in thirdparty/versions.sh before it got here).
#   Tor Browser  -> /opt/tor-browser (root-owned, read-only; launched by /usr/local/bin/tor-browser
#                   with the system Tor, TOR_SKIP_LAUNCH) + Prestium policies.json and uBlock Origin
#   Firefox      -> /opt/firefox (local-only browser for Prestium's own pages) + policies.json
#   Node.js      -> /opt/nodejs (runtime only: bin/node + LICENSE)
#   The Lounge   -> /opt/thelounge (npm ci from the pinned lockfile) + Prestium's offline patch, 320s IRC ping timeout, and connecting lobby text only when a connection starts;
#                   shared by both instances, IRC (I2P) and IRC (Tor) (Tor: every network through 127.0.0.1:9050,
#                   no connection whose SASL sign-in can't work)
#   Feather      -> /usr/local/bin/feather
set -e
S=/usr/src/prestium-thirdparty
O=/usr/share/prestium/opt-overlay
[ -d "$S" ] || { echo "E: $S missing: run scripts/fetch-thirdparty.sh before lb build"; exit 1; }
T=$(mktemp -d)

# Tor Browser
rm -rf /opt/tor-browser
tar -xJf "$S/tor-browser.tar.xz" -C "$T"
mv "$T/tor-browser" /opt/tor-browser
cp -a "$O/tor-browser/." /opt/tor-browser/
touch /opt/tor-browser/Browser/is-packaged-app
chown -R root:root /opt/tor-browser; chmod -R u+rwX,go+rX,go-w /opt/tor-browser
# 2.1 audit: the installed tree must be the release fetch-thirdparty.sh asked for (and signature-checked)
tbv=$(python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["version"] if d.get("channel")=="release" else "")' \
  /opt/tor-browser/Browser/tbb_version.json 2>/dev/null) || tbv=
[ -n "$tbv" ] && [ "$tbv" = "$(cat "$S/tor-browser.version" 2>/dev/null)" ] \
  || { echo "E: Tor Browser in the image is '${tbv:-unknown}', expected $(cat "$S/tor-browser.version" 2>/dev/null)"; exit 1; }
echo "P: Tor Browser $tbv"

# Firefox (local-only)
rm -rf /opt/firefox
tar -xJf "$S/firefox.tar.xz" -C /opt
cp -a "$O/firefox/." /opt/firefox/
chown -R root:root /opt/firefox; chmod -R u+rwX,go+rX,go-w /opt/firefox
echo "P: Firefox $(grep -m1 '^Version=' /opt/firefox/application.ini)"
# 2.0 r20: panel icon for the local-only Firefox (The Lounge, I2P console, torrents); see prestium-localfox.desktop
for n in 16 32 48 64 128; do
  f=/opt/firefox/browser/chrome/icons/default/default$n.png
  [ -f "$f" ] && install -D -m 0644 "$f" /usr/share/icons/hicolor/${n}x${n}/apps/prestium-localfox.png
done
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true

# Node.js runtime
rm -rf /opt/nodejs "$T/node"; mkdir -p "$T/node"
tar -xJf "$S/node.tar.xz" -C "$T/node" --strip-components=1
install -d -m 755 /opt/nodejs /opt/nodejs/bin
install -m 755 "$T/node/bin/node" /opt/nodejs/bin/node
install -m 644 "$T/node/LICENSE" /opt/nodejs/LICENSE

# The Lounge
rm -rf /opt/thelounge; install -d -m 755 /opt/thelounge
tar -xf "$S/thelounge.tar" -C /opt/thelounge
P=/opt/thelounge/node_modules/thelounge/dist/server/plugins
python3 - "$P/changelog.js" "$P/packages/index.js" "$P/../client.js" "$P/../server.js" <<'PY'
# The Lounge must never contact the Internet itself (its blocked GitHub request crashed it)
import sys
c, p, cl, sv = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
# 2.1 (review of the security audit): the launcher's sign-in token works once. A session marked
# "prestiumLaunch" (prestium-thelounge-setup issues the first one) is deleted when it is used, the
# browser gets a session token of its own (The Lounge's normal "init" token, as after a password
# sign-in), and a new launch token is written to /run/prestium-thelounge-launch/token (group user)
# for the next "IRC (I2P)" start (the Tor instance: /run/prestium-thelounge-tor-launch, "IRC (Tor)").
s = open(sv).read()
if 'prestiumLaunch' not in s:
    a = ('        if (Object.prototype.hasOwnProperty.call(client.config.sessions, providedToken)) {\n'
         '            token = providedToken;\n'
         '            authCallback(true);\n')
    assert s.count(a) == 1, "The Lounge server.js: token sign-in code changed"
    s = s.replace(a, a.replace('            authCallback(true);\n',
        '            if (client.config.sessions[providedToken].prestiumLaunch) {\n'
        '                // Prestium: one-use launcher token (see prestium-thelounge-setup)\n'
        '                delete client.config.sessions[providedToken];\n'
        '                token = undefined;\n'
        '                prestiumNextLaunchToken(client);\n'
        '            }\n'
        '            authCallback(true);\n'), 1)
    b = 'function initializeClient(socket, client, token, lastMessage, openChannel) {\n'
    assert s.count(b) == 1, "The Lounge server.js: initializeClient changed"
    s = s.replace(b, '''// Prestium: the next one-use launcher token. Only its SHA-512 is kept in the user file; the token
// goes to /run/prestium-thelounge-launch/token (setgid group "user", 0640) for prestium-irc.
// 2.1: the Tor instance (thelounge-tor.service) names its own directory in PRESTIUM_LOUNGE_LAUNCH.
function prestiumNextLaunchToken(client) {
    const fs = require("fs");
    const crypto = require("crypto");
    const t = crypto.randomBytes(64).toString("hex");
    client.config.sessions[client.calculateTokenHash(t)] = {lastUse: Date.now(), ip: "127.0.0.1", agent: "Prestium launcher", prestiumLaunch: true};
    client.save();
    const dir = process.env.PRESTIUM_LOUNGE_LAUNCH === "/run/prestium-thelounge-tor-launch"
        ? "/run/prestium-thelounge-tor-launch" : "/run/prestium-thelounge-launch";
    const tmp = dir + "/.token-" + process.pid + "-" + crypto.randomBytes(6).toString("hex");
    try {
        fs.writeFileSync(tmp, t + "\\n", {mode: 0o640, flag: "wx"});
        fs.chmodSync(tmp, 0o640);
        fs.renameSync(tmp, dir + "/token");
    }
    catch (e) {
        log_1.default.error("Prestium: could not write the next launcher token: " + e.message);
    }
}
''' + b, 1)
    assert 'const log_1 = ' in s
    open(sv, 'w').write(s)
# 2.0 r4: networks never connect by themselves (prestium-thelounge-setup marks them disconnected),
# so the lobby text for a disconnected network says how to connect instead of blaming the user
s = open(cl).read()
if 'Prestium' not in s:
    a = 'You have manually disconnected from this network before, use the /connect command to connect again.'
    assert s.count(a) == 1
    # 2.1: "Tor" in the Tor instance (thelounge-tor.service sets PRESTIUM_LOUNGE_TOR=1)
    s = s.replace('"' + a + '"', '"Not connected (Prestium never connects automatically). When " + '
                     '(process.env.PRESTIUM_LOUNGE_TOR === "1" ? "Tor" : "I2P") + " is ready, '
                     'right-click this network in the list and choose Connect, or type /connect here."')
    assert s.count('(process.env.PRESTIUM_LOUNGE_TOR === "1" ? "Tor" : "I2P")') == 1
    s = s.replace('const msg_1 = ', '// Prestium: lobby text for disconnected networks changed\nconst msg_1 = ', 1)
    open(cl, 'w').write(s)
s = open(c).read()
if 'Prestium' not in s:
    a = 'async function fetch() {\n'; assert s.count(a) == 1
    s = s.replace(a, a + '    // Prestium: no external fetches (never contacts api.github.com)\n    return versions;\n')
    b = 'function checkForUpdates(manager) {\n'; assert s.count(b) == 1
    s = s.replace(b, b + '    // Prestium: update check disabled (local-only, offline)\n    return;\n')
    open(c, 'w').write(s)
s = open(p).read()
if 'Prestium' not in s:
    a = 'async function outdated(cacheTimeout = TIME_TO_LIVE) {\n'; assert s.count(a) == 1
    s = s.replace(a, a + '    // Prestium: never run "yarn outdated" (would contact the npm registry)\n    return false;\n')
    open(p, 'w').write(s)
print("P: The Lounge offline patch applied")
PY
# 2.1: IRC over I2P (IRC2P, Ilita) hits irc-framework's 120s ping timeout too often.
# The Lounge 4.5.2 has no config.js option; this sets ping_timeout: 320 on the Client
# (ping_interval stays the default 30). The expected text must appear exactly once, or
# the build stops (a later Lounge version can't skip the patch unnoticed). Idempotent.
N=/opt/thelounge/node_modules/thelounge/dist/server/models/network.js
python3 - "$N" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
if "ping_timeout: 320" not in s:
    a = (
        "            enable_chghost: true,\n"
        "            enable_echomessage: true,\n"
        "            enable_setname: true,\n"
        "            auto_reconnect: true,\n"
    )
    assert s.count(a) == 1, "The Lounge network.js: Client options changed (ping_timeout patch)"
    s = s.replace(
        a,
        a
        + "            // Prestium: 320s IRC ping timeout (I2P; irc-framework default is 120s)\n"
        + "            ping_timeout: 320,\n",
        1,
    )
    open(p, "w").write(s)
assert s.count("ping_timeout: 320") == 1, "The Lounge network.js: ping_timeout: 320 not present once"
assert "ping_interval" not in s, "The Lounge network.js: ping_interval must stay the default (30)"
print("P: The Lounge ping_timeout is 320")
PY
/opt/nodejs/bin/node --check "$N"
# 2.1: The Lounge's connection plugin always said "Network created, connecting to host:port..."
# when it attached, even if the network was marked userDisconnected and irc.connect() was not
# called (Prestium's default). Gate that message, and add an equivalent line in connect.js so
# /connect and the Connect menu still show "Connecting to host:port...". The expected text must
# appear exactly once, or the build stops. Idempotent. Reconnect handlers are left unchanged.
C=/opt/thelounge/node_modules/thelounge/dist/server/plugins/irc-events/connection.js
I=/opt/thelounge/node_modules/thelounge/dist/server/plugins/inputs/connect.js
python3 - "$C" "$I" <<'PY'
import sys
c, i = sys.argv[1], sys.argv[2]

s = open(c).read()
if "Prestium: connecting message only when a connection actually starts" not in s:
    a = (
        "    network.getLobby().pushMessage(client, new msg_1.default({\n"
        "        text: \"Network created, connecting to \" + network.host + \":\" + network.port + \"...\",\n"
        "    }), true);\n"
    )
    assert s.count(a) == 1, "The Lounge connection.js: Network created message changed"
    s = s.replace(
        a,
        "    // Prestium: connecting message only when a connection actually starts\n"
        "    if (!network.userDisconnected) {\n"
        "        network.getLobby().pushMessage(client, new msg_1.default({\n"
        "            text: \"Network created, connecting to \" + network.host + \":\" + network.port + \"...\",\n"
        "        }), true);\n"
        "    }\n",
        1,
    )
    open(c, "w").write(s)
assert s.count("Network created, connecting to ") == 1, "The Lounge connection.js: Network created message not present once"
assert s.count("if (!network.userDisconnected)") == 1, "The Lounge connection.js: userDisconnected guard missing"
assert "irc.on(\"reconnecting\"" in s and "Connected to the network." in s, "The Lounge connection.js: reconnect/connected handlers missing"
print("P: The Lounge connecting lobby text is gated on userDisconnected")

s = open(i).read()
if "Prestium: tell the user when a connection actually starts" not in s:
    a = (
        "            return;\n"
        "        }\n"
        "        irc.connect();\n"
    )
    assert s.count(a) == 1, "The Lounge connect.js: irc.connect() after already-connected check changed"
    s = s.replace(
        a,
        "            return;\n"
        "        }\n"
        "        // Prestium: tell the user when a connection actually starts (/connect or the Connect menu)\n"
        "        network.getLobby().pushMessage(this, new msg_1.default({\n"
        "            text: \"Connecting to \" + network.host + \":\" + network.port + \"...\",\n"
        "        }), true);\n"
        "        irc.connect();\n",
        1,
    )
    open(i, "w").write(s)
assert s.count('"Connecting to " + network.host + ":" + network.port + "..."') == 1, "The Lounge connect.js: Connecting to message not present once"
assert s.count("irc.connect();") == 1, "The Lounge connect.js: irc.connect() not present once"
print("P: The Lounge /connect shows Connecting to host:port")
PY
/opt/nodejs/bin/node --check "$C"
/opt/nodejs/bin/node --check "$I"
# 2.1: IRC (Tor), The Lounge's second instance (thelounge-tor.service, PRESTIUM_LOUNGE_TOR=1). Every
# network goes through Tor's SOCKS port 127.0.0.1:9050, whatever its proxy settings say (a network the
# user adds or edits with the proxy off would otherwise try a direct connection and a local DNS lookup;
# the firewall refuses both, this keeps them from being tried at all). irc-framework hands the host name
# to the SOCKS5 proxy (socks: ATYP 3, "domain name"), so Tor resolves it, and .onion names and torrc's
# MapAddress lines work. Each network keeps its own SOCKS username (Tor isolates circuits by it): the one
# prestium-thelounge-setup gives it, or one from the network's uuid. The I2P instance is unchanged.
# The expected text must appear exactly once, or the build stops. Idempotent.
NS=/opt/thelounge/node_modules/thelounge/dist/server/models/network.js
python3 - "$NS" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
if "Prestium: the Tor instance sends every network through Tor" not in s:
    a = "        if (this.proxyEnabled) {\n            this.irc.options.socks = {\n"
    assert s.count(a) == 1, "The Lounge network.js: proxy options changed (Tor instance patch)"
    s = s.replace(
        a,
        "        // Prestium: the Tor instance sends every network through Tor (127.0.0.1:9050, names resolved by Tor)\n"
        "        if (process.env.PRESTIUM_LOUNGE_TOR === \"1\") {\n"
        "            this.irc.options.socks = {\n"
        "                host: \"127.0.0.1\",\n"
        "                port: 9050,\n"
        "                user: this.proxyUsername || (\"prestium-\" + this.uuid),\n"
        "                pass: this.proxyPassword || \"prestium\",\n"
        "            };\n"
        "        }\n"
        "        else if (this.proxyEnabled) {\n            this.irc.options.socks = {\n",
        1,
    )
    open(p, "w").write(s)
assert s.count("Prestium: the Tor instance sends every network through Tor") == 1, "The Lounge network.js: Tor patch not present once"
assert s.count('if (process.env.PRESTIUM_LOUNGE_TOR === "1") {') == 1
assert s.count("else if (this.proxyEnabled) {") == 1, "The Lounge network.js: proxyEnabled branch missing"
print("P: The Lounge Tor instance: every network through 127.0.0.1:9050")
PY
/opt/nodejs/bin/node --check "$NS"
# 2.1: IRC (Tor) sign-in (SASL). Libera.Chat and AlphaChat accept Tor users only with SASL to an account
# made beforehand (libera.chat/guides/connect: public-key SASL only, EXTERNAL; alphachat.net/tor.xhtml:
# SASL to a verified account), so a connection without it was dropped at once with no explanation.
# In the Tor instance (PRESTIUM_LOUNGE_TOR=1) a network does not connect when its sign-in can't work:
# SASL PLAIN with an empty account or password (any network), Libera.Chat without a client certificate
# (EXTERNAL; Libera's onion refuses PLAIN), AlphaChat without SASL. The lobby says why and what to fill in
# (right-click > Edit this network > Authentication). hackint lets Tor users in without an account, so it
# is not held back. With EXTERNAL the lobby shows the network's client certificate fingerprint (SHA-512,
# what NickServ CERT ADD takes; The Lounge makes the certificate, a new one every boot), and a failed SASL
# sign-in is reported in the lobby. Checked in irc.connect() itself (every way a connection starts:
# /connect, the Connect menu, a new network, STS) and before /connect's "Connecting to" line. The I2P
# instance is unchanged. The expected text must appear exactly once, or the build stops. Idempotent.
NA=/opt/thelounge/node_modules/thelounge/dist/server/models/network.js
IA=/opt/thelounge/node_modules/thelounge/dist/server/plugins/inputs/connect.js
python3 - "$NA" "$IA" <<'PY'
import sys
na, ia = sys.argv[1], sys.argv[2]
METHODS = r'''    // Prestium: IRC (Tor) sign-in rules (hook 0200). "" = may connect, otherwise why not.
    prestiumTorSaslNetwork() {
        const h = String(this.host || "").toLowerCase();
        if (/(^|\.)libera\.chat$/.test(h) || h === "libera75jm6of4wxpxt4aynol3xjmbtxgfyjpu34ss4d7r7q2v5zrpyd.onion") {
            return "Libera.Chat";
        }
        if (/(^|\.)alphachat\.net$/.test(h) || [
            "rnjlael46gqqmfiuiqsswdeev6axrf47j7bq4dtuqdsv2qgqfumcy4yd.onion",
            "cr4elesi2ifau6xivukboqj2ojz5gvmdxnuck4hvniaco4t2fgloihqd.onion",
            "mynhbqethtsbad5trblr7t2xmrxgjeyrgk6peu2cpkqxw47yyj2o32id.onion",
            "rjmhwz5coqxunj3taoceh6etng4tvvaqg6nh3brhn2mfudpikptblpad.onion",
            "bh4jjq5zo26whufiroqab3bfvwcwtcygzmsr7jy7pzcbtaguqay56fid.onion",
        ].includes(h)) {
            return "AlphaChat";
        }
        if (/(^|\.)hackint\.org$/.test(h) || h === "dtlbunzs5b7s5sl775quwezleyeplxzicdoh3cnhm7feolxmkfd42nqd.onion") {
            return "hackint";
        }
        return "";
    }
    prestiumTorSaslProblem() {
        if (process.env.PRESTIUM_LOUNGE_TOR !== "1") {
            return "";
        }
        const how = "Right-click this network in the list, choose \"Edit this network\", ";
        const net = this.prestiumTorSaslNetwork();
        if (net === "Libera.Chat" && this.sasl !== "external") {
            return "Libera.Chat over Tor only accepts an account registered without Tor, signed in with a client certificate (not a password). " +
                how + "select \"Client certificate (SASL EXTERNAL)\" under Authentication and choose \"Save network\". " +
                "Then add the certificate fingerprint shown here to your account from a connection without Tor: /msg NickServ CERT ADD <fingerprint>";
        }
        if (this.sasl === "plain" && (!this.saslAccount || !this.saslPassword)) {
            return (net || this.name) + " needs your account name and password before it can connect. " +
                how + "select \"Username + password (SASL PLAIN)\" under Authentication, fill in Account and Password, and choose \"Save network\". Then Connect.";
        }
        if (net === "AlphaChat" && !this.sasl) {
            return "AlphaChat over Tor only accepts a verified AlphaChat account (register it without Tor first). " +
                how + "select \"Username + password (SASL PLAIN)\" under Authentication, fill in Account and Password, and choose \"Save network\". Then Connect.";
        }
        return "";
    }
    prestiumTorCertFingerprint() {
        if (process.env.PRESTIUM_LOUNGE_TOR !== "1" || this.sasl !== "external") {
            return "";
        }
        try {
            const c = clientCertificate_1.default.get(this.uuid);
            return c ? new crypto_1.default.X509Certificate(c.certificate).fingerprint512.replace(/:/g, "").toLowerCase() : "";
        }
        catch (e) {
            return "";
        }
    }
    prestiumTorLobby(client, text, error) {
        this.getLobby().pushMessage(client, new msg_1.default(error ? {type: msg_2.MessageType.ERROR, text: text} : {text: text}), true);
    }
    prestiumTorHint(client) {
        const net = this.prestiumTorSaslNetwork();
        const fp = this.prestiumTorCertFingerprint();
        if (fp) {
            this.prestiumTorLobby(client, "Signing in with this network's client certificate. Its fingerprint (SHA-512) is " + fp +
                ". Prestium makes a new certificate every boot: add it to your account from a connection without Tor with /msg NickServ CERT ADD " + fp, false);
        }
        if (net === "hackint" && !this.sasl) {
            this.prestiumTorLobby(client, "hackint lets you in over Tor without an account. To sign in to your hackint account, " +
                "right-click this network, choose \"Edit this network\" and select \"Username + password (SASL PLAIN)\" under Authentication.", false);
        }
        const p = this.prestiumTorSaslProblem();
        if (p) {
            this.prestiumTorLobby(client, p, false);
        }
    }
    // true: not connecting (the lobby says why)
    prestiumTorRefuse(client) {
        const p = this.prestiumTorSaslProblem();
        if (!p) {
            return false;
        }
        this.userDisconnected = true;
        this.prestiumTorLobby(client, "Not connecting. " + p, true);
        client.save();
        return true;
    }
'''
s = open(na).read()
if "Prestium: IRC (Tor) sign-in rules" not in s:
    a = "    setIrcFrameworkOptions(client) {\n"
    assert s.count(a) == 1, "The Lounge network.js: setIrcFrameworkOptions changed (SASL patch)"
    s = s.replace(a, METHODS + a, 1)
    b = ("        this.setIrcFrameworkOptions(client);\n"
         "        this.irc.requestCap([\n")
    assert s.count(b) == 1, "The Lounge network.js: createIrcFramework changed (SASL patch)"
    s = s.replace(b,
        "        this.setIrcFrameworkOptions(client);\n"
        "        // Prestium: IRC (Tor): no connection whose sign-in can't work; lobby hints; failed SASL reported\n"
        "        if (process.env.PRESTIUM_LOUNGE_TOR === \"1\") {\n"
        "            const prestiumConnect = this.irc.connect.bind(this.irc);\n"
        "            this.irc.connect = (...a) => (this.prestiumTorRefuse(client) ? undefined : prestiumConnect(...a));\n"
        "            this.irc.on(\"sasl failed\", (e) => {\n"
        "                this.prestiumTorLobby(client, \"Sign-in (SASL) failed (\" + String(e && e.reason || \"unknown\") +\n"
        "                    \"). Check the account and password, or the certificate, under Edit this network > Authentication.\", true);\n"
        "            });\n"
        "            this.prestiumTorHint(client);\n"
        "        }\n"
        "        this.irc.requestCap([\n", 1)
    open(na, "w").write(s)
assert s.count("Prestium: IRC (Tor) sign-in rules") == 1, "The Lounge network.js: SASL rules not present once"
assert s.count("this.irc.connect = (...a) => (this.prestiumTorRefuse(client)") == 1, "The Lounge network.js: connect guard not present once"
assert "const crypto_1 = " in s and "const clientCertificate_1 = " in s and "const msg_2 = " in s, "The Lounge network.js: imports changed"
s = open(ia).read()
if "Prestium: IRC (Tor) sign-in check" not in s:
    a = "        // Prestium: tell the user when a connection actually starts (/connect or the Connect menu)\n"
    assert s.count(a) == 1, "The Lounge connect.js: Connecting to patch missing (SASL patch runs after it)"
    s = s.replace(a,
        "        // Prestium: IRC (Tor) sign-in check, before the Connecting to line (network.js has the rules)\n"
        "        if (network.prestiumTorRefuse && network.prestiumTorRefuse(this)) {\n"
        "            return;\n"
        "        }\n" + a, 1)
    open(ia, "w").write(s)
assert s.count("network.prestiumTorRefuse(this)") == 1, "The Lounge connect.js: SASL check not present once"
print("P: The Lounge Tor instance: SASL sign-in checks and hints")
PY
/opt/nodejs/bin/node --check "$NA"
/opt/nodejs/bin/node --check "$IA"
chown -R root:root /opt/thelounge; chmod -R u+rwX,go+rX,go-w /opt/thelounge
echo "P: The Lounge $(sed -n 's/.*"version": "\(.*\)".*/\1/p' /opt/thelounge/node_modules/thelounge/package.json | head -1)"

# Feather (Monero wallet; I2P-only settings in ~/.config/feather/settings.json)
FV=$(cat "$S/feather.version")
unzip -p "$S/feather.zip" "feather-$FV" > /usr/local/bin/feather 2>/dev/null || {
	n=$(unzip -Z1 "$S/feather.zip" | grep -E '^feather(-[0-9.]+)?$' | head -1); unzip -p "$S/feather.zip" "$n" > /usr/local/bin/feather; }
chmod 755 /usr/local/bin/feather; [ -s /usr/local/bin/feather ]
echo "P: Feather $FV"

rm -rf "$T"
