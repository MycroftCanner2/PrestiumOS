#!/bin/sh
# Prestium 2.1: VLC runs through Xwayland (Qt "xcb"), not as a native Wayland client. VLC 3's
# Wayland support is experimental: in a VM it brought the whole labwc session down. Under
# Xwayland it keeps its normal video window, and as an X11 client it still can't see or reach
# Wayland windows. Debian's vlc.desktop (menus, "Open with") starts /usr/bin/vlc directly, so its
# Exec lines get QT_QPA_PLATFORM=xcb; the network-less AppArmor profile "vlc" still attaches to
# /usr/bin/vlc. The Prestium menu entry sets the same (etc/xdg/labwc/menu.xml).
# Safe to run again.
set -e
D=/usr/share/applications/vlc.desktop
[ -f "$D" ] || { echo "E: $D is missing (vlc not installed?)"; exit 1; }
sed -i -E 's#^Exec=(env QT_QPA_PLATFORM=xcb )?(/usr/bin/)?vlc #Exec=env QT_QPA_PLATFORM=xcb /usr/bin/vlc #' "$D"
grep '^Exec=' "$D" | grep -qv '^Exec=env QT_QPA_PLATFORM=xcb /usr/bin/vlc ' \
	&& { echo "E: $D starts VLC another way: update hook 0630"; grep '^Exec=' "$D"; exit 1; }
echo "P: VLC starts through Xwayland"
