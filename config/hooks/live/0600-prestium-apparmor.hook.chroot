#!/bin/sh
# Prestium 2.0: AppArmor. Every profile Prestium ships is enforced, LibreWolf's included (earlier releases
# had it in complain mode). Profiles are compiled once here to catch syntax errors at build time.
set -e
# 2.0 r9: Debian's "firefox" profile (flags=unconfined) attaches to /opt/firefox/firefox too, which
# would conflict with Prestium's confined profile for the local-only Firefox; drop it (no other
# Firefox is installed).
rm -f /etc/apparmor.d/firefox /etc/apparmor.d/local/firefox
# 2.1 (audit of 96468c5, M-1): the same for Debian's "loupe" (flags=unconfined, same attachment as
# Prestium's confined Loupe profile)
rm -f /etc/apparmor.d/loupe /etc/apparmor.d/local/loupe
# 2.1: and Debian's LibreOffice profiles for oosplash and soffice.bin (libreoffice-common, complain mode).
# They attach to the same two programs as Prestium's "libreoffice" profile and match them just as well,
# so the kernel attached neither ("conflicting profile attachments") and LibreOffice ran unconfined.
# senddoc and xpdfimport keep Debian's profiles: Prestium's LibreOffice runs them inside its own (ix).
rm -f /etc/apparmor.d/usr.lib.libreoffice.program.oosplash /etc/apparmor.d/local/usr.lib.libreoffice.program.oosplash
rm -f /etc/apparmor.d/usr.lib.libreoffice.program.soffice.bin /etc/apparmor.d/local/usr.lib.libreoffice.program.soffice.bin
# 2.0 r12: Claws Mail (I2P mail) is confined too
# 2.1 (audit of 96468c5, M-1): the programs that open downloaded files, KeePassXC and Kleopatra too
# 2.1 (security audit): onion-grater too (ptrace read only); 2.1 (review): the browser launchers as
# Claws Mail, Gajim and Pidgin start them, and pinentry as Claws Mail's gpg-agent starts it
# 2.0 r9: Gajim, OnionShare, Feather, LibreOffice, The Lounge and the local-only Firefox are confined too
# 2.1: The Lounge's Tor instance (IRC (Tor)) too
for p in usr.share.librewolf.librewolf torbrowser.Browser.firefox usr.bin.pidgin system_tor usr.bin.i2pd \
	usr.bin.gajim usr.bin.onionshare usr.local.bin.feather usr.lib.libreoffice.program prestium.thelounge prestium.thelounge-tor \
	opt.firefox.firefox usr.bin.claws-mail usr.local.sbin.prestium-onion-grater \
	prestium.browser-launcher prestium.pinentry \
	usr.bin.loupe usr.bin.ristretto usr.bin.vlc usr.bin.file-roller usr.bin.xarchiver usr.bin.featherpad usr.bin.mat2 usr.bin.metadata-cleaner usr.bin.gimp usr.bin.audacity usr.bin.keepassxc usr.bin.kleopatra; do
	f=/etc/apparmor.d/$p
	[ -e "$f" ] || { echo "W: no profile $p"; continue; }
	sed -i 's/ flags=(complain)//; s/flags=(complain) //' "$f"
	rm -f "/etc/apparmor.d/force-complain/$p" "/etc/apparmor.d/disable/$p"
	apparmor_parser -Q -K "$f" >/dev/null 2>&1 && echo "P: apparmor $p parses" || { echo "E: apparmor $p does not parse"; apparmor_parser -Q -K "$f"; exit 1; }
done
grep -q 'flags=(complain)' /etc/apparmor.d/usr.share.librewolf.librewolf && { echo "E: LibreWolf profile still in complain mode"; exit 1; }
touch /etc/apparmor.d/local/usr.share.librewolf.librewolf
# 2.0 r9: every confined app denies sudo/su/pkexec and Prestium's helpers
for p in usr.share.librewolf.librewolf usr.bin.pidgin usr.bin.gajim usr.bin.onionshare usr.local.bin.feather \
	usr.lib.libreoffice.program prestium.thelounge prestium.thelounge-tor opt.firefox.firefox local/torbrowser.Browser.firefox \
	usr.bin.claws-mail prestium.pinentry \
	usr.bin.loupe usr.bin.ristretto usr.bin.vlc usr.bin.file-roller usr.bin.xarchiver usr.bin.featherpad usr.bin.mat2 usr.bin.metadata-cleaner usr.bin.gimp usr.bin.audacity usr.bin.keepassxc usr.bin.kleopatra; do
	grep -q 'prestium-no-admin\|prestium-app-base\|prestium-app-common\|prestium-viewer' "/etc/apparmor.d/$p" || { echo "E: $p does not deny sudo"; exit 1; }
done
# 2.1: the whole set as apparmor.service loads it at boot: every file in /etc/apparmor.d compiles (one that
# doesn't makes the service fail), and no other profile attaches to a program a Prestium profile confines
python3 -I /usr/share/prestium/build/aa-attach-check.py /etc/apparmor.d usr.share.librewolf.librewolf torbrowser.Browser.firefox \
	usr.bin.pidgin usr.bin.gajim usr.bin.onionshare usr.local.bin.feather usr.lib.libreoffice.program prestium.thelounge \
	prestium.thelounge-tor opt.firefox.firefox usr.bin.claws-mail usr.local.sbin.prestium-onion-grater prestium.browser-launcher \
	prestium.pinentry usr.bin.loupe usr.bin.ristretto usr.bin.vlc usr.bin.file-roller usr.bin.xarchiver usr.bin.featherpad \
	usr.bin.mat2 usr.bin.metadata-cleaner usr.bin.gimp usr.bin.audacity usr.bin.keepassxc usr.bin.kleopatra \
	|| { echo "E: the AppArmor profile set would not load cleanly at boot"; exit 1; }
