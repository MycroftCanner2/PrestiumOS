#!/bin/sh
# Prestium 2.0: git does not keep owners or modes; restore them for every file from
# config/includes.chroot (manifest taken from the earlier Prestium rootfs, plus 2.0's new files).
set -e
M=/usr/share/prestium/build/perms.txt
grep -v '^#' "$M" | while read -r mode owner group path; do
	case "$path" in /usr/share/prestium/build/*) continue ;; esac
	p=${path%/}
	[ -e "$p" ] || [ -L "$p" ] || { echo "W: perms: missing $p"; continue; }
	[ -L "$p" ] && continue
	chown "$owner:$group" "$p" && chmod "$mode" "$p"
done
# 2.1: The Lounge's Tor instance (IRC (Tor)) loads the same packages as the I2P one (sign-in page, the 10
# Theme Factory themes): its own copy, root-owned and read-only for it (group thelounge-tor, 0750/0640),
# like the I2P instance's (root:thelounge in the manifest). Neither instance can read the other's.
TP=/var/lib/thelounge-tor/packages
rm -rf "$TP"; cp -R /var/lib/thelounge/packages "$TP"
chown -R root:thelounge-tor "$TP"
find "$TP" -type d -exec chmod 0750 {} +; find "$TP" -type f -exec chmod 0640 {} +
[ -z "$(find "$TP" ! -type d ! -type f)" ] || { echo "E: $TP: not only files and directories"; exit 1; }
[ -f "$TP/node_modules/thelounge-prestium-autologin/autologin.html" ] && [ -f "$TP/node_modules/thelounge-theme-tech-innovation/theme.css" ] \
	|| { echo "E: $TP incomplete"; exit 1; }
# directories created by includes that the manifest does not list keep root:root 0755
chmod 0440 /etc/sudoers.d/*
visudo -c >/dev/null
# 2.1 (L-5): each confined app's own download or output folder (its AppArmor profile lets it write only
# there); ~/Downloads itself holds what you put there for apps to read. Torrents is made by i2pd's helper.
for d in "I2P Browser" "Local Firefox" Mail Gajim Pidgin; do install -d -m 0700 "/home/user/Downloads/$d"; done
for d in LibreOffice GIMP FeatherPad "File Roller" Xarchiver Audacity Kleopatra "Metadata Cleaner"; do install -d -m 0700 "/home/user/Documents/$d"; done
chown -R user:user /home/user
# 2.1 (review of db6601c, L-2): passwd is not setuid. The live user starts with no password, and passwd
# asks a user with an empty password for no old one, so any program of the user could choose the first
# session password with it. Root (the Wayland broker's dialog) still sets it; nobody else needs passwd.
dpkg-statoverride --list /usr/bin/passwd >/dev/null 2>&1 || dpkg-statoverride --update --add root root 0755 /usr/bin/passwd
[ ! -u /usr/bin/passwd ] || { echo "E: /usr/bin/passwd still setuid"; exit 1; }
echo "P: permissions restored"
