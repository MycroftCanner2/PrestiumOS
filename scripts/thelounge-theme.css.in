/* Prestium 2.1: The Lounge theme "@name@" (@kind@). Generated by scripts/thelounge-themes.py from
   scripts/thelounge-theme.css.in; edit those, not this file.
   Palette: @palette@ (Theme Factory, @src@).
   Theme Factory is licensed under the Apache License 2.0; see ../../THEME-FACTORY-NOTICE.txt.
   Built on The Lounge 4.5.2 (same selectors as the Prestium theme). No web fonts, images or remote
   URLs: the page is served from 127.0.0.1:9000 and must load nothing from outside. */
@import "default.css";

:root {
	--t-side: @side_bg@;
	--t-side-fg: @side_fg@;
	--t-side-muted: @side_muted@;
	--t-side-hover: @side_hover@;
	--t-side-active: @side_active_bg@;
	--t-side-active-fg: @side_active_fg@;
	--t-win: @win@;
	--t-panel: @panel@;
	--t-line: @line@;
	--t-line2: @line2@;
	--t-fg: @fg@;
	--t-muted: @muted@;
	--t-link: @link@;
	--t-sel: @sel@;
	--t-in-bg: @in_bg@;
	--t-in-fg: @in_fg@;
	--t-in-line: @in_line@;
	--t-ok: @ok@;
	--t-warn: @warn@;
	--t-bad: @bad@;

	--body-color: var(--t-fg);
	--body-color-muted: var(--t-muted);
	--body-bg-color: var(--t-side);
	--button-color: @button@;
	--button-text-color-hover: @button_hover@;
	--overlay-bg-color: @overlay@;
	--link-color: var(--t-link);
	--window-bg-color: var(--t-win);
	--window-heading-color: var(--t-muted);
	--date-marker-color: @date@;
	--unread-marker-color: @unread@;
	--highlight-bg-color: @hl_bg@;
	--highlight-border-color: @hl_line@;
	--upload-progressbar-color: @button@;
	color-scheme: @scheme@;
}

body {
	font-family: @body_font@;
	color: var(--t-fg);
	scrollbar-color: var(--t-line2) var(--t-side);
}

h1,
h2,
h3,
#chat .header .title {
	font-family: @head_font@;
	font-weight: bold;
}

#loading @logo_hide@,
.window @logo_hide@ {
	display: none;
}

#loading @logo_show@,
.window @logo_show@ {
	display: inline-block;
}

.window {
	color: var(--t-fg);
	border: 1px solid var(--t-line);
	box-shadow: 0 0 25px @shadow@;
}

/* Sidebar: networks and channels */
#sidebar,
#footer button,
.channel-list-item {
	color: var(--t-side-muted);
}

#footer button:hover,
.channel-list-item:hover {
	background-color: var(--t-side-hover);
	color: var(--t-side-fg);
}

#footer button.active,
.channel-list-item.active {
	background-color: var(--t-side-active);
	color: var(--t-side-active-fg);
}

.channel-list-item[data-type="lobby"] {
	color: @side_lobby@;
}

.channel-list-item[data-type="lobby"].active,
.channel-list-item[data-type="lobby"]:hover {
	color: var(--t-side-fg);
}

.channel-list-item.not-secure,
.channel-list-item.not-connected,
.channel-list-item.parted-channel {
	color: var(--t-side-muted);
	font-style: italic;
}

.channel-list-item .badge {
	color: var(--t-side-fg);
	background: rgb(255 255 255 / 12%);
}

.channel-list-item .badge.highlight {
	color: var(--t-side);
	background: @badge_hl_bg@;
}

/* Borders */
#chat .content,
#chat .header,
#chat .user-mode::before,
#chat .userlist {
	border-color: var(--t-line);
}

#chat .header {
	background-color: var(--t-panel);
	color: var(--t-fg);
}

#chat .header .topic {
	color: var(--t-muted);
}

/* User list */
#chat .userlist .count {
	background-color: var(--t-panel);
}

#chat .count::before {
	color: var(--t-muted);
}

#chat .userlist .user.active {
	background-color: var(--t-sel);
}

/* Chat text: what people send is full-contrast, including your own messages
   (The Lounge dims "self" messages with --body-color-muted by default). */
#chat,
#chat .msg,
#chat .msg .content,
#chat .self .content,
#chat .msg[data-type="message"] .content,
#chat .chat-view[data-type="channel"] .msg.highlight .content {
	color: var(--t-fg);
}

#chat .time,
#chat .msg[data-type="condensed"] .content,
#chat .condensed-summary .content {
	color: var(--t-muted);
}

/* Nicknames: coloured, each >= 4.5:1 on the window */
.user {
	color: @nick_base@;
}

@nicks@
@extra@
/* Message types */
#chat .msg[data-type="error"],
#chat .msg[data-type="error"] .from,
#chat .msg[data-type="error"] .content {
	color: var(--t-bad);
}

#chat .msg[data-type="action"] .content,
#chat .msg[data-type="action"] .from,
#chat .msg[data-type="action"] .user {
	color: var(--t-warn);
}

#chat .msg[data-type="notice"] .content,
#chat .msg[data-type="notice"] .time,
#chat .msg[data-type="notice"] .user {
	color: var(--t-link);
}

#chat .chat-view[data-type="channel"] .msg.highlight .time {
	color: var(--t-fg);
}

#chat .msg[data-type="monospace_block"] .text,
code,
.irc-monospace {
	background: var(--t-panel);
	color: var(--t-fg);
}

/* Message form */
#form {
	background-color: var(--t-panel);
	border-color: var(--t-line);
	color: var(--t-in-fg);
}

#form #input {
	background-color: transparent;
	color: var(--t-in-fg);
	caret-color: var(--t-in-fg);
}

#form #nick {
	background: var(--t-sel);
	color: var(--t-fg);
}

#viewport .lt,
#viewport .rt,
#chat button.mentions,
#chat button.menu,
#chat button.close,
#form #upload,
#form #submit {
	color: var(--t-muted);
}

form.message-search input {
	background-color: var(--t-in-bg);
	color: var(--t-in-fg);
}

#chat form.message-search button {
	color: var(--t-muted);
}

/* Text fields (Connect, Settings, sidebar join form): explicit colour and background,
   not color-scheme alone, so no field is ever black text on a dark box. */
.input,
input:not([type="checkbox"], [type="radio"], [type="range"], [type="file"]),
textarea,
select {
	color: var(--t-in-fg);
	background-color: var(--t-in-bg);
	border-color: var(--t-in-line);
}

select option {
	color: var(--t-in-fg);
	background-color: var(--t-in-bg);
}

.input:disabled,
input:disabled,
textarea:disabled,
select:disabled {
	background-color: var(--t-panel);
	color: var(--t-muted);
}

.input:not(:disabled):focus,
.input:not(:disabled):hover {
	border-color: var(--t-link);
}

::placeholder,
#chat-container ::placeholder,
#form #input::placeholder {
	color: var(--t-muted);
	opacity: 1;
}

#settings,
#connect,
#help,
#settings label,
#connect label {
	color: var(--t-fg);
}

#settings .settings-sync-panel {
	color: var(--t-fg);
	background-color: var(--t-sel);
}

#settings .settings-sync-panel .btn {
	color: var(--t-fg);
	border-color: var(--t-fg);
}

#settings .settings-sync-panel .btn:focus,
#settings .settings-sync-panel .btn:hover {
	color: var(--t-sel);
	background-color: var(--t-fg);
}

#settings #change-password .error {
	color: var(--t-bad);
}

#settings #change-password .success {
	color: var(--t-ok);
}

/* Context menu, nick completion and mentions (The Lounge draws them white by default) */
.mentions-popup,
#context-menu,
.textcomplete-menu {
	background-color: var(--t-win);
	border-color: var(--t-line2);
}

.context-menu-item,
.textcomplete-item,
.textcomplete-item a {
	color: var(--t-fg);
}

.context-menu-item.active,
.textcomplete-item:focus,
.textcomplete-item:hover,
.textcomplete-menu .active {
	background-color: var(--t-sel);
}

.context-menu-divider {
	background-color: var(--t-line);
}

/* Embeds (off in Prestium, kept readable) */
#chat .toggle-content {
	background: var(--t-panel);
	color: var(--t-fg);
}

#chat .toggle-content .body {
	color: var(--t-muted);
}

:focus-visible {
	outline: 2px solid var(--t-link);
	outline-offset: 1px;
}
